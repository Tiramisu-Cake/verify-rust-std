index d150408..4bc94eb 100644
--- a/bin/rust/std/lib.rsspec
+++ b/bin/rust/std/lib.rsspec
@@ -434,7 +434,27 @@ mod mem {
     fix MaybeUninit::uninit<T>() -> MaybeUninit<T>;
     fix MaybeUninit::new_maybe_uninit<T>(v: option<T>) -> MaybeUninit<T>;
     fix MaybeUninit::new<T>(v: T) -> MaybeUninit<T> { MaybeUninit::new_maybe_uninit(some(v)) }
+
+    // Experimental pointer-value ownership. No pointee permissions are owned.
+    // Legacy generic MaybeUninit_own and all storage/borrow lemmas stay opaque.
+    pred_ctor MaybeUninit_pointer_own<Element>()(t: thread_id_t, v: MaybeUninit<*Element>;) =
+        match MaybeUninit::inner(v) {
+            none => true,
+            some(p) => raw_ptr_own::<Element>()(t, p)
+        };
     
+    // This introduction is CHECKED against the definition, not an axiom.
+    lem close_MaybeUninit_pointer_own<Element>(t: thread_id_t, v: MaybeUninit<*Element>)
+        req true;
+        ens MaybeUninit_pointer_own::<Element>()(t, v);
+    {
+        match MaybeUninit::inner(v) {
+            none => {}
+            some(p) => { close raw_ptr_own::<Element>()(t, p); }
+        }
+        close MaybeUninit_pointer_own::<Element>()(t, v);
+    }
+
     lem_auto MaybeUninit_inner_new_maybe_uninit<T: ?Sized>(v: option<T>);
         req true;
         ens MaybeUninit::new_maybe_uninit(v).inner() == v;

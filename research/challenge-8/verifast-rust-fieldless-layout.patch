+        fn encode_rust_layout_info(
+            tcx: TyCtxt<'tcx>,
+            adt_def: &ty::AdtDef<'tcx>,
+            mut info_cpn: rust_layout_info_cpn::Builder<'_>,
+        ) {
+            let is_supported_shape = adt_def.did().is_local()
+                && adt_def.is_struct()
+                && adt_def.non_enum_variant().fields.is_empty()
+                && adt_def.repr().pack.is_none()
+                && !adt_def.repr().transparent()
+                && !adt_def.repr().simd()
+                && !adt_def.repr().scalable()
+                && !adt_def.repr().linear();
+            let exact = if is_supported_shape {
+                let local_did = adt_def.did().expect_local();
+                let generics = tcx.hir_get_generics(local_did);
+                if let Some(generics) = generics.filter(|generics| generics.params.is_empty()) {
+                    let typing_env = ty::TypingEnv {
+                        typing_mode: ty::TypingMode::PostAnalysis,
+                        param_env: ty::ParamEnv::empty(),
+                    };
+                    let adt_ty = tcx.type_of(adt_def.did()).instantiate_identity();
+                    tcx.layout_of(typing_env.as_query_input(adt_ty)).ok().map(|layout| {
+                        let item_span = match tcx.hir_node_by_def_id(local_did) {
+                            rustc_hir::Node::Item(item) => item.span,
+                            _ => bug!("local ADT definition is not an HIR item"),
+                        };
+                        (layout.size.bytes(), layout.align.abi.bytes(), item_span)
+                    })
+                } else {
+                    None
+                }
+            } else {
+                None
+            };
+            match exact {
+                Some((size, align, item_span)) => {
+                    let mut exact_cpn = info_cpn.init_exact();
+                    exact_cpn.set_size_bytes(size);
+                    exact_cpn.set_abi_align_bytes(align);
+                    exact_cpn.set_binding_adt_def_name(&tcx.def_path_str(adt_def.did()));
+                    Self::encode_span_data(tcx, &item_span.data(), exact_cpn.reborrow().init_binding_def_span());
+                    exact_cpn.set_binding_target_triple(&tcx.sess.target.llvm_target);
+                    exact_cpn.set_binding_pointer_width(tcx.sess.target.pointer_width.try_into().unwrap());
+                }
+                None => info_cpn.set_absent(()),
+            }
         }
 

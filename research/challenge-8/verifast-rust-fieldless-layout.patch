+    isReprTransparent @14: Bool;
+    isReprSimd @15: Bool;
+    isReprScalable @16: Bool;
+    isReprLinear @17: Bool;
+}
+
+# Experimental, compiler-produced layout facts. `absent` is explicit: it means
+# this ADT is outside the narrow exact-layout domain or rustc did not return a
+# layout. `exact` is bound again to its enclosing ADT and target so consumers
+# can reject stale or misassociated metadata.
+struct RustLayoutInfo {
+    union {
+        absent @0: Void;
+        exact @1: ExactRustLayout;
+    }
+}
+
+struct ExactRustLayout {
+    sizeBytes @0: UInt64;
+    abiAlignBytes @1: UInt64;
+    bindingAdtDefName @2: Text;
+    bindingDefSpan @3: SpanData;
+    bindingTargetTriple @4: Text;
+    bindingPointerWidth @5: UInt8;
 }
 

+    "suite:cargo-coverage", "suite:kani-docs", "suite:kani-fixme",
+    "suite:json-handler", "firecracker-codegen", "cargo-smoke", "cargo-clean",
+    "warnings-build",
+]
+UNIT_PACKAGES = [x.split(":", 1)[1] for x in STAGES if x.startswith("unit:")]

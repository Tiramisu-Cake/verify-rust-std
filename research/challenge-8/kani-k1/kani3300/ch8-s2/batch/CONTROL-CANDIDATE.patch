@@ -0,0 +1,59 @@
+"""Exact negative-observation oracle helpers.
+
+This module recognizes a named assertion only after the caller has already
+bound the export to its request row and pinned source. Oracle absence is a
+closed failure; textual descriptions are never property identities.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+
+def matches(harness: Any, oracle: Any) -> bool:
+    if not isinstance(harness, dict) or not isinstance(oracle, dict):
+        return False
+    selector, property_id = oracle.get("selector"), oracle.get("property_id")
+    export_file, line, prop_class = oracle.get("export_file"), oracle.get("line"), oracle.get("class")
+    if (not all(isinstance(x, str) and x for x in (selector, property_id, export_file)) or
+            not isinstance(line, int) or isinstance(line, bool) or line < 1 or
+            prop_class != "assertion"):
+        return False
+    if (harness.get("name") != selector or
+            harness.get("outcome") != {"kind": "COMPLETED", "verdict": "FAILURE"}):
+        return False
+    checks, covers, named = harness.get("checks"), harness.get("covers"), harness.get("failed_properties")
+    if not isinstance(checks, dict) or not isinstance(covers, dict) or not isinstance(named, list) or len(named) != 1:
+        return False
+    if type(harness.get("n_failed")) is not int or harness["n_failed"] != 1:
+        return False
+    if checks.get("failure") != [property_id]:
+        return False
+    for key in ("undetermined", "error", "unknown", "other"):
+        if checks.get(key) != []:
+            return False
+    unreachable = checks.get("unreachable")
+    if not isinstance(unreachable, list) or any(not isinstance(x, str) for x in unreachable):
+        return False
+    if len(set(unreachable)) != len(unreachable) or property_id in unreachable:
+        return False
+    if any(type(checks.get(k)) is not int or checks[k] < 0 for k in ("total", "success")):
+        return False
+    if checks["total"] != checks["success"] + len(unreachable) + 1:
+        return False
+    sat = covers.get("satisfied")
+    if (not isinstance(sat, list) or any(not isinstance(x, str) for x in sat) or
+            len(set(sat)) != len(sat) or type(covers.get("total")) is not int or covers["total"] != len(sat)):
+        return False
+    if any(covers.get(k) != [] for k in ("unsatisfiable", "unreachable", "undetermined", "error", "unknown", "other")):
+        return False
+    if type(harness.get("n_properties")) is not int or harness["n_properties"] != checks["total"] + covers["total"]:
+        return False
+    unsupported = harness.get("unsupported_constructs")
+    if (not isinstance(unsupported, list) or
+            any(not isinstance(p, dict) or p.get("status") != "SUCCESS" or
+                p.get("class") != "unsupported_construct" for p in unsupported)):
+        return False
+    prop = named[0]
+    return (isinstance(prop, dict) and prop.get("id") == property_id and prop.get("file") == export_file and
+            prop.get("line") == str(line) and prop.get("class") == "assertion" and
+            prop.get("status") == "FAILURE")
diff --git a/ch8-s1-control/oracle_source.py b/ch8-s1-control/oracle_source.py
new file mode 100644
index 000000000..1c570dcaf
--- /dev/null
+++ b/ch8-s1-control/oracle_source.py
@@ -0,0 +1,141 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+"""Offline source-coordinate preflight for the eight frozen S1-08 oracles.
+
+Not imported by runner/collector/admission. Source-derived spans repair only
+closure type coordinates. Existing assertion ordinals are never rediscovered
+from failures; exact runtime matching in negative_oracle.py remains unchanged.
+"""
+import hashlib
+import re
+
+SOURCE_SHA = '99e8456d200fff1299ee5756279cddb23921dc65'
+CLOSURE_COORD = re.compile(r'(?P<file>\{closure@[^{}]+?):(?P<sl>\d+):(?P<sc>\d+): (?P<el>\d+):(?P<ec>\d+)(?=\})')
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def masked(source):
+    # Preserve offsets/newlines, while preventing strings and comments from
+    # supplying syntax for the small frozen-source lexical checks below.
+    pattern = r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/'
+    return re.sub(pattern, lambda m: ''.join('\n' if c=='\n' else ' ' for c in m[0]), source, flags=re.S)
+
+
+def balanced_end(code, start, opening='(', closing=')'):
+    assert code[start] == opening
+    depth=0
+    for i in range(start,len(code)):
+        if code[i]==opening: depth+=1
+        elif code[i]==closing:
+            depth-=1
+            if depth==0: return i+1
+    raise AssertionError('unbalanced frozen source')
+
+
+def function_body(source, name):
+    code=masked(source)
+    hits=list(re.finditer(r'(?m)^fn\s+'+re.escape(name)+r'\s*[<(]',code))
+    assert len(hits)==1, 'missing/duplicate source function'
+    lo=code.index('{',hits[0].end())
+    hi=balanced_end(code,lo,'{','}')
+    return lo,hi
+
+
+def closure_span(source, root):
+    lo,hi=function_body(source,root)
+    # These two frozen closures have explicit, one-line argument declarations.
+    # Accept no fallback shape and no ordinal/location guess on unknown syntax.
+    hits=list(re.finditer(r'\|[^|\n]*\|',masked(source)[lo:hi]))
+    assert len(hits)==1, 'expected one explicit closure argument span'
+    start=lo+hits[0].start();end=lo+hits[0].end()
+    line=source.count('\n',0,start)+1
+    line_start=source.rfind('\n',0,start)+1
+    line_end=source.find('\n',start)
+    line_text=source[line_start:line_end if line_end>=0 else len(source)]
+    assert line_text.isascii() and '\t' not in line_text, 'unsupported closure column encoding'
+    assert '\n' not in source[start:end]
+    return {'start_line':line,'start_column':start-line_start+1,
+            'end_line':line,'end_column':end-line_start+1,
+            'text':source[start:end]}
+
+
+def span_text(span):
+    return f"{span['start_line']}:{span['start_column']}: {span['end_line']}:{span['end_column']}"
+
+
+def repair_id(property_id, source, root):
+    hits=list(CLOSURE_COORD.finditer(property_id))
+    if not hits: return property_id
+    assert len(hits)==1, 'unknown multi-closure oracle shape'
+    m=hits[0];span=closure_span(source,root)
+    return property_id[:m.start('sl')]+span_text(span)+property_id[m.end('ec'):]
+
+
+def assertion_at(source, line):
+    lines=source.splitlines(keepends=True)
+    assert type(line) is int and 1<=line<=len(lines)
+    offset=sum(len(x) for x in lines[:line-1])
+    code=masked(source)
+    starts=list(re.finditer(r'assert!\s*\(',code[offset:offset+len(lines[line-1])]))
+    if starts:
+        assert len(starts)==1
+        start=offset+starts[0].start();opening=code.index('(',start)
+        end=balanced_end(code,opening)
+        return source[start:end]+';'
+    # Activation mutants are existing false ensures clauses, not Rust assert!.
+    stripped=lines[line-1].strip()
+    assert stripped.startswith('#[cfg_attr(') and 'kani::ensures(' in stripped
+    return stripped
+
+
+def validate(request, sources, baselines):
+    """Check full declared IDs against independently pinned source bytes.
+
+    sources maps (variant, repo-relative path) to exact bytes. The caller must
+    obtain actual bytes from the pinned Git tree/overlay; tests use hash-checked
+    copies of those same files. A coherent request/hash/ID shift cannot override
+    the canonical source digests in the frozen baseline manifest.
+    """
+    assert request['std_sha']==baselines['std_sha']==SOURCE_SHA, 'wrong pinned source'
+    assert request['std_tree']==baselines['std_tree'], 'wrong source tree'
+    negatives=[r for r in request['rows'] if r.get('oracle') is not None]
+    assert len(negatives)==8 and {r['id'] for r in negatives}==set(baselines['oracles']), 'negative inventory'
+    checked=[]
+    for row in negatives:
+        b=baselines['oracles'][row['id']];o=row['oracle']
+        assert row['expected']=='DETECTED' and o['class']=='assertion'
+        assert {k:v for k,v in o.items() if k!='property_id'}==b['oracle_without_id'], 'logical oracle/context drift'
+        assert row['variant']==b['variant'] and row['mode']==b['mode']
+        assert row['selector']==o['selector']==b['oracle_without_id']['selector']
+        key=(row['variant'],o['file']);data=sources[key]
+        canonical=baselines['sources'][row['variant']][o['file']]
+        assert sha(data)==o['source_sha256']==canonical, 'canonical source hash mismatch'
+        effective=request['changed_file_sha256'] if row['variant']=='production' else {
+            **request['changed_file_sha256'],**request['variants'][row['variant']]['changed_file_sha256']}
+        assert effective[o['file']]==canonical, 'source-under-test mismatch'
+        source=data.decode('utf-8');lines=source.splitlines();line=o['line']
+        assert lines[line-1]==o['source_line'], 'assertion anchor'
+        if 'assertion_context' in o:
+            assert lines[line-1:line-1+len(o['assertion_context'])]==o['assertion_context'], 'assertion context'
+        assert assertion_at(source,line)==b['assertion_text'], 'intended assertion expression/clause'
+        template=b['property_id_template']
+        if b['closure_root'] is not None:
+            assert b['closure_root']==row['selector'].rsplit('::',1)[-1]
+            span=closure_span(source,b['closure_root'])
+            expected=template.replace('{source_closure_span}',span_text(span))
+            match=list(CLOSURE_COORD.finditer(expected))
+            assert len(match)==1 and match[0]['file']=='{closure@'+o['export_file']
+        else:
+            assert '{source_closure_span}' not in template
+            expected=template;span=None
+        assert o['property_id']==expected, 'stale/wrong full oracle ID'
+        if 'proposal' in o:
+            assert o['proposal']['property']['id']==expected
+            assert o['status']=='FAILURE' and o['require_only_this_failure'] is True
+        checked.append({'row_id':row['id'],'property_id':expected,'closure_span':span,
+                        'source_sha256':canonical,'assertion_line':line,
+                        'status':'SOURCE_DERIVED_EXPECTATION_NOT_OBSERVED','sole_failure':'EXACT_MATCHER_UNCHANGED'})
+    return checked
diff --git a/ch8-s1-control/pack_evidence.py b/ch8-s1-control/pack_evidence.py
new file mode 100644
index 000000000..2b2703173
--- /dev/null
+++ b/ch8-s1-control/pack_evidence.py
@@ -0,0 +1,62 @@
+"""One deterministic compact structured artifact per job. Never reads raw logs."""
+import argparse
+import base64
+import gzip
+import hashlib
+import json
+from pathlib import Path
+
+UNCOMPRESSED_CAP = 32 * 1024 * 1024
+COMPRESSED_CAP = 8 * 1024 * 1024
+NAME = 'group-evidence.json.gz'
+
+
+def pack(root):
+    files = {}
+    total = 0
+    errors = []
+    try:
+        for path in sorted(root.rglob('*.json')):
+            if path.is_symlink():
+                raise ValueError('symlink structured evidence')
+            size = path.stat().st_size
+            total += size
+            if total > UNCOMPRESSED_CAP:
+                raise ValueError('structured input cap')
+            data = path.read_bytes()
+            try:
+                json.loads(data)
+            except (ValueError, UnicodeError) as exc:
+                # Preserve the exact partial text and continue to receipts/rich
+                # inventory. The artifact remains INCOMPLETE and unqualified.
+                errors.append(str(path.relative_to(root)) + ': ' + str(exc))
+            try:
+                text=data.decode('utf-8');encoding='utf-8'
+            except UnicodeError:
+                text=base64.b64encode(data).decode('ascii');encoding='base64'
+            files[str(path.relative_to(root))] = {'sha256': hashlib.sha256(data).hexdigest(),
+                                               'bytes': len(data), 'text': text, 'encoding':encoding}
+    except (OSError, ValueError) as exc:
+        errors.append(str(exc))
+    error = '; '.join(errors) if errors else None
+    doc = {'schema': 'ch8-s1-05-artifact-v1', 'state': 'INCOMPLETE' if error else 'PACKAGED',
+           'error': error, 'files': files, 'proof_credit': 'NONE'}
+    raw = json.dumps(doc, ensure_ascii=False, separators=(',', ':')).encode()
+    compressed = gzip.compress(raw, mtime=0)
+    if len(raw) > UNCOMPRESSED_CAP or len(compressed) > COMPRESSED_CAP:
+        error = 'compact artifact cap'
+        # Preserve identities/exits/snapshots in the small receipts when inventory cannot fit.
+        kept = {k: v for k, v in files.items() if k.endswith('receipt.json') and v['bytes'] <= 65536}
+        doc.update(state='INCOMPLETE', error=error, files=kept)
+        raw = json.dumps(doc, ensure_ascii=False, separators=(',', ':')).encode()
+        compressed = gzip.compress(raw, mtime=0)
+    if len(raw) > UNCOMPRESSED_CAP or len(compressed) > COMPRESSED_CAP:
+        raise ValueError('bounded fallback receipts exceed artifact cap')
+    (root / NAME).write_bytes(compressed)
+    return {'artifact': NAME, 'state': doc['state'], 'uncompressed_bytes': len(raw),
+            'compressed_bytes': len(compressed), 'sha256': hashlib.sha256(compressed).hexdigest()}
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(); parser.add_argument('--root', type=Path, required=True)
+    print(json.dumps(pack(parser.parse_args().root), sort_keys=True))
diff --git a/ch8-s1-control/rich_evidence.py b/ch8-s1-control/rich_evidence.py
new file mode 100644
index 000000000..f029656e5
--- /dev/null
+++ b/ch8-s1-control/rich_evidence.py
@@ -0,0 +1,232 @@
+"""Streaming decoder for stock 0aac regular property output; no acceptance rules.
+
+Matches cbmc_property_renderer::format_result and SourceLocation::fmt. Results
+are cross-checked against the SAME invocation's stock export, never counts alone.
+"""
+import codecs
+import os
+from pathlib import Path
+import re
+
+MAX_BYTES = 16 * 1024 * 1024
+MAX_RECORD_BYTES = 64 * 1024
+CHECK_BUCKETS = ('failure', 'unreachable', 'undetermined', 'error', 'unknown', 'other')
+COVER_BUCKETS = ('satisfied', 'unsatisfiable', 'unreachable', 'undetermined', 'error', 'unknown', 'other')
+
+
+# Coordinator-authorized location-only exception. Exact same-row identities from
+# S1-06; no source site is reconstructed and offline admission remains pending.
+LOCATION_POLICY = 'S1-07_EXACT_STOCK_UNREACHABLE_LOCATION_ONLY_V1'
+_SMALLSORT = 'slice::sort::shared::smallsort::'
+_MODEL = _SMALLSORT + 'verify::sorting_model::'
+_LOCATION_U8 = (_SMALLSORT + 'small_sort_general_with_scratch::<u8, ' +
+                _MODEL + 'KeyLess<u8>>.unreachable.1')
+_LOCATION_NONCOPY = (_SMALLSORT + 'small_sort_general_with_scratch::<' + _MODEL +
+                     'NonCopyByte, ' + _MODEL + 'KeyLess<' + _MODEL +
+                     'NonCopyByte>>.unreachable.1')
+LOCATION_EXCEPTION_BINDINGS = {
+    _SMALLSORT + 'verify::sorting_entry_smoke::' + family + '_n' + str(n): pid
+    for family, pid in (('freeze_copy_u8', _LOCATION_U8),
+                        ('freeze_default_noncopy', _LOCATION_NONCOPY),
+                        ('stable_freeze_u8', _LOCATION_U8),
+                        ('unstable_freeze_u8', _LOCATION_U8))
+    for n in range(4)
+}
+LOCATION_EXCEPTION_BINDINGS[_SMALLSORT + 'verify::sorting_entry_controls::stable_freeze_activation'] = _LOCATION_U8
+
+
+
+def location_exception(harness, p):
+    pid = LOCATION_EXCEPTION_BINDINGS.get(harness)
+    if pid is None:
+        return False
+    function = pid.removesuffix('.unreachable.1')
+    return (p.get('id') == pid and p.get('display_id') == pid and
+            p.get('class') == 'unreachable' and p.get('status') == 'SUCCESS' and
+            p.get('description') == 'unreachable code' and
+            p.get('file') is None and p.get('line') is None and
+            p.get('location_display') == 'library/core/src/lib.rs:0:0 in function ' + function)
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def bucket_ids(bucket, key):
+    value = bucket.get(key)
+    require(isinstance(value, list), 'missing/wrong bucket: ' + key)
+    if key == 'other':
+        require(all(isinstance(p, dict) and isinstance(p.get('id'), str)
+                    and isinstance(p.get('status'), str) for p in value), 'other bucket shape')
+        return [p['id'] for p in value]
+    require(all(isinstance(p, str) and p for p in value), 'bucket ID type')
+    return value
+
+
+def validate_stock_inventory(h):
+    checks, covers = h['checks'], h['covers']
+    ids = []
+    for bucket, names in ((checks, CHECK_BUCKETS), (covers, COVER_BUCKETS)):
+        require(type(bucket.get('total')) is int and bucket['total'] >= 0, 'total')
+        count = 0
+        for key in names:
+            items = bucket_ids(bucket, key); count += len(items); ids.extend(items)
+        if bucket is checks:
+            require(type(bucket.get('success')) is int and bucket['success'] >= 0, 'success count')
+            count += bucket['success']
+        require(count == bucket['total'], 'partition total')
+    require(len(ids) == len(set(ids)), 'duplicate stock ID')
+    require(type(h.get('n_properties')) is int and h['n_properties'] == checks['total'] + covers['total'], 'property total')
+    named = h.get('failed_properties')
+    require(isinstance(named, list) and all(isinstance(p, dict) for p in named), 'failed properties')
+    require(type(h.get('n_failed')) is int and h['n_failed'] == len(checks['failure']) == len(named), 'failure total')
+    require({p.get('id') for p in named} == set(checks['failure']), 'failed IDs')
+
+
+class RegularEvidence:
+    def __init__(self, selectors, cwd):
+        self.selectors, self.cwd = selectors, Path(cwd)
+        self.decoder = codecs.getincrementaldecoder('utf-8')('strict')
+        self.buffer = ''; self.bytes = 0; self.current = None
+        self.records = {}; self.in_results = False; self.block = []
+        self.closed = set(); self.error = None; self.finished = False; self.complete = False
+        self.missing_sites = []
+
+    def feed(self, data):
+        self.bytes += len(data)
+        if self.error:
+            return
+        try:
+            require(not self.finished and self.bytes <= MAX_BYTES, 'regular stream exceeds limit or already closed')
+            self.buffer += self.decoder.decode(data)
+            while '\n' in self.buffer:
+                line, self.buffer = self.buffer.split('\n', 1)
+                self._line(line)
+            require(len(self.buffer.encode()) <= MAX_RECORD_BYTES, 'regular line exceeds limit')
+        except (ValueError, UnicodeError) as exc:
+            self.error = str(exc)
+
+    def finish(self):
+        if self.finished:
+            return
+        self.finished = True
+        if self.error:
+            return
+        try:
+            self.buffer += self.decoder.decode(b'', final=True)
+            if self.buffer:
+                self._line(self.buffer)
+            require(not self.in_results and not self.block, 'partial regular RESULTS')
+            require(set(self.records) == set(self.selectors) == self.closed, 'missing regular harness RESULTS')
+        except (ValueError, UnicodeError) as exc:
+            self.error = str(exc)
+
+    def _line(self, line):
+        if self.in_results:
+            if line == 'SUMMARY:':
+                self._record(); self.in_results = False; self.closed.add(self.current)
+            elif line.startswith('Check '):
+                self._record(); self.block = [line]
+            elif self.block:
+                self.block.append(line)
+                require(sum(len(x.encode())+1 for x in self.block) <= MAX_RECORD_BYTES, 'property block exceeds limit')
+            else:
+                require(not line.strip(), 'unexpected RESULTS line')
+            return
+        marker = re.fullmatch(r'Checking harness (.+)\.\.\.', line)
+        if marker:
+            self.current = marker[1]
+            require(self.current in self.selectors and self.current not in self.records, 'unexpected/duplicate harness marker')
+            self.records[self.current] = []
+        elif line == 'RESULTS:':
+            require(self.current is not None and self.current not in self.closed, 'orphan/duplicate RESULTS')
+            self.in_results = True
+
+    def _record(self):
+        if not self.block:
+            return
+        text = '\n'.join(self.block).rstrip('\n')
+        self.block = []
+        match = re.fullmatch(r'Check ([1-9][0-9]*): (.+)\n\t - Status: ([A-Z_]+)\n\t - Description: "([\s\S]*?)"(?:\n\t - Location: ([^\n]+))?', text)
+        require(match is not None, 'missing/malformed description or location')
+        ordinal, pid, status, desc, loc = match.groups()
+        require(int(ordinal) == len(self.records[self.current])+1, 'property ordinal gap')
+        require(bool(desc), 'missing description')
+        cls = re.fullmatch(r'(?:.*\.)?(NaN|[a-z_-]+)\.([0-9]+)', pid)
+        require(cls is not None, 'property class missing')
+        site = (loc or '').split(' in function ', 1)[0]
+        place = re.fullmatch(r'(.+?):([1-9][0-9]*)(?::([0-9]+))?', site)
+        bound_site = place is not None and place[1] != 'Unknown file'
+        if not bound_site:
+            # Stock SourceLocation legitimately omits fields. Keep the property
+            # and subsequent roots; never manufacture an admissible source site.
+            self.missing_sites.append({'harness': self.current, 'display_id': pid,
+                                       'location_display': loc, 'reason': 'file/line missing'})
+        display_id = pid
+        if cls[1] == 'missing_definition':
+            pid = pid.rsplit('.missing_definition.', 1)[0] + '.' + cls[2]
+        elif cls[1] == 'recursion' and cls[2] == '1':
+            pid = pid[:-2]
+            if pid == 'recursion': pid = '.recursion'
+        file = os.path.normpath(str(self.cwd / place[1])) if bound_site else None
+        self.records[self.current].append({'id': pid, 'class': cls[1], 'description': desc,
+                                         'file': file, 'line': place[2] if bound_site else None, 'status': status,
+                                         'location_display': loc, 'display_id': display_id})
+
+    def validate(self, stock):
+        self.complete = False
+        require(self.finished and self.error is None, 'regular stream invalid: ' + str(self.error))
+        require({h['name'] for h in stock['harnesses']} == set(self.records), 'regular/stock roots differ')
+        for h in stock['harnesses']:
+            validate_stock_inventory(h)
+            records = self.records[h['name']]
+            # Display maps UNKNOWN to UNDETERMINED. Restore only by exact same-row ID.
+            unknown_ids = set(h['checks']['unknown'] + h['covers']['unknown'])
+            for p in records:
+                if p['id'] in unknown_ids:
+                    require(p['status'] == 'UNDETERMINED' or
+                            (p['status'] == 'UNKNOWN' and p.get('display_status') == 'UNDETERMINED'),
+                            'UNKNOWN display mismatch')
+                    p['display_status'] = 'UNDETERMINED'; p['status'] = 'UNKNOWN'
+            byid = {p['id']: p for p in records}
+            require(len(byid) == len(records) == h['n_properties'], 'regular inventory count/duplicate')
+            for bucket, names, cover in ((h['checks'], CHECK_BUCKETS, False), (h['covers'], COVER_BUCKETS, True)):
+                selected = [p for p in records if (p['class'] == 'cover') == cover]
+                require(len(selected) == bucket['total'], 'regular class totals')
+                if not cover:
+                    require(sum(p['status'] == 'SUCCESS' for p in selected) == bucket['success'], 'regular SUCCESS count')
+                known = {'SUCCESS'} if not cover else set()
+                for key in names:
+                    if key == 'other':
+                        continue
+                    known.add(key.upper())
+                    require({p['id'] for p in selected if p['status'] == key.upper()} == set(bucket_ids(bucket, key)), 'regular bucket mismatch: ' + key)
+                require({(p['id'], p['status']) for p in selected if p['status'] not in known} ==
+                        {(p['id'], p['status']) for p in bucket['other']}, 'regular other statuses')
+            for p in h['failed_properties'] + h['unsupported_constructs']:
+                actual = byid.get(p['id'])
+                require(actual is not None and all(actual[k] == p[k] for k in
+                        ('id', 'class', 'description', 'file', 'line', 'status')), 'rich stock property mismatch')
+        # Also inspect saved records: collector replay must not bypass this gate
+        # merely because its decoder has no streaming missing_sites list.
+        require(all(isinstance(p.get('file'), str) and p['file'] and
+                    isinstance(p.get('line'), str) and re.fullmatch(r'[1-9][0-9]*', p['line'])
+                    or location_exception(harness, p)
+                    for harness, records in self.records.items() for p in records),
+                'rich metadata incomplete: file/line missing')
+        self.complete = True
+
+    def location_exceptions(self):
+        return [{'policy': LOCATION_POLICY, 'harness': name, 'property': dict(p),
+                 'scope': 'LOCATION_ONLY', 'qualified_acceptance': 'PENDING_OFFLINE_ACCEPTANCE'}
+                for name, records in self.records.items() for p in records
+                if location_exception(name, p)]
+
+    def document(self):
+        return {'schema': 'ch8-s1-05-rich-v1', 'state': 'COMPLETE' if self.complete else 'INCOMPLETE',
+                'error': self.error, 'observed_stdout_bytes': self.bytes,
+                'missing_sites': self.missing_sites,
+                'location_exceptions': self.location_exceptions(),
+                'harnesses': [{'name': k, 'properties': v} for k, v in self.records.items()],
+                'qualified_acceptance': 'PENDING_OFFLINE_ACCEPTANCE', 'proof_credit': 'NONE'}

@@ -0,0 +1,152 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+"""Offline S1-08 package checks. Not imported by runner/collector/admission.
+
+The label matcher is an interface fixture, not an acceptance classifier. Legacy
+semantic sets still require the existing independent offline source/instance audit.
+"""
+import hashlib
+import re
+
+ROLE_SUFFIX = {
+    'S1_ENTRY_MODEL_ENABLED': 'model_enabled',
+    'S1_EXACT_TRAIT_THRESHOLD': 's1_exact_trait_threshold',
+    'S1_ENTRY_TYPE_LAYOUT': 'type_layout',
+    'S1_ENTRY_POST_INDEPENDENT_CALLER': 'post_independent_caller',
+    'S1_LEFT_CANARY': 'left_canary', 'S1_RIGHT_CANARY': 'right_canary',
+    'S1_N1_VALUE_UNCHANGED': 'n1_value_unchanged',
+    'S1_N0_EMPTY_UNCHANGED': 'n0_empty_unchanged',
+    'S1_MODEL_ENABLED': 'model_enabled', 'S1_IDENTITY_CHECKER': 'identity_checker',
+    'S1_CONSTRUCTED_SORTED_PERMUTATION': 'constructed_sorted_permutation',
+    'S1_FNMUT_TWO_PROJECTIONS': 'fnmut_two_projections',
+    'S1_FNONCE_TWO_PROJECTIONS': 'fnonce_two_projections',
+    'S1_ELEMENT_LAYOUT': 'element_layout',
+    'S1_COMPARATOR_ZST_ELEMENT_NO_DROP': 'comparator_zst_element_no_drop',
+}
+PLACEHOLDER = "This is a placeholder message; Kani doesn't support message formatted at runtime"
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def tokens(source):
+    # Bounded lexical comparison, not a Rust parser. Strings/comments remain
+    # indivisible, so whitespace inside messages/comments cannot disappear.
+    return re.findall(r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/|\w+|[^\s]', source, re.S)
+
+
+def region(source, macro):
+    start = source.index('macro_rules! ' + macro + ' {')
+    # In these frozen files each macro ends on its own column-zero brace.
+    end = source.index('\n}', start) + 2
+    return start, end
+
+
+def labelled_sites(source, macro):
+    lo, hi = region(source, macro)
+    pattern = r'kani::assert\((.*?),\s*concat!\(stringify!\(\$name\), "::([a-z0-9_]+)"\)\);'
+    out = {}
+    for m in re.finditer(pattern, source[lo:hi], re.S):
+        role = m[2]
+        assert role not in out, 'duplicate role in macro'
+        start, end = lo + m.start(), lo + m.end()
+        out[role] = {'expression': m[1], 'line': source.count('\n', 0, start)+1,
+                     'end_line': source.count('\n', 0, end)+1,
+                     'text': source[start:end]}
+    return out
+
+
+def equivalent(base, candidate, macros):
+    """Verify entire file tokens after exactly the permitted diagnostic rewrite.
+
+    This retains assertion operands/order, branches, assumptions, types, covers,
+    invocation geometry, and all negative/helper functions outside the macros.
+    """
+    expected = base
+    counts = {}
+    for macro, count in macros.items():
+        lo, hi = region(expected, macro)
+        def rewrite(m):
+            role = ROLE_SUFFIX[m[2]]  # unknown original diagnostics fail closed
+            return 'kani::assert(' + m[1] + ', concat!(stringify!($name), "::' + role + '"));'
+        body, found = re.subn(r'assert!\((.*?),\s*"(S1_[A-Z0-9_]+)"\);', rewrite,
+                              expected[lo:hi], flags=re.S)
+        assert found == count, (macro, found, count)
+        expected = expected[:lo] + body + expected[hi:]
+        counts[macro] = found
+    assert tokens(expected) == tokens(candidate), 'non-diagnostic source change'
+    return counts
+
+
+def validate_map(manifest, request):
+    assert manifest['std_sha'] == request['std_sha']
+    assert manifest['std_tree'] == request['std_tree']
+    entries = manifest['required_success_bindings']
+    expected = [(r['id'], msg) for r in request['rows'] for msg in r['required_success_messages']]
+    assert [(e['row_id'], e['expected_message']) for e in entries] == expected
+    assert len(entries) == 127 and len(set(expected)) == 127
+    labelled = [e for e in entries if e['binding_kind'] == 'EXACT_ROLE_LABEL']
+    assert len(labelled) == 111 and len({e['row_id'] for e in labelled}) == 21
+    assert len({e['expected_message'] for e in labelled}) == 111
+    assert len([e for e in entries if e['binding_kind'].startswith('EXACT_SUCCESS_SEMANTIC')]) == 16
+    byid = {r['id']: r for r in request['rows']}
+    for e in entries:
+        row = byid[e['row_id']]
+        assert e['selector'] == row['selector'] and e['root'] == row['selector'].rsplit('::', 1)[-1]
+        assert e['source']['sha256'] == request['changed_file_sha256'][e['source']['file']]
+        assert e['applicability'] == {'N': row.get('N'), 'predicate': 'true_for_this_row'}
+        assert e['observed_s108_property_ids'] is None and e['observed_s108_status'] == 'NOT_RUN'
+        assert e['source']['sites']
+        if e['binding_kind'] == 'EXACT_ROLE_LABEL':
+            assert e['expected_description'] == e['expected_message'] == e['root'] + '::' + e['role']
+            assert e['cardinality'] == 'EXACTLY_ONE_ID_SUCCESS' and e['source']['macro']
+        else:
+            assert e['expected_description'] == PLACEHOLDER
+            assert e['expected_message'] == e['legacy_s107']['message']
+            assert e['binding_kind'] == e['legacy_s107']['binding']
+            assert e['cardinality'] == ('COMPLETE_SOURCE_INSTANCE_SET' if e['binding_kind'].endswith('_SET')
+                                        else 'EXACT_SOURCE_SEMANTIC_BINDING')
+    # Extra conditional assertions are retained but never required at a different N.
+    for e in manifest['supplemental_label_sites']:
+        row = byid[e['row_id']]
+        assert e['required_in_127'] is False
+        if e['role'] in ('n0_empty_unchanged', 'n1_value_unchanged'):
+            n = 0 if e['role'].startswith('n0') else 1
+            assert e['applies'] == (row.get('N') == n or row.get('N') == 'symbolic0..3')
+            assert e['guard'] == f'n == {n}'
+    return {'required': 127, 'new_labels': 111, 'preserved_semantic_bindings': 16}
+
+
+def label_fixture(entry, envelope, manifest, request_sha256):
+    """Fail-closed synthetic contract for a future exact-label observation.
+
+    The producer IDs are opaque: never derive an assertion ordinal. This result
+    alone gives no proof credit and does not close other admission gates.
+    """
+    unknown = {'binding': 'UNKNOWN', 'proof_credit': 'NONE'}
+    if entry.get('binding_kind') != 'EXACT_ROLE_LABEL' or not isinstance(envelope, dict):
+        return unknown
+    if (envelope.get('std_sha') != manifest['std_sha'] or
+        envelope.get('std_tree') != manifest['std_tree'] or
+        envelope.get('tool_sha') != manifest['tool_sha'] or
+        envelope.get('row_id') != entry['row_id'] or
+        envelope.get('request_sha256') != request_sha256 or
+        envelope.get('source_sha256') != entry['source']['sha256'] or
+        envelope.get('selector') != entry['selector'] or
+        envelope.get('state') != 'COMPLETE' or not isinstance(envelope.get('properties'), list)):
+        return unknown
+    props = envelope['properties']
+    if any(not isinstance(p, dict) for p in props):
+        return unknown
+    hits = [p for p in props if p.get('description') == entry['expected_description']]
+    if len(hits) != 1:
+        return unknown
+    p = hits[0]
+    if (p.get('class') != 'assertion' or p.get('status') != 'SUCCESS' or
+        not isinstance(p.get('id'), str) or not p['id'].startswith(entry['selector'] + '.') or
+        sum(q.get('id') == p['id'] for q in props) != 1 or
+        p.get('file') != entry['source']['file'] or type(p.get('line')) is not int or
+        p['line'] not in entry['source']['allowed_property_lines']):
+        return unknown
+    return {'binding': 'EXACT_LABEL_INTERFACE_MATCH', 'property_id': p['id'], 'proof_credit': 'NONE'}
diff --git a/ch8-s1-control/s2_policy.py b/ch8-s1-control/s2_policy.py
new file mode 100644
index 000000000..af2ddadff
--- /dev/null
+++ b/ch8-s1-control/s2_policy.py
@@ -0,0 +1,106 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+"""S2 static binding and offline oracle checks; never grants proof credit."""
+import hashlib
+import re
+import negative_oracle
+ROOTS=('swap_pfc','summary_witness','merge32_real','sort13_assumed','general32_assumed',
+ 'merge_order_corrupt','merge_count_corrupt','checker_count_corrupt','checker_order_corrupt','sort13_weak','general32_weak')
+PREFIX='slice::sort::shared::smallsort::verify::sorting_s2_batch::'
+CFG='--cfg=kani_smallsort_sorting --cfg=kani_smallsort_controls --cfg=kani_smallsort_s2_assumed'
+SMALLSORT='library/core/src/slice/sort/shared/smallsort.rs'
+BATCH='library/core/src/slice/sort/shared/smallsort/verify/sorting_s2_batch.rs'
+BASE='99e8456d200fff1299ee5756279cddb23921dc65'
+TOOL='0aac16ef62da9e9d5645782d458593e5d78143ba'
+STUBS={'sort13_assumed':['#[kani::stub_verified(swap_if_less)]'],
+ 'general32_assumed':['#[kani::stub_verified(sort8_stable)]','#[kani::stub_verified(insert_tail)]','#[kani::stub_verified(bidirectional_merge)]'],
+ 'sort13_weak':['#[kani::stub(swap_if_less,weak_swap)]'],
+ 'general32_weak':['#[kani::stub_verified(sort8_stable)]','#[kani::stub_verified(insert_tail)]','#[kani::stub(bidirectional_merge,weak_merge)]']}
+def digest(data):return hashlib.sha256(data).hexdigest()
+
+def validate_request(r):
+    assert r['schema']=='ch8-s2-batch3probes-v1'
+    assert [x['id'] for x in r['rows']]==list(ROOTS)
+    assert r['base_std_sha']==BASE and r['tool_sha']==TOOL
+    assert r['formal_expected_inventory']==['merge32_real']
+    assert r['diagnostic_assumed_inventory']==['sort13_assumed','general32_assumed']
+    assert r['qualification_inventory']==['swap_pfc']
+    assert r['proof_credit']=='NONE' and r['future_runs']==1
+    assert r['runtime_smallsort_base_sha256']=='45ae77ad0bb2a74cfab1aa53d5e1c48311f0b483c94eb52d96d97f680bd39651'
+    assert r['flags']=={'unstable':['function-contracts','mem-predicates','float-lib','c-ffi','loop-contracts','quantifiers','stubbing','export-json'],'assert_contracts':False,'jobs':1,'harness_timeout':'600s','exact':True,'default_unwind':34,'cbmc_args':['--object-bits','12'],'RUSTFLAGS':CFG}
+    assert r['execution_groups']==[{'id':'s2-batch3probes-u34','variant':'production','unwind':34,'row_ids':list(ROOTS)}]
+    assert r['replacement_unions']==[] and r['variants']=={}
+    for row in r['rows']:
+        rid=row['id'];b=r['source_bindings'][rid]
+        assert row['mode']==('PFC' if rid=='swap_pfc' else 'Original')
+        assert b['target']==('swap_if_less' if rid=='swap_pfc' else None)
+        assert row['selector']==PREFIX+rid and row['source_qualified_selector']=='core::'+PREFIX+rid
+        assert row['variant']=='production' and row['unwind']==34 and row['timeout_seconds']==600
+        assert row['proof_credit']=='NONE' and row['state']=='NOT_RUN'
+        assert b['file']==BATCH and b['selector']==row['selector'] and b['mode']==row['mode']
+        assert row['required_cover_count']==len(row['required_cover_messages'])
+        assert b['sha256']==r['changed_file_sha256'][BATCH]
+        if rid in ROOTS[:5]:
+            assert row['expected']=='SUCCESS' and row['required_cover_count']>=3
+            assert row['required_success_messages'] and 'oracle' not in row
+        else:
+            assert row['expected']=='DETECTED' and row['required_cover_count']==0
+            o=row['oracle']
+            assert o['property_id']==row['selector']+'.assertion.1'
+            assert o['selector']==row['selector'] and o['file']==BATCH and o['class']=='assertion'
+            assert o['source_sha256']==b['sha256'] and o['intended_message']==row['failure_description']
+        if rid in ('sort13_assumed','general32_assumed'):assert row['assurance']=='DIAGNOSTIC_ASSUMED'
+    assert sum(x['timeout_seconds'] for x in r['rows'])+r['budgets']['compile_seconds']==7500
+    return True
+
+def validate_source(std,r):
+    validate_request(r)
+    lines=(std/BATCH).read_text().splitlines()
+    for row in r['rows']:
+        rid=row['id'];b=r['source_bindings'][rid]
+        assert digest((std/b['file']).read_bytes())==b['sha256']
+        start=next(i for i,s in enumerate(lines) if s.startswith('fn '+rid+'('))
+        attr=start-1
+        while attr>0 and lines[attr-1].startswith('#[kani::'):attr-=1
+        attrs=lines[attr:start]
+        expected='#[kani::proof_for_contract(swap_if_less)]' if rid=='swap_pfc' else '#[kani::proof]'
+        assert attrs[0]==expected and lines[start]=='fn '+rid+'() {'
+        assert {x['line'] for x in b['locations']}=={start+1,attr+1}
+        if 'oracle' in row:
+            o=row['oracle'];line=lines[o['line']-1]
+            assert line==o['source_line'] and '"'+row['failure_description']+'"' in line
+            end=next((i for i in range(start+1,len(lines)) if lines[i]=='}'),len(lines))
+            assertions=[s for s in lines[start+1:end] if re.search(r'\bassert!\(',s)]
+            assert len(assertions)==1 and line in assertions
+        assert [s for s in attrs if 'stub' in s]==STUBS.get(rid,[])
+    added='#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed),'
+    small=(std/SMALLSORT).read_text()
+    stripped='\n'.join(s for s in small.splitlines() if not s.startswith(added))+'\n'
+    assert digest(stripped.encode())==r['runtime_smallsort_base_sha256']
+    assert sum(s.startswith(added) for s in small.splitlines())==8
+    return True
+
+def expected_observation(row,parsed,properties):
+    """Input must already be parser-bound plus same-invocation rich.validate.
+
+    Exact source/tool/request/binary/compile identities remain caller obligations.
+    True means an expected source-reported observation, never formal admission.
+    """
+    if parsed.get('state')!='RECORDED_OBSERVATION' or parsed.get('outcome')!='RECORDED':return False
+    h=parsed.get('harness');records=properties.get('properties') if isinstance(properties,dict) else None
+    if not isinstance(h,dict) or not isinstance(records,list) or properties.get('name')!=row['selector']:return False
+    byid={p.get('id'):p for p in records if isinstance(p,dict)}
+    if len(byid)!=len(records):return False
+    if row['expected']=='DETECTED':
+        o=row['oracle']
+        actual=byid.get(o['property_id'],{})
+        return (negative_oracle.matches(h,o) and actual.get('description')==row['failure_description']
+                and all(actual.get(k)==h['failed_properties'][0].get(k) for k in ('id','class','description','file','line','status')))
+    if h.get('outcome')!={'kind':'COMPLETED','verdict':'SUCCESS'}:return False
+    checks,covers=h.get('checks',{}),h.get('covers',{})
+    if any(checks.get(k)!=[] for k in ('failure','unreachable','undetermined','error','unknown','other')):return False
+    if checks.get('success')!=checks.get('total'):return False
+    if any(covers.get(k)!=[] for k in ('unsatisfiable','unreachable','undetermined','error','unknown','other')):return False
+    successful={p.get('description') for p in records if p.get('class')!='cover' and p.get('status')=='SUCCESS'}
+    satisfied={p.get('description') for p in records if p.get('class')=='cover' and p.get('status')=='SATISFIED'}
+    return (set(row['required_success_messages']).issubset(successful) and set(row['required_cover_messages'])==satisfied and covers.get('total')==row['required_cover_count'])

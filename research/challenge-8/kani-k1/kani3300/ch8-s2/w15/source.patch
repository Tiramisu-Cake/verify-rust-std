+++ b/library/core/src/slice/sort/shared/smallsort/verify/sorting_merge_invariant.rs
@@ -0,0 +1,157 @@
+//! Induction pilot over initialized u8 arrays, CAP32, lawful closed comparator.
+//! Not a contract for the actual bidirectional_merge loop. W13 owns that integration.
+use super::super::{merge_down, merge_up};
+use super::sorting_merge_model::{CAP, Fronts, count, halves, invariant, ordered};
+use super::sorting_model::KeyLess;
+use crate::{kani, ptr};
+
+fn arbitrary_fronts() -> Fronts {
+    Fronts { k: kani::any(), i: kani::any(), j: kani::any(), ir: kani::any(), jr: kani::any() }
+}
+
+// Called only after invariant && k<h. Each forward/reverse pointer read is then
+// within its original half, even if combined forward/reverse consumption meets.
+fn paired_step(src: &[u8; CAP], dst: &mut [u8; CAP], len: usize, s: &mut Fronts) {
+    let h = len / 2;
+    assert!(s.k < h, "S2_STEP_GUARD");
+    assert!(s.i < h && s.j < len - h && s.ir < h && s.jr < len - h,
+        "S2_STEP_READS_IN_BOUNDS");
+    let mut cmp = KeyLess::<u8>::new();
+    unsafe {
+        let base = src.as_ptr();
+        let left = base.add(s.i);
+        let right = base.add(h + s.j);
+        let left_rev = base.add(h - 1).wrapping_sub(s.ir);
+        let right_rev = base.add(len - 1).wrapping_sub(s.jr);
+        let (l, r, d) = merge_up(left, right, dst.as_mut_ptr().add(s.k), &mut cmp);
+        let (lr, rr, dr) = merge_down(left_rev, right_rev,
+            dst.as_mut_ptr().add(len - 1 - s.k), &mut cmp);
+        s.i += (l != left) as usize;
+        s.j += (r != right) as usize;
+        s.ir += (lr != left_rev) as usize;
+        s.jr += (rr != right_rev) as usize;
+        s.k += 1;
+        assert!(l == base.add(s.i) && r == base.add(h + s.j), "S2_FORWARD_BINDING");
+        // No in-bounds add/sub with an exhausted reverse counter.
+        assert!(lr == base.add(h - 1).wrapping_sub(s.ir)
+            && rr == base.add(len - 1).wrapping_sub(s.jr), "S2_REVERSE_BINDING");
+        assert!(d == dst.as_mut_ptr().add(s.k)
+            && dr == dst.as_mut_ptr().add(len - 1 - s.k), "S2_OUTPUT_BINDING");
+    }
+}
+
+// Exact odd-copy and end-pointer operations of the actual epilogue. No panic cut.
+// We assert the actual panic guard false; the monolithic root checks actual panic.
+fn finish(src: &[u8; CAP], dst: &mut [u8; CAP], len: usize, s: Fronts, q: u8) {
+    assert!(s.k == len / 2, "S2_EXIT_GUARD");
+    let h = len / 2;
+    let left_remaining = h - s.i - s.ir;
+    let right_remaining = len - h - s.j - s.jr;
+    assert!(left_remaining + right_remaining == len % 2, "S2_EXIT_REMAINDER");
+    unsafe {
+        let base = src.as_ptr();
+        let mut left = base.add(s.i);
+        let mut right = base.add(h + s.j);
+        let left_end = base.add(h - 1).wrapping_sub(s.ir).wrapping_add(1);
+        let right_end = base.add(len - 1).wrapping_sub(s.jr).wrapping_add(1);
+        if !len.is_multiple_of(2) {
+            let left_nonempty = left < left_end;
+            assert!(left_nonempty == (left_remaining == 1), "S2_ODD_SELECTION");
+            let last_src = if left_nonempty { left } else { right };
+            ptr::copy_nonoverlapping(last_src, dst.as_mut_ptr().add(s.k), 1);
+            left = left.add(left_nonempty as usize);
+            right = right.add((!left_nonempty) as usize);
+        }
+        assert!(left == left_end && right == right_end, "S2_ORD_PANIC_UNREACHABLE");
+    }
+    assert!(ordered(dst, 0, len), "S2_EXIT_SORTED");
+    assert!(count(src, 0, len, q) == count(dst, 0, len, q), "S2_EXIT_PROBE_COUNT");
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_invariant_base_cap32() {
+    let src: [u8; CAP] = kani::any();
+    let dst: [u8; CAP] = kani::any();
+    let len: usize = kani::any();
+    let q: u8 = kani::any();
+    kani::assume(halves(&src, len));
+    assert!(invariant(&src, &dst, len, Fronts::zero(), q), "S2_INVARIANT_BASE");
+    kani::cover(len == 2, "S2_base_min");
+    kani::cover(len == 31, "S2_base_odd");
+    kani::cover(len == 32, "S2_base_cap");
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_invariant_step_cap32() {
+    let src: [u8; CAP] = kani::any();
+    let original = src;
+    let mut dst: [u8; CAP] = kani::any();
+    let before = dst;
+    let len: usize = kani::any();
+    let q: u8 = kani::any();
+    let mut s = arbitrary_fronts();
+    kani::assume(invariant(&src, &dst, len, s, q));
+    kani::assume(s.k < len / 2);
+    let k = s.k;
+    paired_step(&src, &mut dst, len, &mut s);
+    assert!(invariant(&src, &dst, len, s, q), "S2_INVARIANT_STEP");
+    assert!(src == original, "S2_STEP_SOURCE_FRAME");
+    for i in 0..CAP {
+        assert!(i == k || i == len - 1 - k || dst[i] == before[i], "S2_STEP_WRITE_FRAME");
+    }
+    kani::cover(len == 32 && k == 15, "S2_step_final_even");
+    kani::cover(len == 31 && k == 14, "S2_step_final_odd");
+    kani::cover(s.ir == len / 2, "S2_step_left_reverse_sentinel");
+    kani::cover(s.jr == len - len / 2, "S2_step_right_reverse_exhausted");
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_invariant_exit_cap32() {
+    let src: [u8; CAP] = kani::any();
+    let original = src;
+    let mut dst: [u8; CAP] = kani::any();
+    let before = dst;
+    let len: usize = kani::any();
+    let q: u8 = kani::any();
+    let s = arbitrary_fronts();
+    kani::assume(invariant(&src, &dst, len, s, q));
+    kani::assume(s.k == len / 2);
+    finish(&src, &mut dst, len, s, q);
+    assert!(src == original, "S2_EXIT_SOURCE_FRAME");
+    for i in 0..CAP {
+        assert!((len % 2 == 1 && i == s.k) || dst[i] == before[i], "S2_EXIT_WRITE_FRAME");
+    }
+    kani::cover(len == 32, "S2_exit_even_cap");
+    kani::cover(len == 31 && s.i + s.ir < len / 2, "S2_exit_odd_left");
+    kani::cover(len == 31 && s.j + s.jr < len - len / 2, "S2_exit_odd_right");
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_loop_pilot_cap32() {
+    let src: [u8; CAP] = kani::any();
+    let original = src;
+    let mut dst: [u8; CAP] = kani::any();
+    let before = dst;
+    let len: usize = kani::any();
+    let q: u8 = kani::any();
+    kani::assume(halves(&src, len));
+    let mut s = Fronts::zero();
+    // Partial correctness only. No complex loop_decreases(h - s.k) (#4585).
+    #[kani::loop_invariant(invariant(&src, &dst, len, s, q))]
+    #[kani::loop_modifies(&s, &mut dst[..len])]
+    while s.k < len / 2 {
+        paired_step(&src, &mut dst, len, &mut s);
+    }
+    finish(&src, &mut dst, len, s, q);
+    assert!(src == original, "S2_LOOP_SOURCE_FRAME");
+    for i in 0..CAP {
+        assert!(i < len || dst[i] == before[i], "S2_LOOP_OUTSIDE_FRAME");
+    }
+    kani::cover(len == 2, "S2_loop_min_return");
+    kani::cover(len == 31, "S2_loop_odd_return");
+    kani::cover(len == 32, "S2_loop_cap_return");
+}
diff --git a/library/core/src/slice/sort/shared/smallsort/verify/sorting_merge_model.rs b/library/core/src/slice/sort/shared/smallsort/verify/sorting_merge_model.rs

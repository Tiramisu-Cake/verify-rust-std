+//! Real bidirectional_merge len32: no verified summaries and no panic/comparator stub.
+use super::super::bidirectional_merge;
+use super::sorting_merge_model::{CAP, count, halves, ordered};
+use super::sorting_model::{KeyLess, enabled};
+use crate::mem::MaybeUninit;
+use crate::kani;
+
+pub(super) fn merge32() -> ([u8; CAP], [u8; CAP], u8) {
+    let src: [u8; CAP] = kani::any();
+    let before = src;
+    let q: u8 = kani::any();
+    kani::assume(halves(&src, CAP));
+    assert!(enabled::<u8, KeyLess<u8>>(), "S2_MERGE_MODEL_ACTIVE");
+    // Actual output remains uninitialized until actual merge writes it; two guards.
+    let mut dst = [MaybeUninit::<u8>::uninit(); CAP + 2];
+    dst[0].write(0x39);
+    dst[CAP + 1].write(0xc6);
+    let mut cmp = KeyLess::<u8>::new();
+    // SAFETY: disjoint arrays, 32 initialized input bytes, interior writable output32.
+    unsafe { bidirectional_merge(&src, dst.as_mut_ptr().add(1).cast::<u8>(), &mut cmp) };
+    let mut output = [0; CAP];
+    let mut i = 0;
+    while i < CAP {
+        // SAFETY: the real body initializes every destination byte on normal return.
+        output[i] = unsafe { dst[i + 1].assume_init() };
+        i += 1;
+    }
+    assert!(src == before, "S2_MERGE_SOURCE_FRAME");
+    assert!(unsafe { dst[0].assume_init() } == 0x39, "S2_MERGE_LEFT_FRAME");
+    assert!(unsafe { dst[CAP + 1].assume_init() } == 0xc6, "S2_MERGE_RIGHT_FRAME");
+    (src, output, q)
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_u8_len32_real_body() {
+    let (src, dst, q) = merge32();
+    assert!(ordered(&dst, 0, CAP), "S2_MERGE32_SORTED");
+    assert!(count(&src, 0, CAP, q) == count(&dst, 0, CAP, q), "S2_MERGE32_PROBE_COUNT");
+    kani::cover(src[0] > src[16], "S2_merge_right_front_first_return");
+    kani::cover(src[0] < src[16], "S2_merge_left_front_first_return");
+    kani::cover(src[15] == src[16], "S2_merge_cross_half_tie_return");
+    kani::cover(dst[0] < dst[31], "S2_merge_nonconstant_return");
+    kani::cover(q == src[0], "S2_merge_probe_present_return");
+    kani::cover(count(&src, 0, CAP, q) == 0, "S2_merge_probe_absent_return");
+    kani::cover(true, "S2_merge_useful_return");
+}

+//! Opt-in controls. Named intended failures must not enter ordinary inventory.
+use super::sorting_merge_model::{CAP, Fronts, count, invariant, ordered};
+use super::sorting_merge_probe::merge32;
+use crate::kani;
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_rejects_unguarded_endpoints() {
+    let mut src = [0; CAP];
+    src[..4].copy_from_slice(&[1, 9, 2, 10]);
+    let mut dst = [0; CAP];
+    dst[0] = 9;
+    dst[3] = 2;
+    let s = Fronts { k: 1, i: 1, j: 0, ir: 0, jr: 1 };
+    assert!(!invariant(&src, &dst, 4, s, 0), "S2_GUARDED_ENDPOINT_REGRESSION");
+    kani::cover(true, "S2_endpoint_rejection_reached");
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_rejects_unsorted_output() {
+    let (src, mut dst, _q) = merge32();
+    kani::assume(src[0] != src[31]);
+    dst.swap(0, CAP - 1);
+    assert!(ordered(&dst, 0, CAP), "S2_NEG_SORTED");
+}
+
+#[kani::proof]
+#[kani::unwind(34)]
+fn s2_merge_rejects_wrong_count() {
+    let (src, mut dst, _q) = merge32();
+    let q = dst[0];
+    dst[0] = q.wrapping_add(1);
+    assert!(count(&src, 0, CAP, q) == count(&dst, 0, CAP, q), "S2_NEG_COUNT");
+}
+
+#[kani::proof]
+#[kani::unwind(4)]
+fn s2_merge_false_invariant() {
+    let mut k = 0usize;
+    #[kani::loop_invariant(k == 0)]
+    #[kani::loop_modifies(&k)]
+    while k < 1 { k += 1; }
+    kani::cover(true, "S2_false_invariant_return");
+}
+
+#[kani::proof]
+#[kani::unwind(4)]
+fn s2_merge_simple_decreases() {
+    let mut remaining: u8 = kani::any();
+    kani::assume(remaining <= 16);
+    #[kani::loop_invariant(remaining <= 16)]
+    #[kani::loop_modifies(&remaining)]
+    #[kani::loop_decreases(remaining)]
+    while remaining > 0 { remaining -= 1; }
+    assert!(remaining == 0, "S2_SIMPLE_DECREASES_EXIT");
+    kani::cover(true, "S2_decreases_return");
+}
+
+#[kani::proof]
+#[kani::unwind(4)]
+fn s2_merge_false_decreases() {
+    let mut k = 0u8;
+    let remaining = 1u8;
+    #[kani::loop_invariant(k <= 1 && remaining == 1)]
+    #[kani::loop_modifies(&k)]
+    #[kani::loop_decreases(remaining)]
+    while k < 1 { k += 1; }
+    kani::cover(true, "S2_false_decreases_return");
+}
+
+#[kani::proof]
+#[kani::unwind(4)]
+fn s2_merge_false_frame() {
+    let mut k = 0u8;
+    let mut outside = 0u8;
+    #[kani::loop_invariant(k <= 1)]
+    #[kani::loop_modifies(&k)]
+    while k < 1 { outside = 1; k += 1; }
+    assert!(outside <= 1);
+}
diff --git a/library/core/src/slice/sort/shared/smallsort/verify/sorting_merge_invariant.rs b/library/core/src/slice/sort/shared/smallsort/verify/sorting_merge_invariant.rs

rc, &*left_src);\n        let src = if is_l { right_src } else { left_src };\n        ptr::copy_nonoverlapping(src, dst, 1);\n        right_src = right_src.wrapping_sub(is_l as usize);\n        left_src = left_src.wrapping_sub(!is_l as usize);\n        dst = dst.sub(1);\n    }\n\n    (left_src, right_src, dst)\n}\n\n#[cfg(kani)]\nfn merge_contract_regions_disjoint<T>(src: *const T, dst: *mut T, len: usize) -> bool {\n    let Some(bytes) = size_of::<T>().checked_mul(len) else {\n        return false;\n    };\n    bytes == 0\n        || !crate::ub_checks::same_allocation(src, dst)\n        || (src as usize).abs_diff(dst as usize) >= bytes\n}\n\n/// Merge v assuming v[..len / 2] and v[len / 2..] are sorted.\n///\n/// Original idea for bi-directional merging by Igor van den Hoven (quadsort),\n/// adapted to only use merge up and down. In contrast to the original\n/// parity_merge function, it performs 2 writes instead of 4 per iteration.\n///\n/// # Safety\n/// The caller must guarantee that `dst` is valid for v.len() writes.\n/// Also `v.as_ptr()` and `dst` must not alias and v.len() must be >= 2.\n///\n/// Note that T must be Freeze, the comparison function is evaluated on outdated\n/// temporary 'copies' that may not end up in the final array.\n// The Kani callback frame and domain restrictions above swap_if_less also apply here.\n#[safety::requires(v.len() >= 2)]\n#[safety::requires(crate::ub_checks::can_dereference(v as *const [T]))]\n#[safety::requires(crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(dst, v.len())))]\n#[safety::requires(merge_contract_regions_disjoint(v.as_ptr(), dst, v.len()))]\n#[cfg_attr(kani, crate::kani::modifies(ptr::slice_from_raw_parts_mut(dst, v.len())))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(!verify::sorting_s2_span::active::<T,F>() || (v.len() <= 32 && verify::sorting_s2_span::ordered::<T,F>(v.as_ptr(),v.len()/2) && verify::sorting_s2_span::ordered::<T,F>(v.as_ptr().wrapping_add(v.len()/2),v.len()-v.len()/2))))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::ensures(|_| !verify::sorting_s2_span::active::<T,F>() || verify::sorting_s2_span::post::<T,F>(old(verify::sorting_s2_span::capture::<T,F>(v.as_ptr(),v.len())),dst,v.len())))]\nunsafe fn bidirectional_merge<T: FreezeMarker, F: FnMut(&T, &T) -> bool>(\n    v: &[T],\n    dst: *mut T,\n    is_less: &mut F,\n) {\n    // It helps to visualize the merge:\n    //\n    // Initial:\n    //\n    //  |dst (in dst)\n    //  |left               |right\n    //  v                   v\n    // [xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]\n    //                     ^                   ^\n    //                     |left_rev           |right_rev\n    //                                         |dst_rev (in dst)\n    //\n    // After:\n    //\n    //                      |dst (in dst)\n    //        |left         |           |right\n    //        v             v           v\n    // [xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]\n    //       ^             ^           ^\n    //       |left_rev     |           |right_rev\n    //                     |dst_rev (in dst)\n    //\n    // In each iteration one of left or right moves up one position, and one of\n    // left_rev or right_rev moves down one position, whereas dst always moves\n    // up one position and dst_rev always moves down one position. Assuming\n    // the input was sorted and the comparison function is correctly implemented\n    // at the end we will have left == left_rev + 1, and right == right_rev + 1,\n    // fully consuming the input having written it to dst.\n\n    let len = v.len();\n    let src = v.as_ptr();\n\n    let len_div_2 = len / 2;\n\n    // SAFETY: The caller has to ensure that len >= 2.\n    unsafe {\n        intrinsics::assume(len_div_2 != 0); // This can avoid useless code-gen.\n    }\n\n    // SAFETY: no matter what the result of the user-provided comparison function\n    // is, all 4 read pointers will always be in-bounds. Writing `dst` and `dst_rev`\n    // will always be in bounds if the caller guarantees that `dst` is valid for\n    // `v.len()` writes.\n    unsafe {\n        let mut left = src;\n        let mut right = src.add(len_div_2);\n        let mut dst = dst;\n\n        let mut left_rev = src.add(len_div_2 - 1);\n        let mut right_rev = src.add(len - 1);\n        let mut dst_rev = dst.add(len - 1);\n\n        for _ in 0..len_div_2 {\n            (left, right, dst) = merge_up(left, right, dst, is_less);\n            (left_rev, right_rev, dst_rev) = merge_down(left_rev, right_rev, dst_rev, is_less);\n        }\n\n        let left_end = left_rev.wrapping_add(1);\n        let right_end = right_rev.wrapping_add(1);\n\n        // Odd length, so one element is left unconsumed in the input.\n        if !len.is_multiple_of(2) {\n            let left_nonempty = left < left_end;\n            let last_src = if left_nonempty { left } else { right };\n            ptr::copy_nonoverlapping(last_src, dst, 1);\n            left = left.add(left_nonempty as usize);\n            right = right.add((!left_nonempty) as usize);\n        }\n\n        // We now should have consumed the full input exactly once. This can only fail if the\n        // user-provided comparison function fails to implement a strict weak ordering. In that case\n        // we panic and never access the inconsistent state in dst.\n        if left != left_end || right != right_end {\n            panic_on_ord_violation();\n        }\n    }\n}\n\n#[cfg_attr(not(panic = \"immediate-abort\"), inline(never), cold)]\n#[cfg_attr(panic = \"immediate-abort\", inline)]\nfn panic_on_ord_violation() -> ! {\n    // This is indicative of a logic bug in the user-provided comparison function or Ord\n    // implementation. They are expected to implement a total order as explained in the Ord\n    // documentation.\n    //\n    // By panicking we inform the user, that they have a logic bug in their program. If a strict\n    // weak ordering is not given, the concept of comparison based sorting cannot yield a sorted\n    // result. E.g.: a < b < c < a\n    //\n    // The Ord documentation requires users to implement a total order. Arguably that's\n    // unnecessarily strict in the context of sorting. Issues only arise if the weaker requirement\n    // of a strict weak ordering is violated.\n    //\n    // The panic message talks about a total order because that's what the Ord documentation talks\n    // about and requires, so as to not confuse users.\n    panic!(\"user-provided comparison function does not correctly implement a total order\");\n}\n\n#[must_use]\npub(crate) const fn has_efficient_in_place_swap<T>() -> bool {\n    // Heuristic that holds true on all tested 64-bit capable architectures.\n    size_of::<T>() <= 8 // size_of::<u64>()\n}\n\n// Bounded SmallSort verification; harnesses are isolated from ordinary Rust builds.\n#[cfg(kani)]\n#[unstable(feature = \"kani\", issue = \"none\")]\nmod verify;\n",
   "library/core/src/slice/sort/shared/smallsort/verify.rs": "//! Bounded SmallSort checks for selected input domains and properties.\n//!\n//! Module map:\n//! - `network`: exchange profiles, real networks, insertion, dispatch, mutating comparators,\n//!   coincident swap positions, and the large non-Copy fallback. Sortedness checks count full\n//!   values only below the network width. Insertion lengths stop at 20, the callers'\n//!   `MAX_LEN_ALWAYS_INSERTION_SORT` threshold, rather than a limit of the insertion helper.\n//! - `merge`: stable primitives, merge, general and stable routes, and Drop counts and tags.\n//!   `merge::profiles` supplies closed ordered profiles with independent full-value models.\n//! - `fixed_inputs`: fixed witnesses and stable unit-ZST checks; `comparators` supplies their\n//!   reading comparator. `smoke` checks the efficient-swap predicate.\n//! - `types`: logical sortedness and multisets for Cell and Freeze non-Copy inputs.\n//!   `forwarding_contracts`: concrete two-element forwarding contracts for Cell, u8, and\n//!   Freeze non-Copy u8.\n//! - `tag_permutation`: identity-tag permutation and source-type dispatch predicates. Transfer to\n//!   arbitrary payloads assumes the same route moves whole elements and branches only on\n//!   answers, positions, lengths, and type properties. This source-level assumption is not a\n//!   generic refinement theorem; it excludes payload mutation, sortedness, and stability.\n//! - `scratch_geometry`: real stable u64 sorting with separate minimal scratch and\n//!   full-value counts.\n//!\n//! Real helper contract domains (comparators read both arguments and return arbitrary bools):\n//! - `helper_contracts`: swap of u8, u64, or `[u8; 17]` in four elements; u8 in nine or thirteen;\n//!   u64 insertion sort of two or three elements with any valid offset; u64 tail insertion at\n//!   positions 1 through 4 in five elements; sort4 of u64 with separate source and destination\n//!   arrays; u64 merge of two or four elements with separate output.\n//! - `helper_contracts_wide`: swap of u8 or u64 in 32 elements with an arbitrary interior base;\n//!   u64 merge of eight elements from scratch positions 32 through 39 to positions 0 through 7.\n//! - `insert_tail_contracts`: u64 tail insertion at positions 1 through 15 in\n//!   17 initialized elements.\n//! Verified swap consumers match the nine-, thirteen-, or 32-element proofs; the sort8 consumer\n//! matches the eight-element scratch merge proof. Each pair must pass with the same element\n//! type, comparator, and allocation geometry. A callback-cover hook is omitted in the smaller\n//! swap consumers because verified stubs bypass the comparator, while preserving its type.\n//!\n//! The five real helper write sets list only element or destination memory. Kani cannot express\n//! the footprint of an arbitrary `FnMut`. These contracts may be used with `stub_verified` only\n//! on the proved domains above and with comparators that write nowhere else; one successful\n//! contract proof does not justify a new consumer. The opt-in control\n//! `helper_contracts::rejects_swap_comparator_writing_outside_frame_u8` checks this restriction.\n//!\n//! `cfg(kani_smallsort_controls)` enables only negative controls; ordinary CI leaves it unset.\n//! Run controls individually and require their named failure.\n//!\n//! Conventions:\n//! - Ordinary covers must be reachable; `run-kani.sh` does not enforce this itself.\n//! - Panic stubs cut only the explicit order-violation abort path.\n//! - Fixtures supply initialized input and exclusive mutable storage; region predicates\n//!   check pointer geometry.\n//! - Closed ordered profiles guard the exact comparator and use a pure model without\n//!   invoking the callback.\n//!\n//! Not covered:\n//! - Uninitialized-memory, value-validity, and immutable-byte permission checks, or unwinding.\n//! - Under opt-in `kani_smallsort_sorting`, six real trait bodies have conditional sorting\n//!   contracts for the exact KeyLess u8/Cell/non-Copy-byte pairs. Their S1 PFC smoke is\n//!   N0..3 only; model CAP32 is not a full threshold proof or a generic T/F theorem.\n//!   They are never used as verified summaries. Ordinary roots keep their old domains.\n//! - Types, lengths, comparators, or routes beyond those listed, including aliasing, ZST,\n//!   and panic cases.\n//!\n//! `./scripts/run-kani.sh --run list` lists ordinary roots; `--run verify-std` checks them with\n//! the organizer flags, including `--no-assert-contracts`. To select a negative control, set\n//! `RUSTFLAGS=\"--cfg kani_smallsort_controls\"` and pass\n//! `--kani-args --harness <full-name> --exact` to the verification command.\n\nmod comparators;\nmod fixed_inputs;\nmod forwarding_contracts;\nmod helper_contracts;\nmod helper_contracts_wide;\nmod insert_tail_contracts;\nmod merge;\n#[cfg(kani_smallsort_controls)]\nmod mutations;\nmod network;\nmod scratch_geometry;\nmod smoke;\nmod tag_permutation;\nmod types;\n\n// S1 modules are isolated from the ordinary #752 inventory.\n#[cfg(all(kani, kani_smallsort_sorting))]\npub(super) mod sorting_model;\n#[cfg(all(kani, kani_smallsort_sorting))]\nmod sorting_entry_smoke;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_controls))]\nmod sorting_model_controls;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_controls))]\nmod sorting_entry_controls;\n\n// S2 cost experiment: every module is explicitly opt-in, separate from S1.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed))]\npub(super) mod sorting_s2_swap;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed))]\npub(super) mod sorting_s2_span;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed))]\npub(super) mod sorting_s2_batch;\n",
   "library/core/src/slice/sort/shared/smallsort/verify/helper_contracts.rs": "//! Real helper contract proofs and consumers paired on the same comparator and allocation.\n//! The reading comparator chooses each answer independently, including at equal swap positions.\n\nuse super::super::{\n    bidirectional_merge, insert_tail, insertion_sort_shift_left, sort4_stable, swap_if_less,\n};\nuse crate::kani;\n\nfn arbitrary_less<T>(a: &T, b: &T) -> bool {\n    // SAFETY: the real helper must pass initialized readable references. The proof uses Copy\n    // elements; ManuallyDrop also prevents running Drop on the temporary volatile copies.\n    unsafe {\n        let _a = crate::mem::ManuallyDrop::new(crate::ptr::read_volatile(a));\n        let _b = crate::mem::ManuallyDrop::new(crate::ptr::read_volatile(b));\n    }\n    let answer: bool = kani::any();\n    comparison_covers(answer);\n    answer\n}\n\n// A coverage-only hook lets stubbed consumers omit unreachable callback covers while retaining\n// the same arbitrary_less::<u8> function-item type as their matching ordinary PFCs.\nfn comparison_covers(answer: bool) {\n    kani::cover(answer, \"helper contract comparator true\");\n    kani::cover(!answer, \"helper contract comparator false\");\n}\n\nfn omit_comparison_covers(_answer: bool) {}\n\nfn exercise_swap<T: kani::Arbitrary + Copy + PartialEq>() {\n    let mut v: [T; 4] = kani::any();\n    let before = v;\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(a < 4 && b < 4);\n    // SAFETY: both positions are initialized, aligned, readable and writable\n    // and belong to this allocation.\n    // Equality is allowed by the real helper's safety condition.\n    unsafe { swap_if_less(v.as_mut_ptr(), a, b, &mut arbitrary_less::<T>) };\n    for i in 0..4 {\n        kani::assert(i == a || i == b || v[i] == before[i], \"helper contract swap frame\");\n    }\n    kani::cover(a == b, \"helper contract equal swap positions return\");\n    kani::cover(a < b, \"helper contract increasing swap positions return\");\n    kani::cover(a > b, \"helper contract decreasing swap positions return\");\n    kani::cover(true, \"helper contract swap returns\");\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(8)]\nfn swap_safety_u8_backing4() {\n    exercise_swap::<u8>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(8)]\nfn swap_safety_u64_backing4() {\n    exercise_swap::<u64>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(32)]\nfn swap_safety_bytes17_backing4() {\n    exercise_swap::<[u8; 17]>();\n}\n\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::stub_verified(swap_if_less)]\nfn rejects_swap_outside_backing_u8() {\n    let mut v: [u8; 4] = kani::any();\n    kani::cover(true, \"helper contract invalid swap consumer reached\");\n    // Deliberate contract violation: b == 4 is one-past-end, so it cannot be dereferenced.\n    // The verified stub must reject its requires before havoc or any real-body access.\n    unsafe { swap_if_less(v.as_mut_ptr(), 0, 4, &mut arbitrary_less::<u8>) };\n}\n\n// These lengths finish after the network: insertion starts at the end and no merge runs.\n// Each stubbed consumer needs the swap proof for its own allocation size and comparator;\n// a four-element proof is insufficient.\nfn exercise_unstable_network_u8<const N: usize>() {\n    let mut v: [u8; N] = kani::any();\n    <u8 as super::super::UnstableSmallSortTypeImpl>::small_sort(&mut v, &mut arbitrary_less::<u8>);\n    kani::cover(true, \"helper contract unstable network consumer returns\");\n}\n\n#[kani::proof]\n#[kani::stub(comparison_covers, omit_comparison_covers)]\n#[kani::stub_verified(swap_if_less)]\n#[kani::unwind(16)]\nfn unstable_network_safety_u8_n9_stubbed() {\n    exercise_unstable_network_u8::<9>();\n}\n\n#[kani::proof]\n#[kani::stub(comparison_covers, omit_comparison_covers)]\n#[kani::stub_verified(swap_if_less)]\n#[kani::unwind(16)]\nfn unstable_network_safety_u8_n13_stubbed() {\n    exercise_unstable_network_u8::<13>();\n}\n\n// Match the consumers' allocation sizes and comparator type, including coincident positions.\nfn exercise_swap_u8_backing<const N: usize>() {\n    let mut v: [u8; N] = kani::any();\n    let before = v;\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(a < N && b < N);\n    // SAFETY: both positions are initialized writable elements of this allocation.\n    unsafe { swap_if_less(v.as_mut_ptr(), a, b, &mut arbitrary_less::<u8>) };\n    for i in 0..N {\n        kani::assert(i == a || i == b || v[i] == before[i], \"helper contract swap frame\");\n    }\n    kani::cover(a == b, \"helper contract equal swap positions return\");\n    kani::cover(a < b, \"helper contract increasing swap positions return\");\n    kani::cover(a > b, \"helper contract decreasing swap positions return\");\n    kani::cover(true, \"helper contract swap returns\");\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(16)]\nfn swap_safety_u8_backing9() {\n    exercise_swap_u8_backing::<9>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(16)]\nfn swap_safety_u8_backing13() {\n    exercise_swap_u8_backing::<13>();\n}\n\n// Fixed lengths with any nonzero offset up to and including the slice length.\nfn exercise_insertion_fixed<const N: usize>() {\n    let mut v: [u64; N] = kani::any();\n    let offset: usize = kani::any();\n    kani::assume(offset != 0 && offset <= N);\n    insertion_sort_shift_left(&mut v, offset, &mut arbitrary_less::<u64>);\n    kani::cover(offset == 1, \"helper contract insertion offset one returns\");\n    kani::cover(offset == N, \"helper contract insertion final offset returns\");\n    kani::cover(offset < N, \"helper contract insertion below final offset returns\");\n    kani::cover(true, \"helper contract insertion returns\");\n}\n\n#[kani::proof_for_contract(insertion_sort_shift_left)]\n#[kani::unwind(8)]\nfn insertion_safety_u64_len2() {\n    exercise_insertion_fixed::<2>();\n}\n\n#[kani::proof_for_contract(insertion_sort_shift_left)]\n#[kani::unwind(8)]\nfn insertion_safety_u64_len3() {\n    exercise_insertion_fixed::<3>();\n}\n\n#[kani::proof_for_contract(insert_tail)]\n#[kani::unwind(16)]\nfn insert_tail_safety_u64_tail1_to4_backing5() {\n    let mut v: [u64; 5] = kani::any();\n    let before = v;\n    let tail: usize = kani::any();\n    kani::assume(1 <= tail && tail <= 4);\n    let begin = v.as_mut_ptr();\n    // SAFETY: begin < tail, and the inclusive region is initialized, readable and writable,\n    // aligned and within this one allocation. No sorted-prefix premise is needed for safety.\n    unsafe { insert_tail(begin, begin.add(tail), &mut arbitrary_less::<u64>) };\n    for i in 0..5 {\n        kani::assert(i <= tail || v[i] == before[i], \"helper contract insert_tail frame\");\n    }\n    kani::cover(tail == 1, \"helper contract insert_tail offset1 returns\");\n    kani::cover(tail == 2, \"helper contract insert_tail offset2 returns\");\n    kani::cover(tail == 3, \"helper contract insert_tail offset3 returns\");\n    kani::cover(tail == 4, \"helper contract insert_tail offset4 returns\");\n    kani::cover(true, \"helper contract insert_tail returns\");\n}\n\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::stub_verified(insert_tail)]\n#[kani::unwind(16)]\nfn rejects_insert_tail_equal_begin_u64() {\n    let mut v: [u64; 5] = kani::any();\n    let begin = v.as_mut_ptr();\n    kani::cover(true, \"helper contract invalid insert_tail consumer reached\");\n    // Deliberate contract violation: initialized pointers in one allocation, but tail == begin.\n    // The stub must fail the begin < tail requires, before any real-body access.\n    unsafe { insert_tail(begin, begin, &mut arbitrary_less::<u64>) };\n}\n\n#[kani::proof_for_contract(sort4_stable)]\n#[kani::unwind(16)]\nfn sort4_safety_u64() {\n    let src: [u64; 4] = kani::any();\n    let before = src;\n    let mut dst = crate::mem::MaybeUninit::<[u64; 4]>::uninit();\n    // SAFETY: four initialized source values and a distinct allocation writable for four\n    // destination values. The destination need not be initialized before the call.\n    unsafe { sort4_stable(src.as_ptr(), dst.as_mut_ptr().cast(), &mut arbitrary_less::<u64>) };\n    for i in 0..4 {\n        kani::assert(src[i] == before[i], \"helper contract sort4 source frame\");\n    }\n    // SAFETY: the real body writes all four output slots on every normal-return path.\n    // Read the output to exercise the initialized slots.\n    let result = unsafe { dst.assume_init() };\n    for value in &result {\n        // SAFETY: each returned output element is initialized and readable.\n        let _value = unsafe { crate::ptr::read_volatile(value) };\n    }\n    kani::cover(true, \"helper contract sort4 returns\");\n}\n\nfn cut_merge_order_violation() -> ! {\n    // Cover the explicit order-violation boundary before cutting the abort path.\n    kani::cover(true, \"helper contract merge order violation reachable\");\n    kani::assume(false);\n    unreachable!()\n}\n\nfn exercise_merge_u64<const N: usize>() {\n    let src: [u64; N] = kani::any();\n    let before = src;\n    let mut dst = crate::mem::MaybeUninit::<[u64; N]>::uninit();\n    // SAFETY: N is 2 or 4 in these PFCs; src is an initialized Freeze u64 slice,\n    // and a distinct destination allocation has space for exactly N values.\n    unsafe { bidirectional_merge(&src, dst.as_mut_ptr().cast(), &mut arbitrary_less::<u64>) };\n    for i in 0..N {\n        kani::assert(src[i] == before[i], \"helper contract merge source frame\");\n    }\n    // SAFETY: every output slot is written on normal return; inconsistent comparator\n    // paths reach the explicit panic boundary and are cut by the safety stub.\n    let result = unsafe { dst.assume_init() };\n    for value in &result {\n        // SAFETY: initialized output on normal return.\n        let _value = unsafe { crate::ptr::read_volatile(value) };\n    }\n    kani::cover(true, \"helper contract merge returns\");\n}\n\n#[kani::proof_for_contract(bidirectional_merge)]\n#[kani::stub(super::super::panic_on_ord_violation, cut_merge_order_violation)]\n#[kani::unwind(16)]\nfn merge_safety_u64_len2() {\n    exercise_merge_u64::<2>();\n}\n\n#[kani::proof_for_contract(bidirectional_merge)]\n#[kani::stub(super::super::panic_on_ord_violation, cut_merge_order_violation)]\n#[kani::unwind(16)]\nfn merge_safety_u64_len4() {\n    exercise_merge_u64::<4>();\n}\n\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::stub_verified(bidirectional_merge)]\n#[kani::unwind(16)]\nfn rejects_merge_overlapping_dst_u64() {\n    let mut backing: [u64; 4] = kani::any();\n    let base = backing.as_mut_ptr();\n    // SAFETY: source is the first two initialized values of this allocation.\n    let src = unsafe { crate::slice::from_raw_parts(base as *const u64, 2) };\n    kani::cover(true, \"helper contract overlapping merge consumer reached\");\n    // Deliberate contract violation: dst[0..2] covers backing[1..3], so it is writable\n    // and in bounds but overlaps source[0..2] at backing[1]. Only disjointness fails.\n    unsafe { bidirectional_merge(src, base.add(1), &mut arbitrary_less::<u64>) };\n}\n\n// The order is lawful; only the captured counter lies outside the helper's write set.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof_for_contract(swap_if_less)]\nfn rejects_swap_comparator_writing_outside_frame_u8() {\n    let mut v: [u8; 4] = kani::any();\n    let mut comparisons = 0u8;\n    let mut is_less = |a: &u8, b: &u8| {\n        comparisons = comparisons.wrapping_add(1);\n        *a < *b\n    };\n    // SAFETY: both positions are distinct initialized writable elements of this allocation.\n    unsafe { swap_if_less(v.as_mut_ptr(), 0, 1, &mut is_less) };\n}\n",

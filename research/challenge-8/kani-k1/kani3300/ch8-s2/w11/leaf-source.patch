+//! Prepared S2 roots, NOT_RUN. W13 owns registration and actual swap attrs.
+//! Never qualify the consumer from the old safety/frame-only swap contract.
+
+use super::super::{sort13_optimal, swap_if_less};
+use super::sorting_leaf_swap as swap_model;
+use super::sorting_model::{KeyLess, enabled, post, snapshot};
+use crate::kani;
+
+#[kani::proof_for_contract(swap_if_less)]
+#[kani::unwind(15)]
+fn s2_swap_u8_backing13() {
+    let mut values: [u8; 13] = kani::any();
+    let before = values;
+    let a: usize = kani::any();
+    let b: usize = kani::any();
+    kani::assume(a < 13 && b < 13);
+    assert!(swap_model::enabled::<u8, KeyLess<u8>>(), "S2_SWAP_MODEL_ACTIVE");
+    let pre = swap_model::capture::<u8, KeyLess<u8>>(values.as_ptr(), a, b);
+    let mut cmp = KeyLess::<u8>::new();
+    // SAFETY: both arbitrary positions are in the same initialized writable array.
+    unsafe { swap_if_less(values.as_mut_ptr(), a, b, &mut cmp) };
+    assert!(swap_model::post::<u8, KeyLess<u8>>(pre, values.as_ptr(), a, b),
+        "S2_SWAP_EXACT_TRANSFER");
+    let mut i = 0;
+    while i < 13 {
+        assert!(i == a || i == b || values[i] == before[i], "S2_SWAP_FRAME");
+        i += 1;
+    }
+    kani::cover(a == b, "S2_swap_equal_positions_return");
+    kani::cover(a < b && before[b] < before[a], "S2_swap_taken_return");
+    kani::cover(a > b && before[a] <= before[b], "S2_swap_reverse_positions_return");
+    kani::cover(a == 0 && b == 12, "S2_swap_endpoints_return");
+    kani::cover(true, "S2_swap_useful_return");
+}
+
+#[kani::proof]
+#[kani::stub_verified(swap_if_less)]
+#[kani::unwind(15)]
+fn s2_sort13_u8_verified_swap() {
+    let mut values: [u8; 13] = kani::any();
+    let input = values;
+    assert!(enabled::<u8, KeyLess<u8>>(), "S2_SORT_MODEL_ACTIVE");
+    assert!(swap_model::enabled::<u8, KeyLess<u8>>(), "S2_CONSUMER_SWAP_ACTIVE");
+    let before = snapshot::<u8, KeyLess<u8>>(&values);
+    let mut cmp = KeyLess::<u8>::new();
+    sort13_optimal(&mut values, &mut cmp);
+    assert!(post::<u8, KeyLess<u8>>(before, &values), "S2_SORT13_SORTED_FULL_COUNT");
+    kani::cover(input[0] > input[12], "S2_sort13_unsorted_input_return");
+    kani::cover(input[0] == input[12], "S2_sort13_duplicate_input_return");
+    kani::cover(values[0] < values[12], "S2_sort13_nonconstant_output_return");
+    kani::cover(true, "S2_sort13_useful_return");
+}

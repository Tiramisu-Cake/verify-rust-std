+  "library/core/src/slice/sort/shared/smallsort/verify/sorting_entry_controls.rs": "//! Legal companions and isolated CI-only false-ensures activation variants.\n//! The variants change exactly the actual method ensures, never this fixture.\n\nuse super::super::StableSmallSortTypeImpl;\nuse super::sorting_model::{KeyLess, enabled, post, snapshot};\nuse crate::cell::Cell;\nuse crate::kani;\nuse crate::mem::MaybeUninit;\n\n#[kani::proof_for_contract(<Cell<u8> as StableSmallSortTypeImpl>::small_sort)]\n#[kani::unwind(34)]\nfn stable_default_activation() {\n    let mut v = [Cell::new(2u8), Cell::new(1u8)];\n    assert!(enabled::<Cell<u8>, KeyLess<Cell<u8>>>(), \"S1_ACTUAL_DEFAULT_ENABLED\");\n    let before = snapshot::<Cell<u8>, KeyLess<Cell<u8>>>(&v);\n    let mut scratch: [MaybeUninit<Cell<u8>>; 0] = [];\n    <Cell<u8> as StableSmallSortTypeImpl>::small_sort(\n        &mut v, &mut scratch, &mut KeyLess::<Cell<u8>>::new());\n    assert!(post::<Cell<u8>, KeyLess<Cell<u8>>>(before, &v), \"S1_DEFAULT_COMPANION_POST\");\n    kani::cover(true, \"S1_actual_default_companion_return\");\n}\n\n#[kani::proof_for_contract(<u8 as StableSmallSortTypeImpl>::small_sort)]\n#[kani::unwind(34)]\nfn stable_freeze_activation() {\n    let mut v = [2u8, 1u8];\n    assert!(enabled::<u8, KeyLess<u8>>(), \"S1_ACTUAL_OVERRIDE_ENABLED\");\n    let before = snapshot::<u8, KeyLess<u8>>(&v);\n    let mut scratch: [MaybeUninit<u8>; 18] = [MaybeUninit::uninit(); 18];\n    <u8 as StableSmallSortTypeImpl>::small_sort(\n        &mut v, &mut scratch, &mut KeyLess::<u8>::new());\n    assert!(post::<u8, KeyLess<u8>>(before, &v), \"S1_OVERRIDE_COMPANION_POST\");\n    kani::cover(true, \"S1_actual_override_companion_return\");\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/sorting_s2_swap.rs": "//! S2 proposal: exact full-byte transfer for the actual swap_if_less contract.\n//! Register under kani_smallsort_sorting only after integration of the attrs in\n//! the W11 S2 INTERFACE. This module does not attach a contract by itself.\n//! Only u8/KeyLess<u8> is active here; S1's other pairs are not swap-qualified.\n\nuse super::sorting_model::KeyLess;\n\n#[derive(Clone, Copy)]\npub(in crate::slice::sort::shared::smallsort) struct PairSnapshot {\n    a: u8,\n    b: u8,\n    valid: bool,\n}\n\nimpl PairSnapshot {\n    fn invalid() -> Self { Self { a: 0, b: 0, valid: false } }\n}\n\ntrait SwapModel<T, F> {\n    fn enabled() -> bool;\n    fn capture(base: *const T, a: usize, b: usize) -> PairSnapshot;\n    fn post(pre: PairSnapshot, base: *const T, a: usize, b: usize) -> bool;\n}\n\nimpl<T, F> SwapModel<T, F> for () {\n    default fn enabled() -> bool { false }\n    default fn capture(_base: *const T, _a: usize, _b: usize) -> PairSnapshot {\n        PairSnapshot::invalid()\n    }\n    default fn post(_pre: PairSnapshot, _base: *const T, _a: usize, _b: usize) -> bool {\n        true\n    }\n}\n\nimpl SwapModel<u8, KeyLess<u8>> for () {\n    fn enabled() -> bool { true }\n    fn capture(base: *const u8, a: usize, b: usize) -> PairSnapshot {\n        // SAFETY: the actual callee's existing requires establish both initialized,\n        // readable positions, nonwrapping offsets and a common allocation first.\n        unsafe { PairSnapshot { a: *base.add(a), b: *base.add(b), valid: true } }\n    }\n    fn post(pre: PairSnapshot, base: *const u8, a: usize, b: usize) -> bool {\n        if !pre.valid { return false; }\n        let now = <() as SwapModel<u8, KeyLess<u8>>>::capture(base, a, b);\n        if pre.b < pre.a {\n            now.a == pre.b && now.b == pre.a\n        } else {\n            now.a == pre.a && now.b == pre.b\n        }\n    }\n}\n\n/// Unconditional generic facade; no new T/F bounds on the actual helper.\npub(in crate::slice::sort::shared::smallsort) fn enabled<T, F>() -> bool {\n    <() as SwapModel<T, F>>::enabled()\n}\n\n/// Spec-only read: active callers must establish the actual swap requires first.\n/// Inactive calls do not inspect pointers, indices or pointed-to bytes.\npub(in crate::slice::sort::shared::smallsort) fn capture<T, F>(\n    base: *const T, a: usize, b: usize,\n) -> PairSnapshot {\n    <() as SwapModel<T, F>>::capture(base, a, b)\n}\n\n/// Exact conditional transfer implies pair order and preservation of both full\n/// bytes, including equal positions. The actual modifies clause supplies frame.\npub(in crate::slice::sort::shared::smallsort) fn post<T, F>(\n    pre: PairSnapshot, base: *const T, a: usize, b: usize,\n) -> bool {\n    <() as SwapModel<T, F>>::post(pre, base, a, b)\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/sorting_s2_span.rs": "//! Opt-in DIAGNOSTIC_ASSUMED spec predicates; no qualified semantic leaves.\n//! Active only for u8/default KeyLess. Inactive specialization never reads storage.\nuse super::sorting_model::{self, KeyLess, Snapshot};\nuse crate::slice;\ntrait Span<T, F> {\n    fn active() -> bool;\n    fn capture(p: *const T, n: usize) -> Snapshot;\n    fn post(s: Snapshot, p: *const T, n: usize) -> bool;\n    fn ordered(p: *const T, n: usize) -> bool;\n}\nimpl<T, F> Span<T, F> for () {\n    default fn active() -> bool { false }\n    default fn capture(_p: *const T, _n: usize) -> Snapshot {\n        sorting_model::snapshot::<u8, ()>(&[])\n    }\n    default fn post(_s: Snapshot, _p: *const T, _n: usize) -> bool { true }\n    default fn ordered(_p: *const T, _n: usize) -> bool { true }\n}\nimpl Span<u8, KeyLess<u8>> for () {\n    fn active() -> bool { true }\n    fn capture(p: *const u8, n: usize) -> Snapshot {\n        if n > 32 { return sorting_model::snapshot::<u8, ()>(&[]); }\n        if n == 0 { return sorting_model::snapshot::<u8, KeyLess<u8>>(&[]); }\n        // SAFETY: requires establishes initialized readable n-span before spec read.\n        unsafe { sorting_model::snapshot::<u8, KeyLess<u8>>(slice::from_raw_parts(p, n)) }\n    }\n    fn post(s: Snapshot, p: *const u8, n: usize) -> bool {\n        if n > 32 { return false; }\n        if n == 0 { return sorting_model::post::<u8, KeyLess<u8>>(s, &[]); }\n        unsafe { sorting_model::post::<u8, KeyLess<u8>>(s, slice::from_raw_parts(p, n)) }\n    }\n    fn ordered(p: *const u8, n: usize) -> bool {\n        if n > 32 { return false; }\n        let mut i = 1;\n        while i < n {\n            if unsafe { *p.add(i) < *p.add(i - 1) } { return false; }\n            i += 1;\n        }\n        true\n    }\n}\npub(in crate::slice::sort::shared::smallsort) fn active<T, F>() -> bool {\n    <() as Span<T,F>>::active()\n}\npub(in crate::slice::sort::shared::smallsort) fn capture<T, F>(p: *const T,n: usize) -> Snapshot {\n    <() as Span<T,F>>::capture(p,n)\n}\npub(in crate::slice::sort::shared::smallsort) fn post<T, F>(s: Snapshot,p: *const T,n: usize) -> bool {\n    <() as Span<T,F>>::post(s,p,n)\n}\npub(in crate::slice::sort::shared::smallsort) fn ordered<T, F>(p: *const T,n: usize) -> bool {\n    <() as Span<T,F>>::ordered(p,n)\n}\n"
+}

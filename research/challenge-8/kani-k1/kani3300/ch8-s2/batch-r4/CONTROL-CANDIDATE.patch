index 0000000000000000000000000000000000000000..5e78a08a2b1185ee5c0e7b7dba7df69b622195d4
--- /dev/null
+++ b/ch8-s1-control/negative_oracle.py
@@ -0,0 +1,59 @@
+"""Exact negative-observation oracle helpers.
+
+This module recognizes a named assertion only after the caller has already
+bound the export to its request row and pinned source. Oracle absence is a
+closed failure; textual descriptions are never property identities.
+"""
+from __future__ import annotations
+
+from typing import Any
+
+
+def matches(harness: Any, oracle: Any) -> bool:
+    if not isinstance(harness, dict) or not isinstance(oracle, dict):
+        return False
+    selector, property_id = oracle.get("selector"), oracle.get("property_id")
+    export_file, line, prop_class = oracle.get("export_file"), oracle.get("line"), oracle.get("class")
+    if (not all(isinstance(x, str) and x for x in (selector, property_id, export_file)) or
+            not isinstance(line, int) or isinstance(line, bool) or line < 1 or
+            prop_class != "assertion"):
+        return False
+    if (harness.get("name") != selector or
+            harness.get("outcome") != {"kind": "COMPLETED", "verdict": "FAILURE"}):
+        return False
+    checks, covers, named = harness.get("checks"), harness.get("covers"), harness.get("failed_properties")
+    if not isinstance(checks, dict) or not isinstance(covers, dict) or not isinstance(named, list) or len(named) != 1:
+        return False
+    if type(harness.get("n_failed")) is not int or harness["n_failed"] != 1:
+        return False
+    if checks.get("failure") != [property_id]:
+        return False
+    for key in ("undetermined", "error", "unknown", "other"):
+        if checks.get(key) != []:
+            return False
+    unreachable = checks.get("unreachable")
+    if not isinstance(unreachable, list) or any(not isinstance(x, str) for x in unreachable):
+        return False
+    if len(set(unreachable)) != len(unreachable) or property_id in unreachable:
+        return False
+    if any(type(checks.get(k)) is not int or checks[k] < 0 for k in ("total", "success")):
+        return False
+    if checks["total"] != checks["success"] + len(unreachable) + 1:
+        return False
+    sat = covers.get("satisfied")
+    if (not isinstance(sat, list) or any(not isinstance(x, str) for x in sat) or
+            len(set(sat)) != len(sat) or type(covers.get("total")) is not int or covers["total"] != len(sat)):
+        return False
+    if any(covers.get(k) != [] for k in ("unsatisfiable", "unreachable", "undetermined", "error", "unknown", "other")):
+        return False
+    if type(harness.get("n_properties")) is not int or harness["n_properties"] != checks["total"] + covers["total"]:
+        return False
+    unsupported = harness.get("unsupported_constructs")
+    if (not isinstance(unsupported, list) or
+            any(not isinstance(p, dict) or p.get("status") != "SUCCESS" or
+                p.get("class") != "unsupported_construct" for p in unsupported)):
+        return False
+    prop = named[0]
+    return (isinstance(prop, dict) and prop.get("id") == property_id and prop.get("file") == export_file and
+            prop.get("line") == str(line) and prop.get("class") == "assertion" and
+            prop.get("status") == "FAILURE")
diff --git a/ch8-s1-control/oracle_source.py b/ch8-s1-control/oracle_source.py
new file mode 100644
index 0000000000000000000000000000000000000000..1c570dcaf31a8bbe6c3e0f5f65de5f0ba1f96169
--- /dev/null
+++ b/ch8-s1-control/oracle_source.py
@@ -0,0 +1,141 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+"""Offline source-coordinate preflight for the eight frozen S1-08 oracles.
+
+Not imported by runner/collector/admission. Source-derived spans repair only
+closure type coordinates. Existing assertion ordinals are never rediscovered
+from failures; exact runtime matching in negative_oracle.py remains unchanged.
+"""
+import hashlib
+import re
+
+SOURCE_SHA = '99e8456d200fff1299ee5756279cddb23921dc65'
+CLOSURE_COORD = re.compile(r'(?P<file>\{closure@[^{}]+?):(?P<sl>\d+):(?P<sc>\d+): (?P<el>\d+):(?P<ec>\d+)(?=\})')
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def masked(source):
+    # Preserve offsets/newlines, while preventing strings and comments from
+    # supplying syntax for the small frozen-source lexical checks below.
+    pattern = r'"(?:\\.|[^"\\])*"|//[^\n]*|/\*.*?\*/'
+    return re.sub(pattern, lambda m: ''.join('\n' if c=='\n' else ' ' for c in m[0]), source, flags=re.S)
+
+
+def balanced_end(code, start, opening='(', closing=')'):
+    assert code[start] == opening
+    depth=0
+    for i in range(start,len(code)):
+        if code[i]==opening: depth+=1
+        elif code[i]==closing:
+            depth-=1
+            if depth==0: return i+1
+    raise AssertionError('unbalanced frozen source')
+
+
+def function_body(source, name):
+    code=masked(source)
+    hits=list(re.finditer(r'(?m)^fn\s+'+re.escape(name)+r'\s*[<(]',code))
+    assert len(hits)==1, 'missing/duplicate source function'
+    lo=code.index('{',hits[0].end())
+    hi=balanced_end(code,lo,'{','}')
+    return lo,hi
+
+
+def closure_span(source, root):
+    lo,hi=function_body(source,root)
+    # These two frozen closures have explicit, one-line argument declarations.
+    # Accept no fallback shape and no ordinal/location guess on unknown syntax.
+    hits=list(re.finditer(r'\|[^|\n]*\|',masked(source)[lo:hi]))
+    assert len(hits)==1, 'expected one explicit closure argument span'
+    start=lo+hits[0].start();end=lo+hits[0].end()
+    line=source.count('\n',0,start)+1
+    line_start=source.rfind('\n',0,start)+1
+    line_end=source.find('\n',start)
+    line_text=source[line_start:line_end if line_end>=0 else len(source)]
+    assert line_text.isascii() and '\t' not in line_text, 'unsupported closure column encoding'
+    assert '\n' not in source[start:end]
+    return {'start_line':line,'start_column':start-line_start+1,
+            'end_line':line,'end_column':end-line_start+1,
+            'text':source[start:end]}
+
+
+def span_text(span):
+    return f"{span['start_line']}:{span['start_column']}: {span['end_line']}:{span['end_column']}"
+
+
+def repair_id(property_id, source, root):
+    hits=list(CLOSURE_COORD.finditer(property_id))
+    if not hits: return property_id
+    assert len(hits)==1, 'unknown multi-closure oracle shape'
+    m=hits[0];span=closure_span(source,root)
+    return property_id[:m.start('sl')]+span_text(span)+property_id[m.end('ec'):]
+
+
+def assertion_at(source, line):
+    lines=source.splitlines(keepends=True)
+    assert type(line) is int and 1<=line<=len(lines)
+    offset=sum(len(x) for x in lines[:line-1])
+    code=masked(source)
+    starts=list(re.finditer(r'assert!\s*\(',code[offset:offset+len(lines[line-1])]))
+    if starts:
+        assert len(starts)==1
+        start=offset+starts[0].start();opening=code.index('(',start)
+        end=balanced_end(code,opening)
+        return source[start:end]+';'
+    # Activation mutants are existing false ensures clauses, not Rust assert!.
+    stripped=lines[line-1].strip()
+    assert stripped.startswith('#[cfg_attr(') and 'kani::ensures(' in stripped
+    return stripped
+
+
+def validate(request, sources, baselines):
+    """Check full declared IDs against independently pinned source bytes.
+
+    sources maps (variant, repo-relative path) to exact bytes. The caller must
+    obtain actual bytes from the pinned Git tree/overlay; tests use hash-checked
+    copies of those same files. A coherent request/hash/ID shift cannot override
+    the canonical source digests in the frozen baseline manifest.
+    """
+    assert request['std_sha']==baselines['std_sha']==SOURCE_SHA, 'wrong pinned source'
+    assert request['std_tree']==baselines['std_tree'], 'wrong source tree'
+    negatives=[r for r in request['rows'] if r.get('oracle') is not None]
+    assert len(negatives)==8 and {r['id'] for r in negatives}==set(baselines['oracles']), 'negative inventory'
+    checked=[]
+    for row in negatives:
+        b=baselines['oracles'][row['id']];o=row['oracle']
+        assert row['expected']=='DETECTED' and o['class']=='assertion'
+        assert {k:v for k,v in o.items() if k!='property_id'}==b['oracle_without_id'], 'logical oracle/context drift'
+        assert row['variant']==b['variant'] and row['mode']==b['mode']
+        assert row['selector']==o['selector']==b['oracle_without_id']['selector']
+        key=(row['variant'],o['file']);data=sources[key]
+        canonical=baselines['sources'][row['variant']][o['file']]
+        assert sha(data)==o['source_sha256']==canonical, 'canonical source hash mismatch'
+        effective=request['changed_file_sha256'] if row['variant']=='production' else {
+            **request['changed_file_sha256'],**request['variants'][row['variant']]['changed_file_sha256']}
+        assert effective[o['file']]==canonical, 'source-under-test mismatch'
+        source=data.decode('utf-8');lines=source.splitlines();line=o['line']
+        assert lines[line-1]==o['source_line'], 'assertion anchor'
+        if 'assertion_context' in o:
+            assert lines[line-1:line-1+len(o['assertion_context'])]==o['assertion_context'], 'assertion context'
+        assert assertion_at(source,line)==b['assertion_text'], 'intended assertion expression/clause'
+        template=b['property_id_template']
+        if b['closure_root'] is not None:
+            assert b['closure_root']==row['selector'].rsplit('::',1)[-1]
+            span=closure_span(source,b['closure_root'])
+            expected=template.replace('{source_closure_span}',span_text(span))
+            match=list(CLOSURE_COORD.finditer(expected))
+            assert len(match)==1 and match[0]['file']=='{closure@'+o['export_file']
+        else:
+            assert '{source_closure_span}' not in template
+            expected=template;span=None
+        assert o['property_id']==expected, 'stale/wrong full oracle ID'
+        if 'proposal' in o:
+            assert o['proposal']['property']['id']==expected
+            assert o['status']=='FAILURE' and o['require_only_this_failure'] is True
+        checked.append({'row_id':row['id'],'property_id':expected,'closure_span':span,
+                        'source_sha256':canonical,'assertion_line':line,
+                        'status':'SOURCE_DERIVED_EXPECTATION_NOT_OBSERVED','sole_failure':'EXACT_MATCHER_UNCHANGED'})
+    return checked
diff --git a/ch8-s1-control/ordinary_contracts.py b/ch8-s1-control/ordinary_contracts.py
new file mode 100644
index 0000000000000000000000000000000000000000..34994ecf2e20d1a4aa3baf15804aeb7c948fc5fb
--- /dev/null
+++ b/ch8-s1-control/ordinary_contracts.py
@@ -0,0 +1,164 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+"""Bounded source preflight for ordinary stubs; no expansion/MIR/proof claim.
+
+Walk the existing active smallsort module graph, including unselected providers.
+Opaque macro bodies are conservatively scanned: every literal stub target in
+any arm must be safe. Computed/metavariable targets and unresolved identities
+fail closed. This can reject an unused macro arm, never accept an unsafe one.
+"""
+import hashlib
+from pathlib import Path
+import shlex
+import cfg_pfc as c
+import contract_stacks as cs
+
+CONTRACTS = {'requires', 'modifies', 'ensures', 'recursion', 'checked_with',
+             'replaced_with', 'asserted_with', 'recursion_check', 'modifies_wrapper',
+             'is_contract_generated', 'recursion_tracker', 'fn_marker'}
+META_FORWARDING_PINS = {'library/core/src/slice/sort/shared/smallsort/verify/network.rs': 'd59ceb99741990afcfe3f312119053a520f16c071f200953fc517a33729527bf', 'library/core/src/slice/sort/shared/smallsort/verify/merge/profiles.rs': '3a220d9fcd8269b253efaa8d7c18c13aa7a6e6f8cf59504ac2ec4c004b9abffe'}
+RELEVANT = CONTRACTS | {'stub', 'stub_verified', 'proof_for_contract', 'use_stub_set', 'stub_set'}
+
+
+def check(std, request):
+    std = Path(std)
+    flags = shlex.split(request['flags']['RUSTFLAGS'])
+    c.need(all(f.startswith('--cfg=') for f in flags), 'ordinary gate: unsupported RUSTFLAGS')
+    active = {'kani'} | {f[6:] for f in flags}
+    c.need(len(request['rows']) == 11, 'ordinary gate: expected 11 contexts')
+    known = active | {'kani_smallsort_controls', 'kani_smallsort_sorting', 'kani_smallsort_s2_assumed'}
+    hashes, modules, declarations, stubs = {}, {}, {}, []
+
+    def evaluate(attrs):
+        # Only irrelevant cfg_attr (e.g. target-dependent lint) may use unknown cfg.
+        def validate(ts):
+            if not ts or ts[0][0] not in ('cfg', 'cfg_attr'):
+                return
+            args, end = c.group(ts, 1)
+            c.need(end == len(ts), 'ordinary gate: trailing cfg syntax')
+            parts = c.split(args)
+            is_attr = ts[0][0] == 'cfg_attr'
+            if is_attr and all(p and p[0][0] in {'allow', 'warn', 'deny', 'inline', 'cold'} for p in parts[1:]):
+                return
+            guard = parts[0] if is_attr else args
+            identifiers = {t for t, _ in guard if t.isidentifier()}
+            c.need(identifiers <= known | {'all', 'any', 'not'},
+                   'ordinary gate: unknown cfg ' + c.spelling(guard))
+            if is_attr:
+                for p in parts[1:]: validate(p)
+        for a in attrs: validate(a)
+        return c.attributes(attrs, active)
+
+    def walk(rel, module):
+        path = std / rel
+        c.need(path.is_file(), 'ordinary gate: missing module ' + rel)
+        text = path.read_text()
+        hashes[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
+        inner, items = c.items(text)
+        c.need(evaluate(inner)[0], 'ordinary gate: inactive file ' + rel)
+        aliases, globs = {}, []
+        enabled_items = []
+        for item in items:
+            enabled, attrs = evaluate(item['attrs'])
+            if not enabled: continue
+            enabled_items.append((item, attrs))
+            pos = c.kind(item, 'use')
+            if pos is not None:
+                if any(t == '*' for t, _ in item['head'][pos:]):
+                    globs.append(c.spelling(item['head'][pos:])); continue
+                for alias, target in c.use_paths(item['head'][pos:]):
+                    c.need(alias not in aliases, 'ordinary gate: ambiguous alias ' + alias + ' in ' + rel)
+                    aliases[alias] = c.absolute(target, module)
+        modules[module] = {'file': rel, 'aliases': aliases, 'globs': globs}
+        for name, item, attrs in cs.declarations(text, active):
+            identity = module + name
+            c.need(identity not in declarations, 'ordinary gate: duplicate declaration ' + '::'.join(identity))
+            # Nested declarations have no active contract-relevant cfg unknown to this gate.
+            evaluate(item['attrs'])
+            declarations[identity] = {'file': rel, 'line': item['line'], 'attrs': attrs, 'module': module}
+        for item, attrs in enabled_items:
+            pos = c.kind(item, 'fn')
+            if pos is not None:
+                record_attrs(attrs, module, '::'.join(module + (item['head'][pos][0],)), rel, 'FUNCTION')
+                # No hidden body-local stubs/contract declarations accepted.
+                c.need(not list(nested_attrs(item['body'])) and not any(t in {'stub_set', 'use_stub_set'} for t, _ in item['body']),
+                       'ordinary gate: unsupported body-local annotation ' + rel + ':' + str(item['line']))
+            elif c.kind(item, 'mod') is not None:
+                name = item['head'][c.kind(item, 'mod')][0]
+                c.need(item['delimiter'] == ';', 'ordinary gate: unsupported inline module ' + rel + ':' + name)
+                parent = path.parent if path.name == 'mod.rs' else path.with_suffix('')
+                matches = [p for p in (parent/(name+'.rs'), parent/name/'mod.rs') if p.is_file()]
+                c.need(len(matches) == 1, 'ordinary gate: missing/ambiguous module ' + name)
+                walk(str(matches[0].relative_to(std)), module + (name,))
+            else:
+                # Includes macro_rules, impls and traits. Scan every literal
+                # attribute, including inactive arms, rather than guess expansion.
+                for attr in nested_attrs(item['body']):
+                    enabled, expanded = evaluate([attr])
+                    if enabled:
+                        record_attrs(expanded, module, '::'.join(module) + '::<opaque@' + str(item['line']) + '>', rel, 'CONSERVATIVE_OPAQUE_ALL_ARMS')
+
+    def nested_attrs(ts):
+        for i, (t, _) in enumerate(ts[:-1]):
+            if t == '#' and ts[i+1][0] == '[':
+                attr, _ = c.group(ts, i+1)
+                yield attr
+
+    def record_attrs(attrs, module, harness, rel, scope):
+        aliases = modules[module]['aliases']
+        for attr in attrs:
+            words = [t for t, _ in attr]
+            if '$' in words and words[0] == '$':
+                c.need(scope == 'CONSERVATIVE_OPAQUE_ALL_ARMS' and rel in META_FORWARDING_PINS
+                       and hashes[rel] == META_FORWARDING_PINS[rel],
+                       'ordinary gate: unsupported forwarded attribute ' + rel + ':' + str(attr[0][1]))
+                continue  # exact frozen macro AND invocation bytes; no injected stub attrs
+            p = words.index('(') if '(' in words else words.index('=') if '=' in words else len(words)
+            path = c.resolve(attr[:p], module, aliases)
+            op = path[-1]
+            c.need(op not in ('use_stub_set', 'stub_set'), 'ordinary gate: unsupported stub set ' + rel + ':' + str(attr[0][1]))
+            if op != 'stub': continue
+            c.need(path == ('core', 'kani', 'stub'), 'ordinary gate: unresolved stub attribute ' + c.spelling(attr))
+            args, end = c.group(attr, p)
+            parts = c.split(args)
+            c.need(end == len(attr) and len(parts) == 2, 'ordinary gate: malformed stub ' + c.spelling(attr))
+            target = c.resolve(parts[0], module, aliases)
+            stubs.append({'harness': harness, 'target': '::'.join(target),
+                          'file': rel, 'line': attr[0][1], 'scope': scope, '_target': target})
+
+    # Existing PFC gate independently checks actual ancestor activation. Here
+    # source hashing binds every module used for ordinary target declarations.
+    walk(cs.SMALLSORT, c.SM)
+    results, violations = [], []
+    for stub in stubs:
+        target = stub.pop('_target')
+        c.need(target in declarations, f"{stub['file']}:{stub['line']} ordinary gate: unresolved/foreign target {stub['target']}")
+        decl = declarations[target]
+        c.need(not modules[decl['module']]['globs'], 'ordinary gate: unsupported target-scope glob ' + stub['target'])
+        contracts = []
+        for attr in decl['attrs']:
+            words = [t for t, _ in attr]
+            p = words.index('(') if '(' in words else words.index('=') if '=' in words else len(words)
+            path = c.resolve(attr[:p], decl['module'], modules[decl['module']]['aliases'])
+            c.need(not any(t in CONTRACTS for t in words) or any(t in CONTRACTS for t in path),
+                   'ordinary gate: unsupported contract wrapper ' + c.spelling(attr))
+            if path[-1] in CONTRACTS or any(t in CONTRACTS for t in path):
+                contracts.append(c.spelling(attr))
+            else:
+                c.need(c.spelling(attr[:p]) in {'inline', 'cold', 'allow', 'warn', 'deny', 'expect', 'doc', 'track_caller'},
+                       'ordinary gate: unsupported target attribute ' + c.spelling(attr) + ' on ' + stub['target'])
+        rec = {**stub, 'target_location': {'file': decl['file'], 'line': decl['line']},
+               'active_contract_attrs': contracts, 'status': 'REJECT' if contracts else 'NO_ACTIVE_CONTRACT_ATTRS'}
+        results.append(rec)
+        if contracts:
+            violations.append(f"{stub['file']}:{stub['line']} {stub['harness']}: ordinary stub target {stub['target']} has active contract attrs at {decl['file']}:{decl['line']}: " + ';'.join(contracts))
+    c.need(not violations, '\n'.join(violations))
+    if 'ordinary_contract_source_sha256' in request:
+        c.need(hashes == request['ordinary_contract_source_sha256'], 'ordinary gate: source-hash binding drift')
+    return {'schema': 'ch8-s2-ordinary-stub-contract-map-r4-v1',
+            'source_sha': request['std_sha'], 'source_tree': request['std_tree'],
+            'source_files_sha256': hashes, 'checked_active_ordinary_uses': results,
+            'contexts': [{'row': r['id'], 'effective_cfg': sorted(active),
+                          'checked_bindings': len(results), 'status': 'NO_ACTIVE_CONTRACT_ATTRS'} for r in request['rows']],
+            'opaque_policy': 'ALL_LITERAL_TARGETS_IN_ALL_MACRO_ARMS; COMPUTED_TARGET_FAILS_CLOSED',
+            'status': 'STATIC_PASS', 'compilation': 'NOT_RUN', 'proof_credit': 'NONE'}
diff --git a/ch8-s1-control/pack_evidence.py b/ch8-s1-control/pack_evidence.py

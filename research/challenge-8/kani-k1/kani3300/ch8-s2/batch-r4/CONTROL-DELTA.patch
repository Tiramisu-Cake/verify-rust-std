);\n        swap_if_less(v_base, 6, 7, is_less);\n        swap_if_less(v_base, 8, 9, is_less);\n        swap_if_less(v_base, 3, 4, is_less);\n        swap_if_less(v_base, 5, 6, is_less);\n    }\n}\n\n// Contract-only geometry. Return zero for invalid inputs, including equal pointers, so the\n// modifies expression stays total even in a consumer that deliberately violates requires.\n#[cfg(kani)]\nfn insert_tail_contract_len<T>(begin: *mut T, tail: *mut T) -> usize {\n    let elem_size = size_of::<T>();\n    if elem_size == 0 || begin >= tail || !crate::ub_checks::same_allocation(begin, tail) {\n        return 0;\n    }\n    let Some(bytes) = (tail as usize).checked_sub(begin as usize) else {\n        return 0;\n    };\n    if bytes > isize::MAX as usize || bytes % elem_size != 0 {\n        return 0;\n    }\n    (bytes / elem_size).saturating_add(1)\n}\n\n/// Sorts range [begin, tail] assuming [begin, tail) is already sorted.\n///\n/// # Safety\n/// begin < tail and p must be valid and initialized for all begin <= p <= tail.\n// The Kani callback frame and domain restrictions above swap_if_less also apply here.\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(\n    begin < tail\n        && insert_tail_contract_len(begin, tail) > 1\n        && crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n        && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(\n    begin < tail\n        && insert_tail_contract_len(begin, tail) > 1\n        && crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n        && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n))]\n#[cfg_attr(\n    kani,\n    crate::kani::modifies(ptr::slice_from_raw_parts_mut(\n        begin,\n        insert_tail_contract_len(begin, tail)\n    ))\n)]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(!verify::sorting_s2_span::active::<T,F>() || (insert_tail_contract_len(begin,tail) >= 2 && insert_tail_contract_len(begin,tail) <= 17 && verify::sorting_s2_span::ordered::<T,F>(begin,insert_tail_contract_len(begin,tail)-1))))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::ensures(|_| !verify::sorting_s2_span::active::<T,F>() || verify::sorting_s2_span::post::<T,F>(old(verify::sorting_s2_span::capture::<T,F>(begin,insert_tail_contract_len(begin,tail))),begin,insert_tail_contract_len(begin,tail))))]\nunsafe fn insert_tail<T, F: FnMut(&T, &T) -> bool>(begin: *mut T, tail: *mut T, is_less: &mut F) {\n    // SAFETY: see individual comments.\n    unsafe {\n        // SAFETY: in-bounds as tail > begin.\n        let mut sift = tail.sub(1);\n        if !is_less(&*tail, &*sift) {\n            return;\n        }\n\n        // SAFETY: after this read tail is never read from again, as we only ever\n        // read from sift, sift < tail and we only ever decrease sift. Thus this is\n        // effectively a move, not a copy. Should a panic occur, or we have found\n        // the correct insertion position, gap_guard ensures the element is moved\n        // back into the array.\n        let tmp = ManuallyDrop::new(tail.read());\n        let mut gap_guard = CopyOnDrop { src: &*tmp, dst: tail, len: 1 };\n\n        loop {\n            // SAFETY: we move sift into the gap (which is valid), and point the\n            // gap guard destination at sift, ensuring that if a panic occurs the\n            // gap is once again filled.\n            ptr::copy_nonoverlapping(sift, gap_guard.dst, 1);\n          
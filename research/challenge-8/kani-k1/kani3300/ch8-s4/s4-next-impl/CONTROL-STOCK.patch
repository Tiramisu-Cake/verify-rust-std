+// Faithful source copies: only function names and the fault seam call differ.
+fn sort13_fault_network<T, F>(v: &mut [T], is_less: &mut F)
+where
+    F: FnMut(&T, &T) -> bool,
+{
+    if v.len() < 13 {
+        intrinsics::abort_immediate();
+    }

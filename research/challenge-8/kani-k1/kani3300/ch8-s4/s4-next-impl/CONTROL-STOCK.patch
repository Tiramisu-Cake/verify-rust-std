+  "library/core/src/slice/sort/shared/smallsort/verify/sorting_s4_network_partition.rs": "//! S4P2 exact network partitions: finite normal-return candidates, no proof credit.\n//! All 34 logical bytes are independent; initialized V34, base1, no summaries.\nuse super::super::small_sort_network;\nuse super::sorting_model::{KeyLess, enabled, snapshot, post};\nuse super::{sorting_s2_span as span, sorting_s2_swap as pair};\nuse crate::kani;\n\nfn active_u8() -> bool {\n    enabled::<u8, KeyLess<u8>>() && span::active::<u8, KeyLess<u8>>()\n        && pair::enabled::<u8, KeyLess<u8>>()\n}\nfn descending(v: &[u8]) -> bool {\n    let mut i = 1;\n    while i < v.len() {\n        if v[i - 1] <= v[i] { return false; }\n        i += 1;\n    }\n    true\n}\n\n#[kani::proof]\n#[kani::unwind(36)]\nfn s4p2_network_b01_n02_fullbyte() {\n    kani::assert(active_u8(), \"S4P2_N_02_ACTIVE_CONCRETE_MODEL\");\n    let mut v: [u8; 34] = kani::any();\n    let bytes = v;\n    let n: usize = kani::any();\n    kani::assume(2 <= n && n <= 2);\n    let before = snapshot::<u8, KeyLess<u8>>(&v[1..1 + n]);\n    small_sort_network(&mut v[1..1 + n], &mut KeyLess::<u8>::new());\n    kani::assert(post::<u8, KeyLess<u8>>(before, &v[1..1 + n]), \"S4P2_N_02_SORTED_FULL_VALUE_COUNT\");\n    for i in 0..34 {\n        kani::assert((1 <= i && i < 1 + n) || v[i] == bytes[i], \"S4P2_N_02_FULL_OUTSIDE_FRAME\");\n    }\n    let canary: usize = kani::any();\n    kani::assume(canary < 34 && (canary < 1 || canary >= 1 + n));\n    kani::assert(v[canary] == bytes[canary], \"S4P2_N_02_ARBITRARY_OUTSIDE_CANARY\");\n    kani::cover(n == 2, \"S4P2_N_02_N02\");\n    kani::cover(n >= 2 && bytes[1] > bytes[n], \"S4P2_N_02_UNSORTED\");\n    kani::cover(n >= 2 && bytes[1] == bytes[n], \"S4P2_N_02_DUPLICATE\");\n    kani::cover(n >= 2 && v[1] < v[n], \"S4P2_N_02_NONCONSTANT\");\n    kani::cover(n == 2 && descending(&bytes[1..3]), \"S4P2_N_02_MAX_DESCENDING\");\n    kani::cover(true, \"S4P2_N_02_USEFUL_RETURN\");\n}\n\n#[kani::p
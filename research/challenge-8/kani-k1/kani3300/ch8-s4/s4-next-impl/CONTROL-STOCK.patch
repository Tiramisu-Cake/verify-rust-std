n    match case {\n        0 => {\n            let mut v = [Cell::new(a), Cell::new(b)];\n            kani::cover(true, \"invalid stable comparator reaches guard\");\n            // SAFETY: valid pair and scratch; only canonical identity is deliberately rejected.\n            unsafe { stable_cell(v.as_mut_ptr(), &mut [], always_true::<Cell<u8>>, probe) };\n        }\n        1 => {\n            let mut v = [a, b];\n            kani::cover(true, \"invalid unstable comparator reaches guard\");\n            // SAFETY: valid pair; only canonical identity is deliberately rejected.\n            unsafe { unstable_byte(v.as_mut_ptr(), always_true::<u8>, probe) };\n        }\n        _ => {\n            let mut v = [NonCopyU8(a), NonCopyU8(b)];\n            kani::cover(true, \"invalid Freeze comparator reaches guard\");\n            // SAFETY: valid pair; only canonical identity is deliberately rejected.\n            unsafe { freeze_noncopy(v.as_mut_ptr(), always_true::<NonCopyU8>, probe) };\n        }\n    }\n}\n\n// Separate plain real trait execution, checked with the exact same model and count\n// as the contracts.\n// The mutation belongs only to this control, after the real entry returns, never to a wrapper.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(16)]\nfn rejects_payload_corruption() {\n    let mut v: [u8; 2] = kani::any();\n    let probe: u8 = kani::any();\n    let before = count(&v, probe);\n    let mut cmp: fn(&u8, &u8) -> bool = byte_less;\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(&mut v, &mut cmp);\n    kani::assert(sorted(&v), \"control real body sorts keys\");\n    kani::assert(before == count(&v, probe), \"control real body keeps full values\");\n    kani::cover(true, \"payload corruption reached after real trait return\");\n    v[0] ^= 1;\n    kani::assert(sorted(&v), \"corrupted payload keeps key order\");\n    kani::assert(before == count(&v, probe), \"full-value checker rejects payload corruption\");\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/helper_contracts.rs": "//! Real helper contract proofs and consumers paired on the same comparator and allocation.\n//! The reading comparator chooses each answer independently, including at equal swap positions.\n\nuse super::super::{\n    bidirectional_merge, insert_tail, insertion_sort_shift_left, sort4_stable, swap_if_less,\n};\nuse crate::kani;\n\nfn arbitrary_less<T>(a: &T, b: &T) -> bool {\n    // SAFETY: the real helper must pass initialized readable references. The proof uses Copy\n    // elements; ManuallyDrop also prevents running Drop on the temporary volatile copies.\n    unsafe {\n        let _a = crate::mem::ManuallyDrop::new(crate::ptr::read_volatile(a));\n        let _b = crate::mem::ManuallyDrop::new(crate::ptr::read_volatile(b));\n    }\n    let answer: bool = kani::any();\n    comparison_covers(answer);\n    answer\n}\n\n// A coverage-only hook lets stubbed consumers omit unreachable callback covers while retaining\n// the same arbitrary_less::<u8> function-item type as their matching ordinary PFCs.\nfn comparison_covers(answer: bool) {\n    kani::cover(answer, \"helper contract comparator true\");\n    kani::cover(!answer, \"helper contract comparator false\");\n}\n\nfn omit_comparison_covers(_answer: bool) {}\n\nfn exercise_swap<T: kani::Arbitrary + Copy + PartialEq>() {\n    let mut v: [T; 4] = kani::any();\n    let before = v;\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(a < 4 && b < 4);\n    // SAFETY: both positions are initialized, aligned, readable and writable\n    // and belong to this allocation.\n    // Equality is allowed by the real helper's safety condition.\n    unsafe { swap_if_less(v.as_mut_ptr(), a, b, &mut arbitrary_less::<T>) };\n    for i in 0..4 {\n        kani::assert(i == a || i == b || v[i] == before[i], \"helper contract swap frame\");\n    }\n    kani::cover(a == b, \"helper contract equal swap positions return\");\n    kani:
+    def source(self, expression, imports=''):
+        text=self.sources[l.BATCH]
+        if imports:
+            first, rest=text.split('\n',1);text=first+'\n'+imports+'\n'+rest
+        text=text.replace('fn sort13_weak() {', 'fn sort13_weak() { '+expression, 1)

);\n        swap_if_less(v_base, 6, 7, is_less);\n        swap_if_less(v_base, 8, 9, is_less);\n        swap_if_less(v_base, 3, 4, is_less);\n        swap_if_less(v_base, 5, 6, is_less);\n    }\n}\n\n// Contract-only geometry. Return zero for invalid inputs, including equal pointers, so the\n// modifies expression stays total even in a consumer that deliberately violates requires.\n#[cfg(kani)]\nfn insert_tail_contract_len<T>(begin: *mut T, tail: *mut T) -> usize {\n    let elem_size = size_of::<T>();\n    if elem_size == 0 || begin >= tail || !crate::ub_checks::same_allocation(begin, tail) {\n        return 0;\n    }\n    let Some(bytes) = (tail as usize).checked_sub(begin as usize) else {\n        return 0;\n    };\n    if bytes > isize::MAX as usize || bytes % elem_size != 0 {\n        return 0;\n    }\n    (bytes / elem_size).saturating_add(1)\n}\n\n/// Sorts range [begin, tail] assuming [begin, tail) is already sorted.\n///\n/// # Safety\n/// begin < tail and p must be valid and initialized for all begin <= p <= tail.\n// The Kani callback frame and domain restrictions above swap_if_less also apply here.\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(\n    begin < tail\n        && insert_tail_contract_len(begin, tail) > 1\n        && crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n        && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(\n    begin < tail\n        && insert_tail_contract_len(begin, tail) > 1\n        && crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n        && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(\n            begin,\n            insert_tail_contract_len(begin, tail),\n        ))\n))]\n#[cfg_attr(\n    kani,\n    crate::kani::modifies(ptr::slice_from_raw_parts_mut(\n        begin,\n        insert_tail_contract_len(begin, tail)\n    ))\n)]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(!verify::sorting_s2_span::active::<T,F>() || (insert_tail_contract_len(begin,tail) >= 2 && insert_tail_contract_len(begin,tail) <= 17 && verify::sorting_s2_span::ordered::<T,F>(begin,insert_tail_contract_len(begin,tail)-1))))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::ensures(|_| !verify::sorting_s2_span::active::<T,F>() || verify::sorting_s2_span::post::<T,F>(old(verify::sorting_s2_span::capture::<T,F>(begin,insert_tail_contract_len(begin,tail))),begin,insert_tail_contract_len(begin,tail))))]\nunsafe fn insert_tail<T, F: FnMut(&T, &T) -> bool>(begin: *mut T, tail: *mut T, is_less: &mut F) {\n    // SAFETY: see individual comments.\n    unsafe {\n        // SAFETY: in-bounds as tail > begin.\n        let mut sift = tail.sub(1);\n        if !is_less(&*tail, &*sift) {\n            return;\n        }\n\n        // SAFETY: after this read tail is never read from again, as we only ever\n        // read from sift, sift < tail and we only ever decrease sift. Thus this is\n        // effectively a move, not a copy. Should a panic occur, or we have found\n        // the correct insertion position, gap_guard ensures the element is moved\n        // back into the array.\n        let tmp = ManuallyDrop::new(tail.read());\n        let mut gap_guard = CopyOnDrop { src: &*tmp, dst: tail, len: 1 };\n\n        loop {\n            // SAFETY: we move sift into the gap (which is valid), and point the\n            // gap guard destination at sift, ensuring that if a panic occurs the\n            // gap is once again filled.\n            ptr::copy_nonoverlapping(sift, gap_guard.dst, 1);\n            gap_guard.dst = sift;\n\n            if sift == begin {\n                break;\n            }\n\n            // SAFETY: we checked that sift != begin, thus this is in-bounds.\n            sift = sift.sub(1);\n            if !is_less(&tmp, &*sift) {\n                break;\n            }\n        }\n    }\n}\n\n/// Sort `v` assuming `v[..offset]` is already sorted.\n// The Kani callback frame and domain restrictions above swap_if_less also apply here.\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(offset != 0 && offset <= v.len()))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(offset != 0 && offset <= v.len()))]\n#[cfg_attr(kani, crate::kani::modifies(v))]\npub fn insertion_sort_shift_left<T, F: FnMut(&T, &T) -> bool>(\n    v: &mut [T],\n    offset: usize,\n    is_less: &mut F,\n) {\n    let len = v.len();\n    if offset == 0 || offset > len {\n        intrinsics::abort_immediate();\n    }\n\n    // SAFETY: see individual comments.\n    unsafe {\n        // We write this basic loop directly using pointers, as when we use a\n        // for loop LLVM likes to unroll this loop which we do not want.\n        // SAFETY: v_end is the one-past-end pointer, and we checked that\n        // offset <= len, thus tail is also in-bounds.\n        let v_base = v.as_mut_ptr();\n        let v_end = v_base.add(len);\n        let mut tail = v_base.add(offset);\n        while tail != v_end {\n            // SAFETY: v_base and tail are both valid pointers to elements, and\n            // v_base < tail since we checked offset != 0.\n            insert_tail(v_base, tail, is_less);\n\n            // SAFETY: we checked that tail is not yet the one-past-end pointer.\n            tail = tail.add(1);\n        }\n    }\n}\n\n#[cfg(kani)]\nfn sort4_contract_regions_disjoint<T>(src: *const T, dst: *mut T) -> bool {\n    let Some(bytes) = size_of::<T>().checked_mul(4) else {\n        return false;\n    };\n    bytes == 0\n        || !crate::ub_checks::same_allocation(src, dst)\n        || (src as usize).abs_diff(dst as usize) >= bytes\n}\n\n/// SAFETY: The caller MUST guarantee that `v_base` is valid for 4 reads and\n/// `dst` is valid for 4 writes. The result will be stored in `dst[0..4]`.\n// The Kani callback frame and domain restrictions above swap_if_less also apply here.\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(\n    crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(v_base, 4))\n        && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(dst, 4))\n        && sort4_contract_regions_disjoint(v_base, dst)\n))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(\n    crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(v_base, 4))\n        && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(dst, 4))\n        && sort4_contract_regions_disjoint(v_base, dst)\n))]\n#[cfg_attr(kani, crate::kani::modifies(ptr::slice_from_raw_parts_mut(dst, 4)))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed, kani_smallsort_s3_leaf), crate::kani::ensures(|_| !verify::sorting_s2_span::active::<T,F>() || verify::sorting_s2_span::post::<T,F>(old(verify::sorting_s2_span::capture::<T,F>(v_base,4)),dst,4)))]\npub unsafe fn sort4_stable<T, F: FnMut(&T, &T) -> bool>(\n    v_base: *const T,\n    dst: *mut T,\n    is_less: &mut F,\n) {\n    // By limiting select to picking pointers, we are guaranteed good cmov code-gen\n    // regardless of type T's size. Further this only does 5 instead of 6\n    // comparisons compared to a stable transposition 4 element sorting-network,\n    // and always copies each element exactly once.\n\n    // SAFETY: all pointers have offset at most 3 from v_base and dst, and are\n    // thus in-bounds by the precondition.\n    unsafe {\n        // Stably create two pairs a <= b and c <= d.\n        let c1 = is_less(&*v_base.add(1), &*v_base);\n        let c2 = is_less(&*v_base.add(3), &*v_base.add(2));\n        let a = v_base.add(c1 as usize);\n        let b = v_base.add(!c1 as usize);\n        let c = v_base.add(2 + c2 as usize);\n        let d = v_base.add(2 + (!c2 as usize));\n\n        // Compare (a, c) and (b, d) to identify max/min. We're left with two\n        // unknown elements, but because we are a stable sort we must know which\n        // one is leftmost and which one is rightmost.\n        // c3, c4 | min max unknown_left unknown_right\n        //  0,  0 |  a   d    b         c\n        //  0,  1 |  a   b    c         d\n        //  1,  0 |  c   d    a         b\n        //  1,  1 |  c   b    a         d\n        let c3 = is_less(&*c, &*a);\n        let c4 = is_less(&*d, &*b);\n        let min = hint::select_unpredictable(c3, c, a);\n        let max = hint::select_unpredictable(c4, b, d);\n        let unknown_left = hint::select_unpredictable(c3, a, hint::select_unpredictable(c4, c, b));\n        let unknown_right = hint::select_unpredictable(c4, d, hint::select_unpredictable(c3, b, c));\n\n        // Sort the last two unknown elements.\n        let c5 = is_less(&*unknown_right, &*unknown_left);\n        let lo = hint::select_unpredictable(c5, unknown_right, unknown_left);\n        let hi = hint::select_unpredictable(c5, unknown_left, unknown_right);\n\n        ptr::copy_nonoverlapping(min, dst, 1);\n        ptr::copy_nonoverlapping(lo, dst.add(1), 1);\n        ptr::copy_nonoverlapping(hi, dst.add(2), 1);\n        ptr::copy_nonoverlapping(max, dst.add(3), 1);\n    }\n}\n\n/// SAFETY: The caller MUST guarantee that `v_base` is valid for 8 reads and\n/// writes, `scratch_base` and `dst` MUST be valid for 8 writes. The result will\n/// be stored in `dst[0..8]`.\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(crate::ub_checks::can_dereference(ptr::slice_from_raw_parts(v_base,8)) && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(dst,8)) && crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(scratch_base,8)) && merge_contract_regions_disjoint(v_base,dst,8) && merge_contract_regions_disjoint(v_base,scratch_base,8) && merge_contract_regions_disjoint(dst,scratch_base,8)))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::modifies(ptr::slice_from_raw_parts_mut(dst,8), ptr::slice_from_raw_parts_mut(scratch_base,8)))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::ensures(|_| !verify::sorting_s2_span::active::<T,F>() || verify::sorting_s2_span::post::<T,F>(old(verify::sorting_s2_span::capture::<T,F>(v_base,8)),dst,8)))]\nunsafe fn sort8_stable<T: FreezeMarker, F: FnMut(&T, &T) -> bool>(\n    v_base: *mut T,\n    dst: *mut T,\n    scratch_base: *mut T,\n    is_less: &mut F,\n) {\n    // SAFETY: these pointers are all in-bounds by the precondition of our function.\n    unsafe {\n        sort4_stable(v_base, scratch_base, is_less);\n        sort4_stable(v_base.add(4), scratch_base.add(4), is_less);\n    }\n\n    // SAFETY: scratch_base[0..8] is now initialized, allowing us to merge back\n    // into dst.\n    unsafe {\n        bidirectional_merge(slice::from_raw_parts(scratch_base, 8), dst, is_less);\n    }\n}\n\n#[inline(always)]\nunsafe fn merge_up<T, F: FnMut(&T, &T) -> bool>(\n    mut left_src: *const T,\n    mut right_src: *const T,\n    mut dst: *mut T,\n    is_less: &mut F,\n) -> (*const T, *const T, *mut T) {\n    // This is a branchless merge utility function.\n    // The equivalent code with a branch would be:\n    //\n    // if !is_less(&*right_src, &*left_src) {\n    //     ptr::copy_nonoverlapping(left_src, dst, 1);\n    //     left_src = left_src.add(1);\n    // } else {\n    //     ptr::copy_nonoverlapping(right_src, dst, 1);\n    //     right_src = right_src.add(1);\n    // }\n    // dst = dst.add(1);\n\n    // SAFETY: The caller must guarantee that `left_src`, `right_src`
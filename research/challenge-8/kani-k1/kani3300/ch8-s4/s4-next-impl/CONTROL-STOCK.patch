a for bi-directional merging by Igor van den Hoven (quadsort),\n/// adapted to only use merge up and down. In contrast to the original\n/// parity_merge function, it performs 2 writes instead of 4 per iteration.\n///\n/// # Safety\n/// The caller must guarantee that `dst` is valid for v.len() writes.\n/// Also `v.as_ptr()` and `dst` must not alias and v.len() must be >= 2.\n///\n/// Note that T must be Freeze, the comparison function is evaluated on outdated\n/// temporary 'copies' that may not end up in the final array.\n// The Kani callback frame and domain restrictions above swap_if_less also apply here.\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(v.len() >= 2))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(v.len() >= 2))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(crate::ub_checks::can_dereference(v as *const [T])))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(crate::ub_checks::can_dereference(v as *const [T])))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(dst, v.len()))))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(crate::ub_checks::can_write(ptr::slice_from_raw_parts_mut(dst, v.len()))))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(merge_contract_regions_disjoint(v.as_ptr(), dst, v.len())))]\n#[cfg_attr(not(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed)), safety::requires(merge_contract_regions_disjoint(v.as_ptr(), dst, v.len())))]\n#[cfg_attr(kani, crate::kani::modifies(ptr::slice_from_raw_parts_mut(dst, v.len())))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::requires(!verify::sorting_s2_span::active::<T,F>() || (v.len() <= 32 && verify::sorting_s2_span::ordered::<T,F>(v.as_ptr(),v.len()/2) && verify::sorting_s2_span::ordered::<T,F>(v.as_ptr().wrapping_add(v.len()/2),v.len()-v.len()/2))))]\n#[cfg_attr(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed), crate::kani::ensures(|_| !verify::sorting_s2_span::active::<T,F>() || verify::sorting_s2_span::post::<T,F>(old(verify::sorting_s2_span::capture::<T,F>(v.as_ptr(),v.len())),dst,v.len())))]\nunsafe fn bidirectional_merge<T: FreezeMarker, F: FnMut(&T, &T) -> bool>(\n    v: &[T],\n    dst: *mut T,\n    is_less: &mut F,\n) {\n    // It helps to visualize the merge:\n    //\n    // Initial:\n    //\n    //  |dst (in dst)\n    //  |left               |right\n    //  v                   v\n    // [xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]\n    //                     ^                   ^\n    //                     |left_rev           |right_rev\n    //                                         |dst_rev (in dst)\n    //\n    // After:\n    //\n    //                      |dst (in dst)\n    //        |left         |           |right\n    //        v             v           v\n    // [xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]\n    //       ^             ^           ^\n    //       |left_rev     |           |right_rev\n    //                     |dst_rev (in dst)\n    //\n    // In each iteration one of left or right moves up one position, and one of\n    // left_rev or right_rev moves down one position, whereas dst always moves\n    // up one position and dst_rev always moves down one position. Assuming\n    // the input was sorted and the comparison function is correctly implemented\n    // at the end we will have left == left_rev + 1, and right == right_rev + 1,\n    // fully consuming the input having written it to dst.\n\n    let len = v.len();\n    let src = v.as_ptr();\n\n    let len_div_2 = len / 2;\n\n    // SAFETY: The caller has to ensure that len >= 2.\n    unsafe {\n        intrinsics::assume(len_div_2 != 0); // This can avoid useless code-gen.\n    }\n\n    // SAFETY: no matter what the result of the user-provided comparison function\n    // is, all 4 read pointers will always be in-bounds. Writing `dst` and `dst_rev`\n    // will always be in bounds if the caller guarantees that `dst` is valid for\n    // `v.len()` writes.\n    unsafe {\n        let mut left = src;\n        let mut right = src.add(len_div_2);\n        let mut dst = dst;\n\n        let mut left_rev = src.add(len_div_2 - 1);\n        let mut right_rev = src.add(len - 1);\n        let mut dst_rev = dst.add(len - 1);\n\n        for _ in 0..len_div_2 {\n            (left, right, dst) = merge_up(left, right, dst, is_less);\n            (left_rev, right_rev, dst_rev) = merge_down(left_rev, right_rev, dst_rev, is_less);\n        }\n\n        let left_end = left_rev.wrapping_add(1);\n        let right_end = right_rev.wrapping_add(1);\n\n        // Odd length, so one element is left unconsumed in the input.\n        if !len.is_multiple_of(2) {\n            let left_nonempty = left < left_end;\n            let last_src = if left_nonempty { left } else { right };\n            ptr::copy_nonoverlapping(last_src, dst, 1);\n            left = left.add(left_nonempty as usize);\n            right = right.add((!left_nonempty) as usize);\n        }\n\n        // We now should have consumed the full input exactly once. This can only fail if the\n        // user-provided comparison function fails to implement a strict weak ordering. In that case\n        // we panic and never access the inconsistent state in dst.\n        if left != left_end || right != right_end {\n            panic_on_ord_violation();\n        }\n    }\n}\n\n#[cfg_attr(not(panic = \"immediate-abort\"), inline(never), cold)]\n#[cfg_attr(panic = \"immediate-abort\", inline)]\nfn panic_on_ord_violation() -> ! {\n    // This is indicative of a logic bug in the user-provided comparison function or Ord\n    // implementation. They are expected to implement a total order as explained in the Ord\n    // documentation.\n    //\n    // By panicking we inform the user, that they have a logic bug in their program. If a strict\n    // weak ordering is not given, the concept of comparison based sorting cannot yield a sorted\n    // result. E.g.: a < b < c < a\n    //\n    // The Ord documentation requires users to implement a total order. Arguably that's\n    // unnecessarily strict in the context of sorting. Issues only arise if the weaker requirement\n    // of a strict weak ordering is violated.\n    //\n    // The panic message talks about a total order because that's what the Ord documentation talks\n    // about and requires, so as to not confuse users.\n    panic!(\"user-provided comparison function does not correctly implement a total order\");\n}\n\n#[must_use]\npub(crate) const fn has_efficient_in_place_swap<T>() -> bool {\n    // Heuristic that holds true on all tested 64-bit capable architectures.\n    size_of::<T>() <= 8 // size_of::<u64>()\n}\n\n// Bounded SmallSort verification; harnesses are isolated from ordinary Rust builds.\n#[cfg(kani)]\n#[unstable(feature = \"kani\", issue = \"none\")]\nmod verify;\n",
+  "library/core/src/slice/sort/shared/smallsort/verify.rs": "//! Bounded SmallSort checks for selected input domains and properties.\n//!\n//! Module map:\n//! - `network`: exchange profiles, real networks, insertion, dispatch, mutating comparators,\n//!   coincident swap positions, and the large non-Copy fallback. Sortedness checks count full\n//!   values only below the network width. Insertion lengths stop at 20, the callers'\n//!   `MAX_LEN_ALWAYS_INSERTION_SORT` threshold, rather than a limit of the insertion helper.\n//! - `merge`: stable primitives, merge, general and stable routes, and Drop counts and tags.\n//!   `merge::profiles` supplies closed ordered profiles with independent full-value models.\n//! - `fixed_inputs`: fixed witnesses and stable unit-ZST checks; `comparators` supplies their\n//!   reading comparator. `smoke` checks the efficient-swap predicate.\n//! - `types`: logical sortedness and multisets for Cell and Freeze non-Copy inputs.\n//!   `forwarding_contracts`: concrete two-element forwarding contracts for Cell, u8, and\n//!   Freeze non-Copy u8.\n//! - `tag_permutation`: identity-tag permutation and source-type dispatch predicates. Transfer to\n//!   arbitrary payloads assumes the same route moves whole elements and branches only on\n//!   answers, positions, lengths, and type properties. This source-level assumption is not a\n//!   generic refinement theorem; it excludes payload mutation, sortedness, and stability.\n//! - `scratch_geometry`: real stable u64 sorting with separate minimal scratch and\n//!   full-value counts.\n//!\n//! Real helper contract domains (comparators read both arguments and return arbitrary bools):\n//! - `helper_contracts`: swap of u8, u64, or `[u8; 17]` in four elements; u8 in nine or thirteen;\n//!   u64 insertion sort of two or three elements with any valid offset; u64 tail insertion at\n//!   positions 1 through 4 in five elements; sort4 of u64 with separate source and destination\n//!   arrays; u64 merge of two or four elements with separate output.\n//! - `helper_contracts_wide`: swap of u8 or u64 in 32 elements with an arbitrary interior base;\n//!   u64 merge of eight elements from scratch positions 32 through 39 to positions 0 through 7.\n//! - `insert_tail_contracts`: u64 tail insertion at positions 1 through 15 in\n//!   17 initialized elements.\n//! Verified swap consumers match the nine-, thirteen-, or 32-element proofs; the sort8 consumer\n//! matches the eight-element scratch merge proof. Each pair must pass with the same element\n//! type, comparator, and allocation geometry. A callback-cover hook is omitted in the smaller\n//! swap consumers because verified stubs bypass the comparator, while preserving its type.\n//!\n//! The five real helper write sets list only element or destination memory. Kani cannot express\n//! the footprint of an arbitrary `FnMut`. These contracts may be used with `stub_verified` only\n//! on the proved domains above and with comparators that write nowhere else; one successful\n//! contract proof does not justify a new consumer. The opt-in control\n//! `helper_contracts::rejects_swap_comparator_writing_outside_frame_u8` checks this restriction.\n//!\n//! `cfg(kani_smallsort_controls)` enables only negative controls; ordinary CI leaves it unset.\n//! Run controls individually and require their named failure.\n//!\n//! Conventions:\n//! - Ordinary covers must be reachable; `run-kani.sh` does not enforce this itself.\n//! - Panic stubs cut only the explicit order-violation abort path.\n//! - Fixtures supply initialized input and exclusive mutable storage; region predicates\n//!   check pointer geometry.\n//! - Closed ordered profiles guard the exact comparator and use a pure model without\n//!   invoking the callback.\n//!\n//! Not covered:\n//! - Uninitialized-memory, value-validity, and immutable-byte permission checks, or unwinding.\n//! - Under opt-in `kani_smallsort_sorting`, six real trait bodies have conditional sorting\n//!   contracts for the exact KeyLess u8/Cell/non-Copy-byte pairs. Their S1 PFC smoke is\n//!   N0..3 only; model CAP32 is not a full threshold proof or a generic T/F theorem.\n//!   They are never used as verified summaries. Ordinary roots keep their old domains.\n//! - Types, lengths, comparators, or routes beyond those listed, including aliasing, ZST,\n//!   and panic cases.\n//!\n//! `./scripts/run-kani.sh --run list` lists ordinary roots; `--run verify-std` checks them with\n//! the organizer flags, including `--no-assert-contracts`. To select a negative control, set\n//! `RUSTFLAGS=\"--cfg kani_smallsort_controls\"` and pass\n//! `--kani-args --harness <full-name> --exact` to the verification command.\n\nmod comparators;\nmod fixed_inputs;\nmod forwarding_contracts;\nmod helper_contracts;\nmod helper_contracts_wide;\nmod insert_tail_contracts;\nmod merge;\n#[cfg(kani_smallsort_controls)]\nmod mutations;\nmod network;\nmod scratch_geometry;\nmod smoke;\nmod tag_permutation;\nmod types;\n\n// S1 modules are isolated from the ordinary #752 inventory.\n#[cfg(all(kani, kani_smallsort_sorting))]\npub(super) mod sorting_model;\n#[cfg(all(kani, kani_smallsort_sorting))]\nmod sorting_entry_smoke;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_controls))]\nmod sorting_model_controls;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_controls))]\nmod sorting_entry_controls;\n\n// S2 cost experiment: every module is explicitly opt-in, separate from S1.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed))]\npub(super) mod sorting_s2_swap;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed))]\npub(super) mod sorting_s2_span;\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed))]\npub(super) mod sorting_s2_batch;\n\n// S3 actual-body leaf candidate. No assumed consumers are selected.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed, kani_smallsort_s3_leaf))]\npub(super) mod sorting_s3_leaf;\n\n// S3-2 bounded candidates and explicitly initialization-open partial diagnostics.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed, kani_smallsort_s3_leaf))]\npub(super) mod sorting_s3_2_leaf;\n\n// Combined S3/S4 direct-helper candidates; no assumed replacement.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed, kani_smallsort_s3_leaf))]\npub(super) mod sorting_bridge1;\n\n// S4 direct full-byte length partitions; no assumed replacements.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed, kani_smallsort_s3_leaf, kani_smallsort_s4_partition))]\npub(super) mod sorting_s4_partition;\n\n// S4P2 exact network singletons and N0..1; no assumed replacements.\n#[cfg(all(kani, kani_smallsort_sorting, kani_smallsort_s2_assumed, kani_smallsort_s3_leaf, kani_smallsort_s4_partition))]\npub(super) mod sorting_s4_network_partition;\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/comparators.rs": "//! Comparator shared by bounded stable unit-ZST harnesses.\n//!\n//! Sized values use observable volatile reads. On this Kani pin, ZST `read_volatile` calls in\n//! measured in-core fixtures produced pointer-check failures whose cause is not established.\n//! ZSTs therefore use `ptr::read`; this helper does not check uninitialized reads.\n\nuse crate::mem::ManuallyDrop;\nuse crate::{kani, ptr};\n\npub(super) fn zst_aware_less<T>(a: &T, b: &T) -> bool {\n    // SAFETY: callers supply initialized readable references. ManuallyDrop prevents destruction\n    // of read copies; for a ZST the reference is non-null and aligned and no bytes are accessed.\n    unsafe {\n        if crate::mem::size_of::<T>() != 0 {\n            let _left = ManuallyDrop::new(ptr::read_volatile(a));\n            let _right = ManuallyDrop::new(ptr::read_volatile(b));\n        } else {\n            let _left = ManuallyDrop::new(ptr::read(a));\n            let _right = ManuallyDrop::new(ptr::read(b));\n        }\n    }\n    kani::any()\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/fixed_inputs.rs": "//! Fixed witnesses, a mutant swap control, and stable unit-ZST checks.\n\nuse super::super::{\n    StableSmallSortTypeImpl, bidirectional_merge, insert_tail, merge_up, small_sort_network,\n    swap_if_less,\n};\nuse crate::mem::MaybeUninit;\nuse crate::{kani, ptr};\n\nfn strict_less(a: &u8, b: &u8) -> bool {\n    // SAFETY: both arguments must be initialized and readable before comparison.\n    unsafe { ptr::read_volatile(a) < ptr::read_volatile(b) }\n}\n\nfn cut_ord_violation() -> ! {\n    // The panic stub cuts only the explicit order-violation path; normal returns are covered below.\n    kani::assume(false);\n    unreachable!()\n}\n\nfn check_swap(call: impl FnOnce(&mut [u8; 2])) {\n    let mut v: [u8; 2] = kani::any();\n    let before = v;\n    call(&mut v);\n    assert!(v[0] <= v[1]);\n    assert!((v == before) || (v == [before[1], before[0]]));\n    kani::cover(true, \"swap returns a sorted permutation\");\n}\n\nfn check_insert(call: impl FnOnce(&mut [u8; 2])) {\n    let mut v: [u8; 2] = kani::any();\n    let before = v;\n    call(&mut v);\n    assert!(v[0] <= v[1]);\n    assert!((v == before) || (v == [before[1], before[0]]));\n    kani::cover(true, \"insertion returns a sorted permutation\");\n}\n\nfn check_merge_up(\n    call: impl FnOnce(*const u8, *const u8, *mut u8) -> (*const u8, *const u8, *mut u8),\n) {\n    let src: [u8; 2] = kani::any();\n    let left = src.as_ptr();\n    // SAFETY: second element in src.\n    let right = unsafe { left.add(1) };\n    let mut dst = MaybeUninit::<u8>::uninit();\n    let out = dst.as_mut_ptr();\n    let (next_left, next_right, next_dst) = call(left, right, out);\n    let take_left = src[0] <= src[1];\n    // SAFETY: these expected pointers are at most one-past the source and destination arrays.\n    let advancement_ok = unsafe {\n        next_left == left.add(take_left as usize)\n            && next_right == right.add((!take_left) as usize)\n            && next_dst == out.add(1)\n    };\n    assert!(advancement_ok);\n    // SAFETY: merge_up wrote exactly one element.\n    let value = unsafe { dst.assume_init() };\n    assert!(value == if take_left { src[0] } else { src[1] });\n    kani::cover(take_left, \"forward merge consumes left\");\n    kani::cover(!take_left, \"forward merge consumes right\");\n}\n\nfn count(v: &[u8; 4], probe: u8) -> usize {\n    (v[0] == probe) as usize\n        + (v[1] == probe) as usize\n        + (v[2] == probe) as usize\n        + (v[3] == probe) as usize\n}\n\nfn arbitrary_less(a: &u8, b: &u8) -> bool {\n    // SAFETY: both comparator arguments must be initialized and readable.\n    unsafe {\n        let _left = ptr::read_volatile(a);\n        let _right = ptr::read_volatile(b);\n    }\n    kani::any()\n}\n\nfn check_merge_consumption(call: impl FnOnce(&[u8; 4], *mut u8)) {\n    let src: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut dst = MaybeUninit::<[u8; 4]>::uninit();\n    call(&src, dst.as_mut_ptr().cast());\n    // SAFETY: both merge directions wrote two output elements on normal return.\n    let result = unsafe { dst.assume_init() };\n    assert!(count(&src, probe) == count(&result, probe));\n    kani::cover(true, \"merge preserves the probe count on normal return\");\n}\n\nfn check_presorted_len(call: impl FnOnce(&mut [u8; 10])) {\n    // Sorted prefix of nine; the tenth zero must move to the front.\n    let mut v = [1u8, 1, 1, 1, 1, 1, 1, 1, 1, 0];\n    call(&mut v);\n    assert!(v[0] == 0 && v[9] == 1);\n    kani::cover(true, \"network inserts the tenth element\");\n}\n\nmacro_rules! original_case {\n    ($positive:ident, $check:ident, $original:expr) => {\n        #[kani::proof]\n        #[kani::unwind(17)]\n        #[kani::stub(super::super::panic_on_ord_violation, cut_ord_violation)]\n        fn $positive() {\n            $check($original);\n        }\n    };\n}\n\n// The shared helpers establish each call's valid pointers, initialized values, and region lengths.\noriginal_case!(\n    sorted_permutation_swap_u8_n2,\n    check_swap,\n    // SAFETY: two distinct initialized elements in the same two-element array.\n    |v: &mut [u8; 2]| unsafe { swap_if_less(v.as_mut_ptr(), 0, 1, &mut strict_less) }\n);\noriginal_case!(\n    sorted_permutation_insert_tail_u8_n2,\n    check_insert,\n    // SAFETY: sorted one-element prefix and initialized tail in the same array.\n    |v: &mut [u8; 2]| unsafe {\n        insert_tail(v.as_mut_ptr(), v.as_mut_ptr().add(1), &mut strict_less)\n    }\n);\noriginal_case!(\n    advancement_merge_up_u8_n2,\n    check_merge_up,\n    // SAFETY: helper supplies two readable elements and a separate writable destination.\n    |l, r, d| unsafe { merge_up(l, r, d, &mut strict_less) }\n);\noriginal_case!(\n    permutation_merge_u8_n4,\n    check_merge_consumption,\n    // SAFETY: helper supplies four initialized inputs and a separate four-element destination.\n    |v: &[u8; 4], d| unsafe { bidirectional_merge(v, d, &mut arbitrary_less) }\n);\noriginal_case!(\n    sorted_network_prefix_u8_n10,\n    check_presorted_len,\n    // Safe entry: the exact ten-element array supplies the network length.\n    |v: &mut [u8; 10]| small_sort_network(v, &mut strict_less)\n);\n\n// Opt-in negative control: the swap check above, run on a copy that negates the exchange decision.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(17)]\n#[kani::stub(super::super::panic_on_ord_violation, cut_ord_violation)]\nfn reject_mutant_swap_u8_n2() {\n    // SAFETY: two distinct initialized elements in the same two-element array.\n    check_swap(|v: &mut [u8; 2]| unsafe {\n        super::mutations::mutant_swap_if_less(v.as_mut_ptr(), 0, 1, &mut strict_less)\n    });\n}\n\n// The unwind budget allows the longest selected stable route despite zero-sized elements.\nmacro_rules! stable_unit_case {\n    ($name:ident, $n:literal) => {\n        #[kani::proof]\n        #[kani::unwind(65)]\n        #[kani::stub(super::super::panic_on_ord_violation, cut_ord_violation)]\n        fn $name() {\n            let mut v = [(); $n];\n            let mut scratch = [MaybeUninit::<()>::uninit(); 48];\n            <() as StableSmallSortTypeImpl>::small_sort(\n                &mut v,\n                &mut scratch,\n                &mut super::comparators::zst_aware_less::<()>,\n            );\n            kani::cover(true, concat!(\"stable unit sort returns at length \", stringify!($n)));\n        }\n    };\n}\n\nstable_unit_case!(safety_stable_unit_n1, 1);\nstable_unit_case!(safety_stable_unit_n2, 2);\nstable_unit_case!(safety_stable_unit_n7, 7);\nstable_unit_case!(safety_stable_unit_n8, 8);\nstable_unit_case!(safety_stable_unit_n16, 16);\nstable_unit_case!(safety_stable_unit_n17, 17);\nstable_unit_case!(safety_stable_unit_n31, 31);\nstable_unit_case!(safety_stable_unit_n32, 32);\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/forwarding_contracts.rs": "//! Concrete checked N2 forwarding contracts, executing the real trait entries without stubs.\n//! The model is the full byte; order uses its upper seven bits. An independent by-value probe\n//! is shared by the scalar pre-count and post-count. No specification calls the comparator.\n\nuse super::super::{\n    StableSmallSortTypeImpl, UnstableSmallSortFreezeTypeImpl, UnstableSmallSortTypeImpl,\n};\nuse crate::cell::Cell;\nuse crate::mem::MaybeUninit;\nuse crate::ub_checks::{can_dereference, can_write, same_allocation};\nuse crate::{kani, ptr, slice};\n\n/// Freeze, one byte, neither Copy nor Drop: selects the default Freeze general implementation.\n#[repr(transparent)]\nstruct NonCopyU8(u8);\n\n// Closed to this proof module; these projections preserve each type's complete logical value.\ntrait Model {\n    fn model(&self) -> u8;\n}\n\nimpl Model for u8 {\n    fn model(&self) -> u8 {\n        *self\n    }\n}\n\nimpl Model for Cell<u8> {\n    fn model(&self) -> u8 {\n        self.get()\n    }\n}\n\nimpl Model for NonCopyU8 {\n    fn model(&self) -> u8 {\n        self.0\n    }\n}\n\nfn cell_less(a: &Cell<u8>, b: &Cell<u8>) -> bool {\n    (a.get() >> 1) < (b.get() >> 1)\n}\n\nfn byte_less(a: &u8, b: &u8) -> bool {\n    (*a >> 1) < (*b >> 1)\n}\n\nfn noncopy_less(a: &NonCopyU8, b: &NonCopyU8) -> bool {\n    (a.0 >> 1) < (b.0 >> 1)\n}\n\n// Same direct address comparison as the `merge::profiles` profile guard.\nfn canonical<T>(cmp: fn(&T, &T) -> bool, expected: fn(&T, &T) -> bool) -> bool {\n    cmp as *const () == expected as *const ()\n}\n\n// Keep the literal in a single location for the negative control's exact expect_check.\n// Return false after a rejected guard, so even that path cannot forward an unlawful callback.\nfn canonical_guard(ok: bool) -> bool {\n    kani::assert(ok, \"canonical comparator required\");\n    ok\n}\n\n// Geometry only: initialization and exclusive mutable storage come from the harness fixtures.\nfn pair_region<T>(v: *mut T) -> bool {\n    can_dereference(ptr::slice_from_raw_parts(v, 2))\n        && can_write(ptr::slice_from_raw_parts_mut(v, 2))\n}\n\n// The geometry requires disjoint input and scratch spans; fixture borrows supply exclusivity.\nfn stable_region(v: *mut Cell<u8>, scratch: &[MaybeUninit<Cell<u8>>]) -> bool {\n    pair_region(v)\n        && (scratch.is_empty()\n            || !same_allocation(v as *const Cell<u8>, scratch.as_ptr().cast::<Cell<u8>>())\n            || {\n                // SAFETY: both nonempty regions are live and in the same allocation.\n                // MaybeUninit<Cell<u8>> and Cell<u8> have identical size and alignment.\n                let d = unsafe { scratch.as_ptr().cast::<Cell<u8>>().offset_from(v) };\n                if d >= 0 { d as usize >= 2 } else { d.unsigned_abs() >= scratch.len() }\n            })\n}\n\n// Both helpers read only the two initialized input elements, never any scratch or uninit tail.\nfn sorted<T: Model>(v: &[T]) -> bool {\n    (v[0].model() >> 1) <= (v[1].model() >> 1)\n}\n\nfn count<T: Model>(v: &[T], probe: u8) -> usize {\n    (v[0].model() == probe) as usize + (v[1].model() == probe) as usize\n}\n\n// Raw pair arguments avoid conflicting generated captures of an &mut slice in the contract\n// macros. The raw span is always exactly N2; these adapters use the same pure checker as the\n// corruption control. Only the scalar count is captured in old().\nfn pair_sorted<T: Model>(v: *const T) -> bool {\n    // SAFETY: fixture initialization supplies two values; the requires check their span geometry.\n    sorted(unsafe { slice::from_raw_parts(v, 2) })\n}\n\nfn pair_count<T: Model>(v: *const T, probe: u8) -> usize {\n    // SAFETY: fixture initialization supplies two values; the requires check their span geometry.\n    count(unsafe { slice::from_raw_parts(v, 2) }, probe)\n}\n\n// Cell is !Freeze: the default Stable entry ignores scratch and runs insertion from index 1.\n// Only the input slice is writable in the frame; even initialized caller scratch is untouched.\n#[kani::requires(stable_region(v, scratch))]\n#[kani::requires(canonical(cmp, cell_less))]\n#[kani::modifies(ptr::slice_from_raw_parts_mut(v, 2))]\n#[kani::ensures(|_| pair_sorted(v))]\n#[kani::ensures(|_| old(pair_count(v, probe)) == pair_count(v, probe))]\nunsafe fn stable_cell(\n    v: *mut Cell<u8>,\n    scratch: &mut [MaybeUninit<Cell<u8>>],\n    cmp: fn(&Cell<u8>, &Cell<u8>) -> bool,\n    probe: u8,\n) {\n    if !canonical_guard(canonical(cmp, cell_less)) {\n        return;\n    }\n    // SAFETY: initialized exclusive fixture storage; the requires check the two-element geometry.\n    let v = unsafe { slice::from_raw_parts_mut(v, 2) };\n    let mut is_less = cmp;\n    <Cell<u8> as StableSmallSortTypeImpl>::small_sort(v, scratch, &mut is_less);\n}\n\n// u8 is Freeze + Copy and has efficient swap: network route, insertion only at N2.\n#[kani::requires(pair_region(v))]\n#[kani::requires(canonical(cmp, byte_less))]\n#[kani::modifies(ptr::slice_from_raw_parts_mut(v, 2))]\n#[kani::ensures(|_| pair_sorted(v))]\n#[kani::ensures(|_| old(pair_count(v, probe)) == pair_count(v, probe))]\nunsafe fn unstable_byte(v: *mut u8, cmp: fn(&u8, &u8) -> bool, probe: u8) {\n    if !canonical_guard(canonical(cmp, byte_less)) {\n        return;\n    }\n    // SAFETY: initialized exclusive fixture storage; the requires check the two-element geometry.\n    let v = unsafe { slice::from_raw_parts_mut(v, 2) };\n    let mut is_less = cmp;\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(v, &mut is_less);\n}\n\n// NonCopyU8 is Freeze but !Copy; 1 * 48 <= 4096 selects general, with private local scratch.\n// At N2 general copies two singleton halves, merges into v and forgets the panic copy-back guard.\n#[kani::requires(pair_region(v))]\n#[kani::requires(canonical(cmp, noncopy_less))]\n#[kani::modifies(ptr::slice_from_raw_parts_mut(v, 2))]\n#[kani::ensures(|_| pair_sorted(v))]\n#[kani::ensures(|_| old(pair_count(v, probe)) == pair_count(v, probe))]\nunsafe fn freeze_noncopy(v: *mut NonCopyU8, cmp: fn(&NonCopyU8, &NonCopyU8) -> bool, probe: u8) {\n    if !canonical_guard(canonical(cmp, noncopy_less)) {\n        return;\n    }\n    // SAFETY: initialized exclusive fixture storage; the requires check the two-element geometry.\n    let v = unsafe { slice::from_raw_parts_mut(v, 2) };\n    let mut is_less = cmp;\n    <NonCopyU8 as UnstableSmallSortFreezeTypeImpl>::small_sort(v, &mut is_less);\n}\n\nfn input_covers(a: u8, b: u8, probe: u8) {\n    kani::cover((a >> 1) > (b >> 1), \"reversed keys return\");\n    kani::cover((a >> 1) < (b >> 1), \"increasing keys return\");\n    kani::cover(a != b && (a >> 1) == (b >> 1), \"tied keys retain distinct full values\");\n    kani::cover(a == b, \"duplicate full values return\");\n    kani::cover(probe == a || probe == b, \"independent probe hits input\");\n    kani::cover(probe != a && probe != b, \"independent probe misses input\");\n}\n\n#[kani::proof_for_contract(stable_cell)]\n#[kani::unwind(16)]\nfn stable_cell_n2() {\n    let [left, a, b, right]: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut v = [Cell::new(left), Cell::new(a), Cell::new(b), Cell::new(right)];\n    let mut scratch = [MaybeUninit::new(Cell::new(kani::any())), MaybeUninit::uninit()];\n    let scratch_len: usize = kani::any_where(|n: &usize| *n <= 2);\n    // SAFETY: this slot was initialized above; Cell has no padding and get reads its full value.\n    let scratch_before = unsafe { scratch[0].assume_init_ref() }.get();\n    // SAFETY: active pair in initialized backing4; separate valid scratch; canonical pointer.\n    unsafe { stable_cell(v[1..3].as_mut_ptr(), &mut scratch[..scratch_len], cell_less, probe) };\n    kani::assert(v[0].get() == left && v[3].get() == right, \"stable input frame\");\n    // SAFETY: the default Cell route does not write scratch; only the input may be modified.\n    let scratch_after = unsafe { scratch[0].assume_init_ref() }.get();\n    kani::assert(scratch_before == scratch_after, \"stable scratch frame\");\n    kani::cover(scratch_len == 0, \"stable empty scratch returns\");\n    kani::cover(scratch_len == 2, \"stable unread uninit scratch tail returns\");\n    input_covers(a, b, probe);\n    kani::cover(true, \"stable Cell trait entry returns\");\n}\n\n#[kani::proof_for_contract(unstable_byte)]\n#[kani::unwind(16)]\nfn unstable_byte_n2() {\n    let [left, a, b, right]: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut v = [left, a, b, right];\n    // SAFETY: active pair in initialized backing4; canonical pointer.\n    unsafe { unstable_byte(v[1..3].as_mut_ptr(), byte_less, probe) };\n    kani::assert(v[0] == left && v[3] == right, \"unstable input frame\");\n    input_covers(a, b, probe);\n    kani::cover(true, \"unstable u8 trait entry returns\");\n}\n\n#[kani::proof_for_contract(freeze_noncopy)]\n#[kani::unwind(16)]\nfn freeze_noncopy_n2() {\n    let [left, a, b, right]: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut v = [NonCopyU8(left), NonCopyU8(a), NonCopyU8(b), NonCopyU8(right)];\n    // SAFETY: active pair in initialized backing4; canonical pointer.\n    unsafe { freeze_noncopy(v[1..3].as_mut_ptr(), noncopy_less, probe) };\n    kani::assert(v[0].0 == left && v[3].0 == right, \"Freeze input frame\");\n    input_covers(a, b, probe);\n    kani::cover(true, \"Freeze NonCopyU8 trait entry returns\");\n}\n\n#[cfg(kani_smallsort_controls)]\nfn always_true<T>(_: &T, _: &T) -> bool {\n    true\n}\n\n// Opt-in control, plain real-body calls: no PFC assumption or summary hides a bad fn pointer.\n// One nondeterministic branch per wrapper; the common literal guard must be the only failure.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(16)]\nfn rejects_always_true() {\n    let [a, b]: [u8; 2] = kani::any();\n    let probe: u8 = kani::any();\n    let case: u8 = kani::any_where(|c: &u8| *c < 3);\n    match case {\n        0 => {\n            let mut v = [Cell::new(a), Cell::new(b)];\n            kani::cover(true, \"invalid stable comparator reaches guard\");\n            // SAFETY: valid pair and scratch; only canonical identity is deliberately rejected.\n            unsafe { stable_cell(v.as_mut_ptr(), &mut [], always_true::<Cell<u8>>, probe) };\n        }\n        1 => {\n            let mut v = [a, b];\n            kani::cover(true, \"invalid unstable comparator reaches guard\");\n            // SAFETY: valid pair; only canonical identity is deliberately rejected.\n            unsafe { unstable_byte(v.as_mut_ptr(), always_true::<u8>, probe) };\n        }\n        _ => {\n            let mut v = [NonCopyU8(a), NonCopyU8(b)];\n            kani::cover(true, \"invalid Freeze comparator reaches guard\");\n            // SAFETY: valid pair; only canonical identity is deliberately rejected.\n            unsafe { freeze_noncopy(v.as_mut_ptr(), always_true::<NonCopyU8>, probe) };\n        }\n    }\n}\n\n// Separate plain real trait execution, checked with the exact same model and count\n// as the contracts.\n// The mutation belongs only to this control, after the real entry returns, never to a wrapper.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(16)]\nfn rejects_payload_corruption() {\n    let mut v: [u8; 2] = kani::any();\n    let probe: u8 = kani::any();\n    let before = count(&v, probe);\n    let mut cmp: fn(&u8, &u8) -> bool = byte_less;\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(&mut v, &mut cmp);\n    kani::assert(sorted(&v), \"control real body sorts keys\");\n    kani::assert(before == count(&v, probe), \"control real body keeps full values\");\n    kani::cover(true, \"payload corruption reached after real trait return\");\n    v[0] ^= 1;\n    kani::assert(sorted(&v), \"corrupted payload keeps key order\");\n    kani::assert(before == count(&v, probe), \"full-value checker rejects payload corruption\");\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/helper_contracts.rs": "//! Real helper contract proofs and consumers paired on the same comparator and allocation.\n//! The reading comparator chooses each answer independently, including at equal swap positions.\n\nuse super::super::{\n    bidirectional_merge, insert_tail, insertion_sort_shift_left, sort4_stable, swap_if_less,\n};\nuse crate::kani;\n\nfn arbitrary_less<T>(a: &T, b: &T) -> bool {\n    // SAFETY: the real helper must pass initialized readable references. The proof uses Copy\n    // elements; ManuallyDrop also prevents running Drop on the temporary volatile copies.\n    unsafe {\n        let _a = crate::mem::ManuallyDrop::new(crate::ptr::read_volatile(a));\n        let _b = crate::mem::ManuallyDrop::new(crate::ptr::read_volatile(b));\n    }\n    let answer: bool = kani::any();\n    comparison_covers(answer);\n    answer\n}\n\n// A coverage-only hook lets stubbed consumers omit unreachable callback covers while retaining\n// the same arbitrary_less::<u8> function-item type as their matching ordinary PFCs.\nfn comparison_covers(answer: bool) {\n    kani::cover(answer, \"helper contract comparator true\");\n    kani::cover(!answer, \"helper contract comparator false\");\n}\n\nfn omit_comparison_covers(_answer: bool) {}\n\nfn exercise_swap<T: kani::Arbitrary + Copy + PartialEq>() {\n    let mut v: [T; 4] = kani::any();\n    let before = v;\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(a < 4 && b < 4);\n    // SAFETY: both positions are initialized, aligned, readable and writable\n    // and belong to this allocation.\n    // Equality is allowed by the real helper's safety condition.\n    unsafe { swap_if_less(v.as_mut_ptr(), a, b, &mut arbitrary_less::<T>) };\n    for i in 0..4 {\n        kani::assert(i == a || i == b || v[i] == before[i], \"helper contract swap frame\");\n    }\n    kani::cover(a == b, \"helper contract equal swap positions return\");\n    kani::cover(a < b, \"helper contract increasing swap positions return\");\n    kani::cover(a > b, \"helper contract decreasing swap positions return\");\n    kani::cover(true, \"helper contract swap returns\");\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(8)]\nfn swap_safety_u8_backing4() {\n    exercise_swap::<u8>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(8)]\nfn swap_safety_u64_backing4() {\n    exercise_swap::<u64>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(32)]\nfn swap_safety_bytes17_backing4() {\n    exercise_swap::<[u8; 17]>();\n}\n\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::stub_verified(swap_if_less)]\nfn rejects_swap_outside_backing_u8() {\n    let mut v: [u8; 4] = kani::any();\n    kani::cover(true, \"helper contract invalid swap consumer reached\");\n    // Deliberate contract violation: b == 4 is one-past-end, so it cannot be dereferenced.\n    // The verified stub must reject its requires before havoc or any real-body access.\n    unsafe { swap_if_less(v.as_mut_ptr(), 0, 4, &mut arbitrary_less::<u8>) };\n}\n\n// These lengths finish after the network: insertion starts at the end and no merge runs.\n// Each stubbed consumer needs the swap proof for its own allocation size and comparator;\n// a four-element proof is insufficient.\nfn exercise_unstable_network_u8<const N: usize>() {\n    let mut v: [u8; N] = kani::any();\n    <u8 as super::super::UnstableSmallSortTypeImpl>::small_sort(&mut v, &mut arbitrary_less::<u8>);\n    kani::cover(true, \"helper contract unstable network consumer returns\");\n}\n\n#[kani::proof]\n#[kani::stub(comparison_covers, omit_comparison_covers)]\n#[kani::stub_verified(swap_if_less)]\n#[kani::unwind(16)]\nfn unstable_network_safety_u8_n9_stubbed() {\n    exercise_unstable_network_u8::<9>();\n}\n\n#[kani::proof]\n#[kani::stub(comparison_covers, omit_comparison_covers)]\n#[kani::stub_verified(swap_if_less)]\n#[kani::unwind(16)]\nfn unstable_network_safety_u8_n13_stubbed() {\n    exercise_unstable_network_u8::<13>();\n}\n\n// Match the consumers' allocation sizes and comparator type, including coincident positions.\nfn exercise_swap_u8_backing<const N: usize>() {\n    let mut v: [u8; N] = kani::any();\n    let before = v;\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(a < N && b < N);\n    // SAFETY: both positions are initialized writable elements of this allocation.\n    unsafe { swap_if_less(v.as_mut_ptr(), a, b, &mut arbitrary_less::<u8>) };\n    for i in 0..N {\n        kani::assert(i == a || i == b || v[i] == before[i], \"helper contract swap frame\");\n    }\n    kani::cover(a == b, \"helper contract equal swap positions return\");\n    kani::cover(a < b, \"helper contract increasing swap positions return\");\n    kani::cover(a > b, \"helper contract decreasing swap positions return\");\n    kani::cover(true, \"helper contract swap returns\");\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(16)]\nfn swap_safety_u8_backing9() {\n    exercise_swap_u8_backing::<9>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(16)]\nfn swap_safety_u8_backing13() {\n    exercise_swap_u8_backing::<13>();\n}\n\n// Fixed lengths with any nonzero offset up to and including the slice length.\nfn exercise_insertion_fixed<const N: usize>() {\n    let mut v: [u64; N] = kani::any();\n    let offset: usize = kani::any();\n    kani::assume(offset != 0 && offset <= N);\n    insertion_sort_shift_left(&mut v, offset, &mut arbitrary_less::<u64>);\n    kani::cover(offset == 1, \"helper contract insertion offset one returns\");\n    kani::cover(offset == N, \"helper contract insertion final offset returns\");\n    kani::cover(offset < N, \"helper contract insertion below final offset returns\");\n    kani::cover(true, \"helper contract insertion returns\");\n}\n\n#[kani::proof_for_contract(insertion_sort_shift_left)]\n#[kani::unwind(8)]\nfn insertion_safety_u64_len2() {\n    exercise_insertion_fixed::<2>();\n}\n\n#[kani::proof_for_contract(insertion_sort_shift_left)]\n#[kani::unwind(8)]\nfn insertion_safety_u64_len3() {\n    exercise_insertion_fixed::<3>();\n}\n\n#[kani::proof_for_contract(insert_tail)]\n#[kani::unwind(16)]\nfn insert_tail_safety_u64_tail1_to4_backing5() {\n    let mut v: [u64; 5] = kani::any();\n    let before = v;\n    let tail: usize = kani::any();\n    kani::assume(1 <= tail && tail <= 4);\n    let begin = v.as_mut_ptr();\n    // SAFETY: begin < tail, and the inclusive region is initialized, readable and writable,\n    // aligned and within this one allocation. No sorted-prefix premise is needed for safety.\n    unsafe { insert_tail(begin, begin.add(tail), &mut arbitrary_less::<u64>) };\n    for i in 0..5 {\n        kani::assert(i <= tail || v[i] == before[i], \"helper contract insert_tail frame\");\n    }\n    kani::cover(tail == 1, \"helper contract insert_tail offset1 returns\");\n    kani::cover(tail == 2, \"helper contract insert_tail offset2 returns\");\n    kani::cover(tail == 3, \"helper contract insert_tail offset3 returns\");\n    kani::cover(tail == 4, \"helper contract insert_tail offset4 returns\");\n    kani::cover(true, \"helper contract insert_tail returns\");\n}\n\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::stub_verified(insert_tail)]\n#[kani::unwind(16)]\nfn rejects_insert_tail_equal_begin_u64() {\n    let mut v: [u64; 5] = kani::any();\n    let begin = v.as_mut_ptr();\n    kani::cover(true, \"helper contract invalid insert_tail consumer reached\");\n    // Deliberate contract violation: initialized pointers in one allocation, but tail == begin.\n    // The stub must fail the begin < tail requires, before any real-body access.\n    unsafe { insert_tail(begin, begin, &mut arbitrary_less::<u64>) };\n}\n\n#[kani::proof_for_contract(sort4_stable)]\n#[kani::unwind(16)]\nfn sort4_safety_u64() {\n    let src: [u64; 4] = kani::any();\n    let before = src;\n    let mut dst = crate::mem::MaybeUninit::<[u64; 4]>::uninit();\n    // SAFETY: four initialized source values and a distinct allocation writable for four\n    // destination values. The destination need not be initialized before the call.\n    unsafe { sort4_stable(src.as_ptr(), dst.as_mut_ptr().cast(), &mut arbitrary_less::<u64>) };\n    for i in 0..4 {\n        kani::assert(src[i] == before[i], \"helper contract sort4 source frame\");\n    }\n    // SAFETY: the real body writes all four output slots on every normal-return path.\n    // Read the output to exercise the initialized slots.\n    let result = unsafe { dst.assume_init() };\n    for value in &result {\n        // SAFETY: each returned output element is initialized and readable.\n        let _value = unsafe { crate::ptr::read_volatile(value) };\n    }\n    kani::cover(true, \"helper contract sort4 returns\");\n}\n\nfn cut_merge_order_violation() -> ! {\n    // Cover the explicit order-violation boundary before cutting the abort path.\n    kani::cover(true, \"helper contract merge order violation reachable\");\n    kani::assume(false);\n    unreachable!()\n}\n\nfn exercise_merge_u64<const N: usize>() {\n    let src: [u64; N] = kani::any();\n    let before = src;\n    let mut dst = crate::mem::MaybeUninit::<[u64; N]>::uninit();\n    // SAFETY: N is 2 or 4 in these PFCs; src is an initialized Freeze u64 slice,\n    // and a distinct destination allocation has space for exactly N values.\n    unsafe { bidirectional_merge(&src, dst.as_mut_ptr().cast(), &mut arbitrary_less::<u64>) };\n    for i in 0..N {\n        kani::assert(src[i] == before[i], \"helper contract merge source frame\");\n    }\n    // SAFETY: every output slot is written on normal return; inconsistent comparator\n    // paths reach the explicit panic boundary and are cut by the safety stub.\n    let result = unsafe { dst.assume_init() };\n    for value in &result {\n        // SAFETY: initialized output on normal return.\n        let _value = unsafe { crate::ptr::read_volati
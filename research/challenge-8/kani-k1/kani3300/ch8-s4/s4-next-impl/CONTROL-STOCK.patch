+  "library/core/src/slice/sort/shared/smallsort/verify/comparators.rs": "//! Comparator shared by bounded stable unit-ZST harnesses.\n//!\n//! Sized values use observable volatile reads. On this Kani pin, ZST `read_volatile` calls in\n//! measured in-core fixtures produced pointer-check failures whose cause is not established.\n//! ZSTs therefore use `ptr::read`; this helper does not check uninitialized reads.\n\nuse crate::mem::ManuallyDrop;\nuse crate::{kani, ptr};\n\npub(super) fn zst_aware_less<T>(a: &T, b: &T) -> bool {\n    // SAFETY: callers supply initialized readable references. ManuallyDrop prevents destruction\n    // of read copies; for a ZST the reference is non-null and aligned and no bytes are accessed.\n    unsafe {\n        if crate::mem::size_of::<T>() != 0 {\n            let _left = ManuallyDrop::new(ptr::read_volatile(a));\n            let _right = ManuallyDrop::new(ptr::read_volatile(b));\n        } else {\n            let _left = ManuallyDrop::new(ptr::read(a));\n            let _right = ManuallyDrop::new(ptr::read(b));\n        }\n    }\n    kani::any()\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/fixed_inputs.rs": "//! Fixed witnesses, a mutant swap control, and stable unit-ZST checks.\n\nuse super::super::{\n    StableSmallSortTypeImpl, bidirectional_merge, insert_tail, merge_up, small_sort_network,\n    swap_if_less,\n};\nuse crate::mem::MaybeUninit;\nuse crate::{kani, ptr};\n\nfn strict_less(a: &u8, b: &u8) -> bool {\n    // SAFETY: both arguments must be initialized and readable before comparison.\n    unsafe { ptr::read_volatile(a) < ptr::read_volatile(b) }\n}\n\nfn cut_ord_violation() -> ! {\n    // The panic stub cuts only the explicit order-violation path; normal returns are covered below.\n    kani::assume(false);\n    unreachable!()\n}\n\nfn check_swap(call: impl FnOnce(&mut [u8; 2])) {\n    let mut v: [u8; 2] = kani::any();\n    let before = v;\n    call(&mut v);\n    assert!(v[0] <= v[1]);\n    assert!((v == before) || (v == [before[1], before[0]]));\n    kani::cover(true, \"swap returns a sorted permutation\");\n}\n\nfn check_insert(call: impl FnOnce(&mut [u8; 2])) {\n    let mut v: [u8; 2] = kani::any();\n    let before = v;\n    call(&mut v);\n    assert!(v[0] <= v[1]);\n    assert!((v == before) || (v == [before[1], before[0]]));\n    kani::cover(true, \"insertion returns a sorted permutation\");\n}\n\nfn check_merge_up(\n    call: impl FnOnce(*const u8, *const u8, *mut u8) -> (*const u8, *const u8, *mut u8),\n) {\n    let src: [u8; 2] = kani::any();\n    let left = src.as_ptr();\n    // SAFETY: second element in src.\n    let right = unsafe { left.add(1) };\n    let mut dst = MaybeUninit::<u8>::uninit();\n    let out = dst.as_mut_ptr();\n    let (next_left, next_right, next_dst) = call(left, right, out);\n    let take_left = src[0] <= src[1];\n    // SAFETY: these expected pointers are at most one-past the source and destination arrays.\n    let advancement_ok = unsafe {\n        next_left == left.add(take_left as usize)\n            && next_right == right.add((!take_left) as usize)\n            && next_dst == out.add(1)\n    };\n    assert!(advancement_ok);\n    // SAFETY: merge_up wrote exactly one element.\n    let value = unsafe { dst.assume_init() };\n    assert!(value == if take_left { src[0] } else { src[1] });\n    kani::cover(take_left, \"forward merge consumes left\");\n    kani::cover(!take_left, \"forward merge consumes right\");\n}\n\nfn count(v: &[u8; 4], probe: u8) -> usize {\n    (v[0] == probe) as usize\n        + (v[1] == probe) as usize\n        + (v[2] == probe) as usize\n        + (v[3] == probe) as usize\n}\n\nfn arbitrary_less(a: &u8, b: &u8) -> bool {\n    // SAFETY: both comparator arguments must be initialized and readable.\n    unsafe {\n        let _left = ptr::read_volatile(a);\n        let _right = ptr::read_volatile(b);\n    }\n    kani::any()\n}\n\nfn check_merge_consumption(call: impl FnOnce(&[u8; 4], *mut u8)) {\n    let src: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut dst = MaybeUninit::<[u8; 4]>::uninit();\n    call(&src, dst.as_mut_ptr().cast());\n    // SAFETY: both merge directions wrote two output elements on normal return.\n    let result = unsafe { dst.assume_init() };\n    assert!(count(&src, probe) == count(&result, probe));\n    kani::cover(true, \"merge preserves the probe count on normal return\");\n}\n\nfn check_presorted_len(call: impl FnOnce(&mut [u8; 10])) {\n    // Sorted prefix of nine; the tenth zero must move to the front.\n    let mut v = [1u8, 1, 1, 1, 1, 1, 1, 1, 1, 0];\n    call(&mut v);\n    assert!(v[0] == 0 && v[9] == 1);\n    kani::cover(true, \"network inserts the tenth element\");\n}\n\nmacro_rules! original_case {\n    ($positive:ident, $check:ident, $original:expr) => {\n        #[kani::proof]\n        #[kani::unwind(17)]\n        #[kani::stub(super::super::panic_on_ord_violation, cut_ord_violation)]\n        fn $positive() {\n            $check($original);\n        }\n    };\n}\n\n// The shared helpers establish each call's valid pointers, initialized values, and region lengths.\noriginal_case!(\n    sorted_permutation_swap_u8_n2,\n    check_swap,\n    // SAFETY: two distinct initialized elements in the same two-element array.\n    |v: &mut [u8; 2]| unsafe { swap_if_less(v.as_mut_ptr(), 0, 1, &mut strict_less) }\n);\noriginal_case!(\n    sorted_permutation_insert_tail_u8_n2,\n    check_insert,\n    // SAFETY: sorted one-element prefix and initialized tail in the same array.\n    |v: &mut [u8; 2]| unsafe {\n        insert_tail(v.as_mut_ptr(), v.as_mut_ptr().add(1), &mut strict_less)\n    }\n);\noriginal_case!(\n    advancement_merge_up_u8_n2,\n    check_merge_up,\n    // SAFETY: helper supplies two readable elements and a separate writable destination.\n    |l, r, d| unsafe { merge_up(l, r, d, &mut strict_less) }\n);\noriginal_case!(\n    permutation_merge_u8_n4,\n    check_merge_consumption,\n    // SAFETY: helper supplies four initialized inputs and a separate four-element destination.\n    |v: &[u8; 4], d| unsafe { bidirectional_merge(v, d, &mut arbitrary_less) }\n);\noriginal_case!(\n    sorted_network_prefix_u8_n10,\n    check_presorted_len,\n    // Safe entry: the exact ten-element array supplies the network length.\n    |v: &mut [u8; 10]| small_sort_network(v, &mut strict_less)\n);\n\n// Opt-in negative control: the swap check above, run on a copy that negates the exchange decision.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(17)]\n#[kani::stub(super::super::panic_on_ord_violation, cut_ord_violation)]\nfn reject_mutant_swap_u8_n2() {\n    // SAFETY: two distinct initialized elements in the same two-element array.\n    check_swap(|v: &mut [u8; 2]| unsafe {\n        super::mutations::mutant_swap_if_less(v.as_mut_ptr(), 0, 1, &mut strict_less)\n    });\n}\n\n// The unwind budget allows the longest selected stable route despite zero-sized elements.\nmacro_rules! stable_unit_case {\n    ($name:ident, $n:literal) => {\n        #[kani::proof]\n        #[kani::unwind(65)]\n        #[kani::stub(super::super::panic_on_ord_violation, cut_ord_violation)]\n        fn $name() {\n            let mut v = [(); $n];\n            let mut scratch = [MaybeUninit::<()>::uninit(); 48];\n            <() as StableSmallSortTypeImpl>::small_sort(\n                &mut v,\n                &mut scratch,\n                &mut super::comparators::zst_aware_less::<()>,\n            );\n            kani::cover(true, concat!(\"stable unit sort returns at length \", stringify!($n)));\n        }\n    };\n}\n\nstable_unit_case!(safety_stable_unit_n1, 1);\nstable_unit_case!(safety_stable_unit_n2, 2);\nstable_unit_case!(safety_stable_unit_n7, 7);\nstable_unit_case!(safety_stable_unit_n8, 8);\nstable_unit_case!(safety_stable_unit_n16, 16);\nstable_unit_case!(safety_stable_unit_n17, 17);\nstable_unit_case!(safety_stable_unit_n31, 31);\nstable_unit_case!(safety_stable_unit_n32, 32);\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/forwarding_contracts.rs": "//! Concrete checked N2 forwarding contracts, executing the real trait entries without stubs.\n//! The model is the full byte; order uses its upper seven bits. An independent by-value probe\n//! is shared by the scalar pre-count and post-count. No specification calls the comparator.\n\nuse super::super::{\n    StableSmallSortTypeImpl, UnstableSmallSortFreezeTypeImpl, UnstableSmallSortTypeImpl,\n};\nuse crate::cell::Cell;\nuse crate::mem::MaybeUninit;\nuse crate::ub_checks::{can_dereference, can_write, same_allocation};\nuse crate::{kani, ptr, slice};\n\n/// Freeze, one byte, neither Copy nor Drop: selects the default Freeze general implementation.\n#[repr(transparent)]\nstruct NonCopyU8(u8);\n\n// Closed to this proof module; these projections preserve each type's complete logical value.\ntrait Model {\n    fn model(&self) -> u8;\n}\n\nimpl Model for u8 {\n    fn model(&self) -> u8 {\n        *self\n    }\n}\n\nimpl Model for Cell<u8> {\n    fn model(&self) -> u8 {\n        self.get()\n    }\n}\n\nimpl Model for NonCopyU8 {\n    fn model(&self) -> u8 {\n        self.0\n    }\n}\n\nfn cell_less(a: &Cell<u8>, b: &Cell<u8>) -> bool {\n    (a.get() >> 1) < (b.get() >> 1)\n}\n\nfn byte_less(a: &u8, b: &u8) -> bool {\n    (*a >> 1) < (*b >> 1)\n}\n\nfn noncopy_less(a: &NonCopyU8, b: &NonCopyU8) -> bool {\n    (a.0 >> 1) < (b.0 >> 1)\n}\n\n// Same direct address comparison as the `merge::profiles` profile guard.\nfn canonical<T>(cmp: fn(&T, &T) -> bool, expected: fn(&T, &T) -> bool) -> bool {\n    cmp as *const () == expected as *const ()\n}\n\n// Keep the literal in a single location for the negative control's exact expect_check.\n// Return false after a rejected guard, so even that path cannot forward an unlawful callback.\nfn canonical_guard(ok: bool) -> bool {\n    kani::assert(ok, \"canonical comparator required\");\n    ok\n}\n\n// Geometry only: initialization and exclusive mutable storage come from the harness fixtures.\nfn pair_region<T>(v: *mut T) -> bool {\n    can_dereference(ptr::slice_from_raw_parts(v, 2))\n        && can_write(ptr::slice_from_raw_parts_mut(v, 2))\n}\n\n// The geometry requires disjoint input and scratch spans; fixture borrows supply exclusivity.\nfn stable_region(v: *mut Cell<u8>, scratch: &[MaybeUninit<Cell<u8>>]) -> bool {\n    pair_region(v)\n        && (scratch.is_empty()\n            || !same_allocation(v as *const Cell<u8>, scratch.as_ptr().cast::<Cell<u8>>())\n            || {\n                // SAFETY: both nonempty regions are live and in the same allocation.\n                // MaybeUninit<Cell<u8>> and Cell<u8> have identical size and alignment.\n                let d = unsafe { scratch.as_ptr().cast::<Cell<u8>>().offset_from(v) };\n                if d >= 0 { d as usize >= 2 } else { d.unsigned_abs() >= scratch.len() }\n            })\n}\n\n// Both helpers read only the two initialized input elements, never any scratch or uninit tail.\nfn sorted<T: Model>(v: &[T]) -> bool {\n    (v[0].model() >> 1) <= (v[1].model() >> 1)\n}\n\nfn count<T: Model>(v: &[T], probe: u8) -> usize {\n    (v[0].model() == probe) as usize + (v[1].model() == probe) as usize\n}\n\n// Raw pair arguments avoid conflicting generated captures of an &mut slice in the contract\n// macros. The raw span is always exactly N2; these adapters use the same pure checker as the\n// corruption control. Only the scalar count is captured in old().\nfn pair_sorted<T: Model>(v: *const T) -> bool {\n    // SAFETY: fixture initialization supplies two values; the requires check their span geometry.\n    sorted(unsafe { slice::from_raw_parts(v, 2) })\n}\n\nfn pair_count<T: Model>(v: *const T, probe: u8) -> usize {\n    // SAFETY: fixture initialization supplies two values; the requires check their span geometry.\n    count(unsafe { slice::from_raw_parts(v, 2) }, probe)\n}\n\n// Cell is !Freeze: the default Stable entry ignores scratch and runs insertion from index 1.\n// Only the input slice is writable in the frame; even initialized caller scratch is untouched.\n#[kani::requires(stable_region(v, scratch))]\n#[kani::requires(canonical(cmp, cell_less))]\n#[kani::modifies(ptr::slice_from_raw_parts_mut(v, 2))]\n#[kani::ensures(|_| pair_sorted(v))]\n#[kani::ensures(|_| old(pair_count(v, probe)) == pair_count(v, probe))]\nunsafe fn stable_cell(\n    v: *mut Cell<u8>,\n    scratch: &mut [MaybeUninit<Cell<u8>>],\n    cmp: fn(&Cell<u8>, &Cell<u8>) -> bool,\n    probe: u8,\n) {\n    if !canonical_guard(canonical(cmp, cell_less)) {\n        return;\n    }\n    // SAFETY: initialized exclusive fixture storage; the requires check the two-element geometry.\n    let v = unsafe { slice::from_raw_parts_mut(v, 2) };\n    let mut is_less = cmp;\n    <Cell<u8> as StableSmallSortTypeImpl>::small_sort(v, scratch, &mut is_less);\n}\n\n// u8 is Freeze + Copy and has efficient swap: network route, insertion only at N2.\n#[kani::requires(pair_region(v))]\n#[kani::requires(canonical(cmp, byte_less))]\n#[kani::modifies(ptr::slice_from_raw_parts_mut(v, 2))]\n#[kani::ensures(|_| pair_sorted(v))]\n#[kani::ensures(|_| old(pair_count(v, probe)) == pair_count(v, probe))]\nunsafe fn unstable_byte(v: *mut u8, cmp: fn(&u8, &u8) -> bool, probe: u8) {\n    if !canonical_guard(canonical(cmp, byte_less)) {\n        return;\n    }\n    // SAFETY: initialized exclusive fixture storage; the requires check the two-element geometry.\n    let v = unsafe { slice::from_raw_parts_mut(v, 2) };\n    let mut is_less = cmp;\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(v, &mut is_less);\n}\n\n// NonCopyU8 is Freeze but !Copy; 1 * 48 <= 4096 selects general, with private local scratch.\n// At N2 general copies two singleton halves, merges into v and forgets the panic copy-back guard.\n#[kani::requires(pair_region(v))]\n#[kani::requires(canonical(cmp, noncopy_less))]\n#[kani::modifies(ptr::slice_from_raw_parts_mut(v, 2))]\n#[kani::ensures(|_| pair_sorted(v))]\n#[kani::ensures(|_| old(pair_count(v, probe)) == pair_count(v, probe))]\nunsafe fn freeze_noncopy(v: *mut NonCopyU8, cmp: fn(&NonCopyU8, &NonCopyU8) -> bool, probe: u8) {\n    if !canonical_guard(canonical(cmp, noncopy_less)) {\n        return;\n    }\n    // SAFETY: initialized exclusive fixture storage; the requires check the two-element geometry.\n    let v = unsafe { slice::from_raw_parts_mut(v, 2) };\n    let mut is_less = cmp;\n    <NonCopyU8 as UnstableSmallSortFreezeTypeImpl>::small_sort(v, &mut is_less);\n}\n\nfn input_covers(a: u8, b: u8, probe: u8) {\n    kani::cover((a >> 1) > (b >> 1), \"reversed keys return\");\n    kani::cover((a >> 1) < (b >> 1), \"increasing keys return\");\n    kani::cover(a != b && (a >> 1) == (b >> 1), \"tied keys retain distinct full values\");\n    kani::cover(a == b, \"duplicate full values return\");\n    kani::cover(probe == a || probe == b, \"independent probe hits input\");\n    kani::cover(probe != a && probe != b, \"independent probe misses input\");\n}\n\n#[kani::proof_for_contract(stable_cell)]\n#[kani::unwind(16)]\nfn stable_cell_n2() {\n    let [left, a, b, right]: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut v = [Cell::new(left), Cell::new(a), Cell::new(b), Cell::new(right)];\n    let mut scratch = [MaybeUninit::new(Cell::new(kani::any())), MaybeUninit::uninit()];\n    let scratch_len: usize = kani::any_where(|n: &usize| *n <= 2);\n    // SAFETY: this slot was initialized above; Cell has no padding and get reads its full value.\n    let scratch_before = unsafe { scratch[0].assume_init_ref() }.get();\n    // SAFETY: active pair in initialized backing4; separate valid scratch; canonical pointer.\n    unsafe { stable_cell(v[1..3].as_mut_ptr(), &mut scratch[..scratch_len], cell_less, probe) };\n    kani::assert(v[0].get() == left && v[3].get() == right, \"stable input frame\");\n    // SAFETY: the default Cell route does not write scratch; only the input may be modified.\n    let scratch_after = unsafe { scratch[0].assume_init_ref() }.get();\n    kani::assert(scratch_before == scratch_after, \"stable scratch frame\");\n    kani::cover(scratch_len == 0, \"stable empty scratch returns\");\n    kani::cover(scratch_len == 2, \"stable unread uninit scratch tail returns\");\n    input_covers(a, b, probe);\n    kani::cover(true, \"stable Cell trait entry returns\");\n}\n\n#[kani::proof_for_contract(unstable_byte)]\n#[kani::unwind(16)]\nfn unstable_byte_n2() {\n    let [left, a, b, right]: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut v = [left, a, b, right];\n    // SAFETY: active pair in initialized backing4; canonical pointer.\n    unsafe { unstable_byte(v[1..3].as_mut_ptr(), byte_less, probe) };\n    kani::assert(v[0] == left && v[3] == right, \"unstable input frame\");\n    input_covers(a, b, probe);\n    kani::cover(true, \"unstable u8 trait entry returns\");\n}\n\n#[kani::proof_for_contract(freeze_noncopy)]\n#[kani::unwind(16)]\nfn freeze_noncopy_n2() {\n    let [left, a, b, right]: [u8; 4] = kani::any();\n    let probe: u8 = kani::any();\n    let mut v = [NonCopyU8(left), NonCopyU8(a), NonCopyU8(b), NonCopyU8(right)];\n    // SAFETY: active pair in initialized backing4; canonical pointer.\n    unsafe { freeze_noncopy(v[1..3].as_mut_ptr(), noncopy_less, probe) };\n    kani::assert(v[0].0 == left && v[3].0 == right, \"Freeze input frame\");\n    input_covers(a, b, probe);\n    kani::cover(true, \"Freeze NonCopyU8 trait entry returns\");\n}\n\n#[cfg(kani_smallsort_controls)]\nfn always_true<T>(_: &T, _: &T) -> bool {\n    true\n}\n\n// Opt-in control, plain real-body calls: no PFC assumption or summary hides a bad fn pointer.\n// One nondeterministic branch per wrapper; the common literal guard must be the only failure.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(16)]\nfn rejects_always_true() {\n    let [a, b]: [u8; 2] = kani::any();\n    let probe: u8 = kani::any();\n    let case: u8 = kani::any_where(|c: &u8| *c < 3);\n    match case {\n        0 => {\n            let mut v = [Cell::new(a), Cell::new(b)];\n            kani::cover(true, \"invalid stable comparator reaches guard\");\n            // SAFETY: valid pair and scratch; only canonical identity is deliberately rejected.\n            unsafe { stable_cell(v.as_mut_ptr(), &mut [], always_true::<Cell<u8>>, probe) };\n        }\n        1 => {\n            let mut v = [a, b];\n            kani::cover(true, \"invalid unstable comparator reaches guard\");\n            // SAFETY: valid pair; only canonical identity is deliberately rejected.\n            unsafe { unstable_byte(v.as_mut_ptr(), always_true::<u8>, probe) };\n        }\n        _ => {\n            let mut v = [NonCopyU8(a), NonCopyU8(b)];\n            kani::cover(true, \"invalid Freeze comparator reaches guard\");\n            // SAFETY: valid pair; only canonical identity is deliberately rejected.\n            unsafe { freeze_noncopy(v.as_mut_ptr(), always_true::<NonCopyU8>, probe) };\n        }\n    }\n}\n\n// Separate plain real trait execution, checked with the exact same model and count\n// as the contracts.\n// The mutation belongs only to this control, after the real entry returns, never to a wrapper.\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::unwind(16)]\nfn rejects_payload_corruption() {\n    let mut v: [u8; 2] = kani::any();\n    let probe: u8 = kani::any();\n    let before = count(&v, probe);\n    let mut cmp: fn(&u8, &u8) -> bool = byte_less;\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(&mut v, &mut cmp);\n    kani::assert(sorted(&v), \"control real body sorts keys\");\n    kani::assert(before == count(&v, probe), \"control real body keeps full values\");\n    kani::cover(true, \"payload corruption reached after real trait return\");\n    v[0] ^= 1;\n    kani::assert(sorted(&v), \"corrupted payload keeps key order\");\n    kani::assert(before == count(&v, probe), \"full-value checker rejects payload corruption\");\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/helper_contracts_wide.rs": "//! Allocation-aware contract proofs paired with network and sort8 consumers.\n\nuse super::super::{UnstableSmallSortTypeImpl, bidirectional_merge, sort8_stable, swap_if_less};\nuse crate::mem::{ManuallyDrop, MaybeUninit};\nuse crate::{kani, ptr};\n\nfn arbitrary_less<T>(a: &T, b: &T) -> bool {\n    // SAFETY: the real helper supplies readable initialized references. ManuallyDrop\n    // prevents dropping the temporary volatile copies of the Copy scalar elements.\n    unsafe {\n        let _a = ManuallyDrop::new(ptr::read_volatile(a));\n        let _b = ManuallyDrop::new(ptr::read_volatile(b));\n    }\n    let answer: bool = kani::any();\n    kani::cover(answer, \"comparator true\");\n    kani::cover(!answer, \"comparator false\");\n    answer\n}\n\nfn exercise_swap<T: kani::Arbitrary + Copy + PartialEq>() {\n    let mut backing: [T; 32] = kani::any();\n    let before = backing;\n    let start: usize = kani::any();\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(start < 32);\n    kani::assume(a < 32 - start && b < 32 - start);\n    // SAFETY: both possibly equal relative positions are initialized writable elements\n    // in this allocation, including when the base is an interior pointer.\n    unsafe { swap_if_less(backing.as_mut_ptr().add(start), a, b, &mut arbitrary_less::<T>) };\n    for i in 0..32 {\n        kani::assert(\n            i == start + a || i == start + b || backing[i] == before[i],\n            \"swap allocation frame\",\n        );\n    }\n    kani::cover(a == b, \"swap equal positions return\");\n    kani::cover(a < b, \"swap increasing positions return\");\n    kani::cover(a > b, \"swap decreasing positions return\");\n    kani::cover(start == 0, \"swap allocation base returns\");\n    kani::cover(start == 16, \"swap second half base returns\");\n    kani::cover(start + b == 31, \"swap last element returns\");\n    kani::cover(true, \"swap returns\");\n}\n\nfn cut_order_violation() -> ! {\n    kani::cover(true, \"network order violation reachable\");\n    kani::assume(false);\n    unreachable!()\n}\n\nfn tail_less_u64(a: &u64, b: &u64) -> bool {\n    // SAFETY: the helper must provide readable, initialized scalar references.\n    unsafe {\n        ptr::read_volatile(a);\n        ptr::read_volatile(b);\n    }\n    let answer: bool = kani::any();\n    tail_comparison_covers(answer);\n    answer\n}\n\nfn tail_comparison_covers(answer: bool) {\n    kani::cover(answer, \"comparator true\");\n    kani::cover(!answer, \"comparator false\");\n}\n\nfn cut_merge_order_violation() -> ! {\n    kani::cover(true, \"merge order violation reachable\");\n    kani::assume(false);\n    unreachable!()\n}\n\n// The unwind budget includes the 32-element frame loop and interior-base geometry checks.\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(50)]\nfn swap_safety_u8_backing32() {\n    exercise_swap::<u8>();\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(50)]\nfn swap_safety_u64_backing32() {\n    exercise_swap::<u64>();\n}\n\n// The paired swap proof includes interior bases for both halves of this network.\n// Insertion and merge run their real bodies; only the order-violation abort path is cut.\n#[kani::proof]\n#[kani::stub_verified(swap_if_less)]\n#[kani::stub(super::super::panic_on_ord_violation, cut_order_violation)]\n#[kani::unwind(50)]\nfn unstable_network_safety_u8_n32_stubbed() {\n    let mut backing: [u8; 32] = kani::any();\n    kani::cover(backing.len() == 32, \"network maximum length entered\");\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(&mut backing, &mut arbitrary_less::<u8>);\n    kani::cover(true, \"network maximum length returns\");\n}\n\n// Match sort8's scratch geometry with only its source region initialized.\n// The unwind budget also accommodates the consumer's 32-element input-frame loop.\n#[kani::proof_for_contract(bidirectional_merge)]\n#[kani::stub(super::super::panic_on_ord_violation, cut_merge_order_violation)]\n#[kani::unwind(34)]\nfn merge_safety_u64_len8_scratch48_src32_dst0() {\n    let values: [u64; 8] = kani::any();\n    let mut scratch = [MaybeUninit::<u64>::uninit(); 48];\n    for i in 0..8 {\n        scratch[32 + i].write(values[i]);\n    }\n    kani::cover(values.len() == 8, \"merge length8 entered\");\n    // SAFETY: initialized source [32..40] and uninitialized destination [0..8] are\n    // disjoint regions of this one aligned, writable allocation of 48 elements.\n    unsafe {\n        let base = scratch.as_mut_ptr().cast::<u64>();\n        let source = crate::slice::from_raw_parts(base.add(32), 8);\n        bidirectional_merge(source, base, &mut tail_less_u64);\n    }\n    for i in 0..8 {\n        // SAFETY: the initialized source must be framed by the merge.\n        let after = unsafe { scratch[32 + i].assume_init() };\n        kani::assert(after == values[i], \"merge source frame\");\n    }\n    kani::cover(true, \"merge length8 returns\");\n}\n\n// Real sort4 calls initialize the source region required by the paired merge proof.\n// The source-frame check includes input elements beyond the eight passed to sort8.\n#[kani::proof]\n#[kani::stub_verified(bidirectional_merge)]\n#[kani::unwind(34)]\nfn sort8_safety_u64_scratch48_src32_dst0_merge_stubbed() {\n    let mut backing: [u64; 32] = kani::any();\n    let before = backing;\n    let mut scratch = [MaybeUninit::<u64>::uninit(); 48];\n    kani::cover(scratch.len() == 48, \"sort8 scratch48 entered\");\n    // SAFETY: the real sort4 calls initialize scratch[32..40] before the verified\n    // merge stub writes the disjoint destination [0..8]. Input has eight readable elements.\n    unsafe {\n        let base = scratch.as_mut_ptr().cast::<u64>();\n        sort8_stable(backing.as_mut_ptr(), base, base.add(32), &mut tail_less_u64);\n    }\n    for i in 0..32 {\n        kani::assert(backing[i] == before[i], \"sort8 source allocation frame\");\n   
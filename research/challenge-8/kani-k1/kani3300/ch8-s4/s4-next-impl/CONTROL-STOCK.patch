   # functionality\n    'cfg(no_io_statics)',\n]\n\n[package.metadata.flux]\nenabled = true\ncheck_overflow = \"lazy\"\ninclude = [ \"src/flux_info.rs\",\n            \"src/ascii*.rs\",\n            \"src/num/mod.rs\",\n            \"src/pat.rs\",\n            \"src/byte_str/*.rs\",\n            \"src/hash/*.rs\",\n            \"src/time.rs\",\n          ]\n",

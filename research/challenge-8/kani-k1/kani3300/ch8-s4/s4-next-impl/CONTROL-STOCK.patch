+        'small_sort_fallback': ('insertion_sort_shift_left(v, 1, is_less);',),
+        'small_sort_network': ('let no_merge = len < 18;', 'insertion_sort_shift_left(region, presorted_len, is_less);', 'if no_merge { return; }'),
+        'insertion_sort_shift_left': ('insert_tail(v_base, tail, is_less);', 'tail = tail.add(1);'),
+        'insert_tail': ('let tmp = ManuallyDrop::new(tail.read());', 'let mut gap_guard = CopyOnDrop { src: &*tmp, dst: tail, len: 1 };',
+                        'ptr::copy_nonoverlapping(sift, gap_guard.dst, 1);', 'gap_guard.dst = sift;'),
+    }
+    production = functions(original)
+    for function, fragments in required_edges.items():
+        c.need(function in production, 'name gate: missing required production body '+function)
+        body = c.spelling(production[function]['body'])
+        for fragment in fragments:
+            c.need(c.spelling(c.tokens(fragment)) in body, 'name gate: required callpath drift '+function+':'+fragment)
+    s9 = call_paths(production['sort9_optimal']['body'])
+    c.need(sum(path == ('swap_if_less',) for path,_,kind,_ in s9 if kind == 'STATIC') == 25, 'name gate: actual sort9 must retain 25 real swaps')
+    if 'lexical_source_sha256' in request:
+        c.need(hashes == request['lexical_source_sha256'], 'name gate: source/provider hash drift')
+    return {'status':'STATIC_PASS','schema':'ch8-s2-lexical-binding-v1',
+        'source_sha':request['std_sha'],'source_tree':request['std_tree'],
+        'inventory_derivation':'all added or head/body-changed functions relative to SHA-pinned r3 fixture',
+        'functions':records,'source_files_sha256':hashes,'required_production_fragments':required_edges,
+        'concrete_cell_method_provider':{'file':BASE+'cell.rs','type':'Cell<u8>','methods':['new','get','set'],'dispatch':'NOT_CHECKED; exact typed body and provider anchors only'},
+        'contexts':[{'row':r['id'],'effective_cfg':sorted(active),'functions_checked':len(records),'all_branches':True} for r in request['rows']],
+        'limits':['lexical paths only; no type, generic bound, borrow, method, macro expansion, MIR or compilation validation',
+                  'body-local items/imports and unsupported paths fail closed; callable parameters are lexical only'],
+        'native_compile':'NOT_RUN','proof_credit':'NONE'}

+            if request.get("schema")=="ch8-s4p-2r2-v1":import s4p2r2_profile as profile
+            if request.get("schema")=="ch8-s4p-2-v1":import s4p2_profile as profile
+            if request.get("schema")=="ch8-s4p-1-v1":import s4p_profile as profile

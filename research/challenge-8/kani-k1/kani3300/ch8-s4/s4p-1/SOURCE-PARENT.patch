+    kani::cover(true, "S4P_F_03_04_USEFUL_RETURN");
+}
+
+#[kani::proof]
+#[kani::unwind(36)]
+fn s4p_network_b01_n00_02_fullbyte() {
+    kani::assert(active_u8(), "S4P_N_00_02_ACTIVE_CONCRETE_MODEL");

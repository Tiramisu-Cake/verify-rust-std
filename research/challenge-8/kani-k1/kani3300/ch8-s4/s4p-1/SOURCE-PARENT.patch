+    }
+    let p = v.as_mut_ptr().cast::<u8>();
+    unsafe { sort4_stable(p.add(src), p.add(dst), &mut KeyLess::<u8>::new()) };
+    let out = unsafe { [v[dst].assume_init(), v[dst+1].assume_init(), v[dst+2].assume_init(), v[dst+3].assume_init()] };

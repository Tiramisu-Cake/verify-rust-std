+#[kani::proof]
+#[kani::unwind(36)]
+fn s4p_network_b01_n03_04_fullbyte() {
+    kani::assert(active_u8(), "S4P_N_03_04_ACTIVE_CONCRETE_MODEL");
+    let mut v: [u8; 34] = kani::any();

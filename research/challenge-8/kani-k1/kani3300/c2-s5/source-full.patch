-            result[key] = value
-        return result
-
-    def invalid_constant(value):
-        raise Rejected(f"non-JSON numeric constant: {value}")
-
-    return json.loads(Path(path).read_text(), object_pairs_hook=unique,
-                      parse_constant=invalid_constant)

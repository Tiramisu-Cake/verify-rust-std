+#[kani::proof]
+fn recursive_zst_arm() {
+    // Inferred cast avoids a separately monomorphized union-typed null helper.
+    let node = Node2 { next: 0usize as *const _ };
+    let retained = std::hint::black_box(node);
+    assert!(retained.next.is_null());

+}
+PATCHED_FILE_HASHES = {'library/core/src/slice/sort/shared/smallsort/verify.rs': '506644ad92ed4872af19bd1d302b439ff5e1d4dd850e9e9f149d429286065a95', 'library/core/src/slice/sort/shared/smallsort/verify/helper_contracts.rs': '22de8b24f6adf35b633b2962d9873a349041a18cca9d580944d2d4a3c9ad0655', 'library/core/src/slice/sort/shared/smallsort/verify/helper_contracts_wide.rs': 'b2d71e6e61b4130a95dda6daac3cd5f0970f9daf7b0f7bfa8a9f99d9c3c29844', 'library/core/src/slice/sort/shared/smallsort/verify/replay_gateb_prime.rs': 'c585f3d0c74879cb21e8f09204f52d59b7aa4948a2e17541a94e162b3ffb10a1', 'library/core/src/slice/sort/shared/smallsort/verify/replay_uninit_controls.rs': 'c186a086dadba038ff5ad7ca823e52e1e807758a92b1a46cf4c807fc07d96a39'}
+PINNED_RUST_TOOLCHAIN = "nightly-2026-10-23"

+# CI-only; coordinator publishes same-tree non-skip trigger.
+name: Challenge 8 W0 A1 bounded safety probes
+'on':
+  push:
+    branches:
+    - uninit-ci/ch8-w0-a1-r1-*
+    - uninit-ci/ch8-w0-a1-r2-*
+permissions:
+  contents: read
+concurrency:
+  group: ch8-w0-a1
+  cancel-in-progress: false
+jobs:
+  r1:
+    if: ${{ github.repository == 'Tiramisu-Cake/kani' && startsWith(github.ref, 'refs/heads/uninit-ci/ch8-w0-a1-r1-') }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      max-parallel: 1
+      matrix:
+        root:
+        - stable_freeze_u64_n32

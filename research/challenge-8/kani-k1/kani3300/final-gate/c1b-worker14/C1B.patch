diff --git a/tests/json-handler/uninit-contract-oracles/README.md b/tests/json-handler/uninit-contract-oracles/README.md
index 97c2fa1a4..daa0bc957 100644
--- a/tests/json-handler/uninit-contract-oracles/README.md
+++ b/tests/json-handler/uninit-contract-oracles/README.md
@@ -28,8 +28,13 @@ keys/IDs, missing/extra failures and unknown statuses, and compares exact failur
 multisets. Useful assertions must be SUCCESS; UNREACHABLE is insufficient.
 Unused service properties may be UNREACHABLE. Unsupported properties may be
 SUCCESS or UNREACHABLE only; a reached Unsupported fails the test and stops the
-lawful-modifies run. Only the exact checkout prefix is normalized; generated
-names and Rust library paths remain exact. Changed identities require a reviewed
+lawful-modifies run. The invocation's exact checkout prefix is removed, including
+paths embedded in closure IDs and diagnostics. External rustup source paths use
+`rust-toolchain:<toolchain>/library/<source>` in both regular and JSON evidence;
+only the installation root and relative traversal depth are removed. Toolchain,
+source suffix, lines, columns, functions, generated names, types and statuses
+remain exact. Compiler warnings outside RESULTS do not enter property identities;
+enabled verification checks and backend flags remain enforced. Changed identities require a reviewed
 manifest update; the runner never learns expectations from its output.
 
 Invocations use the checkout root as cwd so export paths are checkout-relative,
diff --git a/tests/json-handler/uninit-contract-oracles/checker.py b/tests/json-handler/uninit-contract-oracles/checker.py
index 676783df7..47489928e 100644
--- a/tests/json-handler/uninit-contract-oracles/checker.py
+++ b/tests/json-handler/uninit-contract-oracles/checker.py
@@ -43,9 +43,25 @@ def sha256(path):
 
 
 def normalize(value, prefix):
-    # Only the explicitly known checkout prefix. Keep all lines, types,
-    # functions, generated names and rust library paths intact.
-    return value.replace(prefix.rstrip("/") + "/", "") if isinstance(value, str) else value
+    """Remove installation roots, retaining complete source/property identities.
+
+    Rust source is outside the checkout: the regular renderer relativizes it
+    against cwd, while JSON uses an absolute path. Keep its toolchain identity
+    and full library suffix in a separate namespace. Do not collapse arbitrary
+    external paths or strip basename-only suffixes.
+    """
+    if not isinstance(value, str):
+        return value
+    value = re.sub(r"(?<![\w./-])" + re.escape(prefix.rstrip("/") + "/"), "", value)
+    return re.sub(
+        r"(?<![\w./-])(?:/(?:[\w.+-]+/)*|(?:\.\./)+(?:[\w.+-]+/)*)"
+        r"toolchains/([^/\s:]+)/lib/rustlib/src/rust/library/",
+        r"rust-toolchain:\1/library/", value)
+
+
+def normalize_property(prop, prefix):
+    # Source paths also occur inside closure IDs, function names and diagnostics.
+    return {key: normalize(value, prefix) for key, value in prop.items()}
 
 
 def identity(prop, prefix):
@@ -191,7 +207,8 @@ def validate(data, case, receipt, regular, root=ROOT):
     expected = binding["failures"]
     require(isinstance(expected, list), "missing exact failure inventory")
     expected = list(expected)
-    normalized = {p["id"]: {k: normalize(v, prefix) for k, v in p.items()} for p in props}
+    normalized = {normalize(p["id"], prefix): normalize_property(p, prefix) for p in props}
+    require(len(normalized) == len(props), "duplicate normalized regular IDs")
     consequences = binding.get("allowed_consequences", [])
     consequence_ids = [p["failure"]["id"] for p in consequences]
     require(len(consequence_ids) == len(set(consequence_ids)) and

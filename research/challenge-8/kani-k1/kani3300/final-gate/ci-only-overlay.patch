-          cmake --build build -- -j 4
-          # Prepend the bin directory to $PATH
-          echo "${GITHUB_WORKSPACE}/cbmc/build/bin" >> $GITHUB_PATH
-
-      - name: Build CBMC (macOS)
-        if: ${{ startsWith(matrix.os, 'macos') }}

+  "library/core/src/slice/sort/shared/smallsort/verify/sorting_s3_leaf.rs": "//! S3-1 bounded actual-body PFCs. No assumed callee or panic stub is used here.\n//! Full independent bytes, concrete u8/KeyLess<u8>, normal-return correctness.\n//! Backing sizes/offsets below are part of the claim; no allocation lifting.\nuse super::super::{swap_if_less, sort4_stable, insert_tail, bidirectional_merge};\nuse super::sorting_model::{KeyLess, enabled, snapshot, post};\nuse super::{sorting_s2_span as span, sorting_s2_swap as pair};\nuse crate::{kani, mem::MaybeUninit, slice};\n\nfn active() -> bool {\n    enabled::<u8, KeyLess<u8>>() && span::active::<u8, KeyLess<u8>>()\n        && pair::enabled::<u8, KeyLess<u8>>()\n}\nfn ordered(v: &[u8]) -> bool {\n    let mut i = 1;\n    while i < v.len() {\n        if v[i] < v[i - 1] { return false; }\n        i += 1;\n    }\n    true\n}\n\n#[kani::proof_for_contract(swap_if_less)]\n#[kani::unwind(36)]\nfn s3_swap_u8_geometry() {\n    kani::assert(active(), \"S3_SWAP_ACTIVE\");\n    let mut v: [u8; 34] = kani::any();\n    let before = v;\n    let base: usize = kani::any();\n    let a: usize = kani::any();\n    let b: usize = kani::any();\n    kani::assume(base <= 20 && a < 13 && b < 13);\n    let p = unsafe { v.as_mut_ptr().add(base) };\n    let pre = pair::capture::<u8, KeyLess<u8>>(p, a, b);\n    unsafe { swap_if_less(p, a, b, &mut KeyLess::<u8>::new()) };\n    kani::assert(pair::post::<u8, KeyLess<u8>>(pre, p, a, b), \"S3_SWAP_EXACT_TRANSFER\");\n    for i in 0..34 {\n        kani::assert(i == base + a || i == base + b || v[i] == before[i], \"S3_SWAP_FULL_FRAME\");\n    }\n    kani::cover(a == b, \"S3_SWAP_EQUAL\");\n    kani::cover(a < b && before[base + b] < before[base + a], \"S3_SWAP_TAKEN\");\n    kani::cover(a > b && before[base + b] >= before[base + a], \"S3_SWAP_REVERSE_UNTAKEN\");\n    kani::cover(a != b && before[base + a] == before[base + b], \"S3_SWAP_DUPLICATE\");\n    kani::cover(base == 0, \"S3_SWAP_BASE_ZERO\");\n    kani::cover(base == 20, \"S3_SWAP_BASE_LAST\");\n    kani::cover(true, \"S3_SWAP_USEFUL_RETURN\");\n}\n\n#[kani::proof_for_contract(sort4_stable)]\n#[kani::unwind(8)]\nfn s3_sort4_u8_separate() {\n    kani::assert(active(), \"S3_SORT4_SEPARATE_ACTIVE\");\n    let src: [u8; 6] = kani::any();\n    let before = src;\n    let mut dst = [MaybeUninit::<u8>::uninit(); 6];\n    dst[0].write(0xa5); dst[5].write(0x5a);\n    unsafe { sort4_stable(src.as_ptr().add(1), dst.as_mut_ptr().add(1).cast(), &mut KeyLess::<u8>::new()) };\n    // Typed loads retain stock initialization checks, after all actual writes.\n    let out = unsafe { [dst[1].assume_init(), dst[2].assume_init(), dst[3].assume_init(), dst[4].assume_init()] };\n    kani::assert(post::<u8, KeyLess<u8>>(snapshot::<u8, KeyLess<u8>>(&before[1..5]), &out), \"S3_SORT4_SEPARATE_SORTED_FULL_COUNT\");\n    kani::assert(src == before, \"S3_SORT4_SEPARATE_SOURCE_FRAME\");\n    kani::assert(unsafe { dst[0].assume_init() == 0xa5 && dst[5].assume_init() == 0x5a }, \"S3_SORT4_SEPARATE_CANARIES\");\n    kani::cover(!ordered(&before[1..5]), \"S3_SORT4_SEPARATE_UNSORTED\");\n    kani::cover(before[1] == before[4], \"S3_SORT4_SEPARATE_DUPLICATE\");\n    kani::cover(out[0] < out[3], \"S3_SORT4_SEPARATE_NONCONSTANT\");\n    kani::cover(true, \"S3_SORT4_SEPARATE_USEFUL_RETURN\");\n}\n\n#[kani::proof_for_contract(sort4_stable)]\n#[kani::unwind(50)]\nfn s3_sort4_u8_same_alloc() {\n    kani::assert(active(), \"S3_SORT4_SAME_ACTIVE\");\n    let before: [u8; 48] = kani::any();\n    let mut v = [MaybeUninit::<u8>::uninit(); 48];\n    let src: usize = kani::any();\n    let dst: usize = kani::any();\n    kani::assume(src <= 44 && dst <= 44);\n    kani::assume(src + 4 <= dst || dst + 4 <= src);\n    for i in 0..48 {\n        if i < dst || i >= dst + 4 { v[i].write(before[i]); }\n    }\n    let p = v.as_mut_ptr().cast::<u8>();\n    unsafe { sort4_stable(p.add(src), p.add(dst), &mut KeyLess::<u8>::new()) };\n    let out = unsafe { [v[dst].assume_init(), v[dst+1].assume_init(), v[dst+2].assume_init(), v[dst+3].assume_init()] };\n    kani::assert(post::<u8, KeyLess<u8>>(snapshot::<u8, KeyLess<u8>>(&before[src..src + 4]), &out), \"S3_SORT4_SAME_SORTED_FULL_COUNT\");\n    for i in 0..48 {\n        kani::assert((dst <= i && i < dst + 4) || unsafe { v[i].assume_init() } == before[i], \"S3_SORT4_SAME_OUTSIDE_FRAME\");\n    }\n    for i in 0..4 {\n        kani::assert(unsafe { v[src+i].assume_init() } == before[src+i], \"S3_SORT4_SAME_SOURCE_FRAME\");\n    }\n    let canary: usize = kani::any();\n    kani::assume(canary < 48 && (canary < dst || canary >= dst + 4));\n    kani::assert(unsafe { v[canary].assume_init() } == before[canary], \"S3_SORT4_SAME_CANARY\");\n    kani::cover(src + 4 == dst, \"S3_SORT4_SAME_FORWARD_ADJACENT\");\n    kani::cover(dst + 4 == src, \"S3_SORT4_SAME_REVERSE_ADJACENT\");\n    kani::cover(src == 44 && dst == 0, \"S3_SORT4_SAME_EXTREME\");\n    kani::cover(!ordered(&before[src..src + 4]), \"S3_SORT4_SAME_UNSORTED\");\n    kani::cover(before[src] == before[src + 3], \"S3_SORT4_SAME_DUPLICATE\");\n    kani::cover(out[0] < out[3], \"S3_SORT4_SAME_NONCONSTANT\");\n    kani::cover(true, \"S3_SORT4_SAME_USEFUL_RETURN\");\n}\n\n#[kani::proof_for_contract(insert_tail)]\n#[kani::unwind(36)]\nfn s3_insert_tail_u8_rel16() {\n    kani::assert(active(), \"S3_INSERT_ACTIVE\");\n    let mut v: [u8; 34] = kani::any();\n    let begin: usize = kani::any();\n    let tail: usize = kani::any();\n    kani::assume(1 <= begin && begin <= 16 && 1 <= tail && tail <= 16);\n    kani::assume(ordered(&v[begin..begin + tail]));\n    let before = v;\n    let p = unsafe { v.as_mut_ptr().add(begin) };\n    unsafe { insert_tail(p, p.add(tail), &mut KeyLess::<u8>::new()) };\n    kani::assert(post::<u8, KeyLess<u8>>(snapshot::<u8, KeyLess<u8>>(&before[begin..begin + tail + 1]), &v[begin..begin + tail + 1]), \"S3_INSERT_SORTED_FULL_COUNT\");\n    for i in 0..34 {\n        kani::assert((begin <= i && i <= begin + tail) || v[i] == before[i], \"S3_INSERT_OUTSIDE_FRAME\");\n    }\n    kani::cover(tail == 1, \"S3_INSERT_LENGTH2\");\n    kani::cover(tail == 16, \"S3_INSERT_LENGTH17\");\n    kani::cover(begin == 1, \"S3_INSERT_BASE_FIRST\");\n    kani::cover(begin == 16, \"S3_INSERT_BASE_LAST\");\n    kani::cover(before[begin + tail] >= before[begin + tail - 1], \"S3_INSERT_EARLY_RETURN\");\n    kani::cover(before[begin + tail] < before[begin], \"S3_INSERT_FULL_SIFT\");\n    kani::cover(before[begin + tail] == before[begin], \"S3_INSERT_DUPLICATE\");\n    kani::cover(v[begin] < v[begin + tail], \"S3_INSERT_NONCONSTANT\");\n    kani::cover(true, \"S3_INSERT_USEFUL_RETURN\");\n}\n\n#[kani::proof_for_contract(bidirectional_merge)]\n#[kani::unwind(12)]\nfn s3_merge8_u8_separate() {\n    kani::assert(active(), \"S3_MERGE8_SEPARATE_ACTIVE\");\n    let src: [u8; 10] = kani::any();\n    kani::assume(ordered(&src[1..5]) && ordered(&src[5..9]));\n    let before = src;\n    let mut dst = [MaybeUninit::<u8>::uninit(); 10];\n    dst[0].write(0xa5); dst[9].write(0x5a);\n    unsafe { bidirectional_merge(&src[1..9], dst.as_mut_ptr().add(1).cast(), &mut KeyLess::<u8>::new()) };\n    let mut out = [0u8; 8];\n    for i in 0..8 { out[i] = unsafe { dst[i + 1].assume_init() }; }\n    kani::assert(post::<u8, KeyLess<u8>>(snapshot::<u8, KeyLess<u8>>(&before[1..9]), &out), \"S3_MERGE8_SEPARATE_SORTED_FULL_COUNT\");\n    kani::assert(src == before, \"S3_MERGE8_SEPARATE_SOURCE_FRAME\");\n    kani::assert(unsafe { dst[0].assume_init() == 0xa5 && dst[9].assume_init() == 0x5a }, \"S3_MERGE8_SEPARATE_CANARIES\");\n    kani::cover(src[1] < src[5], \"S3_MERGE8_SEPARATE_LEFT_FIRST\");\n    kani::cover(src[1] > src[5], \"S3_MERGE8_SEPARATE_RIGHT_FIRST\");\n    kani::cover(src[4] == src[5], \"S3_MERGE8_SEPARATE_TIE\");\n    kani::cover(src[4] > src[5], \"S3_MERGE8_SEPARATE_UNSORTED\");\n    kani::cover(out[0] < out[7], \"S3_MERGE8_SEPARATE_NONCONSTANT\");\n    kani::cover(true, \"S3_MERGE8_SEPARATE_USEFUL_RETURN\");\n}\n\n#[kani::proof_for_contract(bidirectional_merge)]\n#[kani::unwind(50)]\nfn s3_merge8_u8_same_alloc() {\n    kani::assert(active(), \"S3_MERGE8_SAME_ACTIVE\");\n    let before: [u8; 48] = kani::any();\n    let mut v = [MaybeUninit::<u8>::uninit(); 48];\n    let src: usize = kani::any();\n    let dst: usize = kani::any();\n    kani::assume(src <= 40 && dst <= 40);\n    kani::assume(src + 8 <= dst || dst + 8 <= src);\n    kani::assume(ordered(&before[src..src + 4]) && ordered(&before[src + 4..src + 8]));\n    for i in 0..48 {\n        if i < dst || i >= dst + 8 { v[i].write(before[i]); }\n    }\n    let p = v.as_mut_ptr().cast::<u8>();\n    // Only the source range is borrowed. The disjoint destination retains raw provenance.\n    unsafe { bidirectional_merge(slice::from_raw_parts(p.add(src), 8), p.add(dst), &mut KeyLess::<u8>::new()) };\n    let mut out = [0u8; 8];\n    for i in 0..8 { out[i] = unsafe { v[dst+i].assume_init() }; }\n    kani::assert(post::<u8, KeyLess<u8>>(snapshot::<u8, KeyLess<u8>>(&before[src..src + 8]), &out), \"S3_MERGE8_SAME_SORTED_FULL_COUNT\");\n    for i in 0..48 {\n        kani::assert((dst <= i && i < dst + 8) || unsafe { v[i].assume_init() } == before[i], \"S3_MERGE8_SAME_OUTSIDE_FRAME\");\n    }\n    for i in 0..8 {\n        kani::assert(unsafe { v[src+i].assume_init() } == before[src+i], \"S3_MERGE8_SAME_SOURCE_FRAME\");\n    }\n    let canary: usize = kani::any();\n    kani::assume(canary < 48 && (canary < dst || canary >= dst + 8));\n    kani::assert(unsafe { v[canary].assume_init() } == before[canary], \"S3_MERGE8_SAME_CANARY\");\n    kani::cover(src + 8 == dst, \"S3_MERGE8_SAME_FORWARD_ADJACENT\");\n    kani::cover(dst + 8 == src, \"S3_MERGE8_SAME_REVERSE_ADJACENT\");\n    kani::cover(src == 40 && dst == 0, \"S3_MERGE8_SAME_EXTREME\");\n    kani::cover(before[src] < before[src + 4], \"S3_MERGE8_SAME_LEFT_FIRST\");\n    kani::cover(before[src] > before[src + 4], \"S3_MERGE8_SAME_RIGHT_FIRST\");\n    kani::cover(before[src + 3] == before[src + 4], \"S3_MERGE8_SAME_TIE\");\n    kani::cover(before[src + 3] > before[src + 4], \"S3_MERGE8_SAME_UNSORTED\");\n    kani::cover(out[0] < out[7], \"S3_MERGE8_SAME_NONCONSTANT\");\n    kani::cover(src == 32 && dst == 0, \"S3_MERGE8_SAME_SORT8_FIRST_GEOMETRY\");\n    kani::cover(src == 40 && dst == 16, \"S3_MERGE8_SAME_SORT8_SECOND_GEOMETRY\");\n    kani::cover(true, \"S3_MERGE8_SAME_USEFUL_RETURN\");\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/tag_permutation.rs": "//! Bounded permutation checks with distinct identity tags and arbitrary comparison answers.\n//!\n//! Each comparison reads both arguments and chooses a fresh bool. No ordering law is assumed.\n//! Distinct tags track equal payloads separately, and fresh answers include every answer\n//! sequence of a returning comparator. The fixed initial identity order restricts no payload\n//! order; see verify.rs for the whole-element transfer assumption and its limits.\n//! Tag types match the source types without wrappers; a separate root checks dispatch.\n//!\n//! Exactly N outputs, range checks, and an all-ones mask imply that each tag occurs once.\n//! A u64 mask accommodates 32 tags without a full-width shift. The unwind budget also covers\n//! the largest selected route and the tag-check loops.\n\nuse super::super::{\n    MAX_STACK_ARRAY_SIZE, SMALL_SORT_FALLBACK_THRESHOLD, SMALL_SORT_GENERAL_SCRATCH_LEN,\n    SMALL_SORT_GENERAL_THRESHOLD, SMALL_SORT_NETWORK_SCRATCH_LEN, SMALL_SORT_NETWORK_THRESHOLD,\n    StableSmallSortTypeImpl, UnstableSmallSortFreezeTypeImpl, UnstableSmallSortTypeImpl,\n    has_efficient_in_place_swap,\n};\nuse crate::cell::Cell;\nuse crate::mem::size_of;\nuse crate::{kani, ptr};\n\nfn arbitrary_u8_order(a: &u8, b: &u8) -> bool {\n    // SAFETY: the real sort must supply initialized, readable comparator arguments.\n    unsafe {\n        let _ = ptr::read_volatile(a);\n        let _ = ptr::read_volatile(b);\n    }\n    kani::any()\n}\n\n#[cfg(kani_smallsort_controls)]\nfn abort_on_order_violation() -> ! {\n    kani::cover(true, \"order violation panic is reachable\");\n    kani::assume(false);\n    unreachable!()\n}\n\n// The ordinary networks never reach this panic boundary. Keep the cutoff but omit its cover.\nfn abort_without_panic_cover() -> ! {\n    kani::assume(false);\n    unreachable!()\n}\n\nfn check_tags<const N: usize>(tags: &[u64; N]) {\n    assert!(N > 0 && N <= 32);\n    let mut seen = 0u64;\n    for &tag in tags {\n        kani::assert(tag < N as u64, \"output tag is in range\");\n        // Keep the shift defined even on a counterexample with an out-of-range tag.\n        if tag < N as u64 {\n            seen |= 1u64 << tag;\n        }\n    }\n    kani::assert(seen == (1u64 << N) - 1, \"every input tag occurs exactly once\");\n}\n\nfn network_output<const N: usize>() -> [u8; N] {\n    let mut v = crate::array::from_fn(|i| i as u8);\n    <u8 as UnstableSmallSortTypeImpl>::small_sort(&mut v, &mut arbitrary_u8_order);\n    v\n}\n\nfn network_body<const N: usize>() {\n    let v = network_output::<N>();\n    check_tags(&crate::array::from_fn::<_, N, _>(|i| v[i] as u64));\n    kani::cover(true, \"network returns with every tag\");\n}\n\n#[kani::proof]\nfn tag_types_preserve_source_routes() {\n    fn require_freeze_copy<T: crate::slice::sort::shared::FreezeMarker + Copy>() {}\n    require_freeze_copy::<u8>();\n    require_freeze_copy::<u64>();\n\n    // Unstable u8 takes the Freeze+Copy network specialization and its size branch.\n    assert!(size_of::<u8>() == 1);\n    assert!(has_efficient_in_place_swap::<u8>());\n    assert!(size_of::<u8>() * SMALL_SORT_NETWORK_SCRATCH_LEN <= MAX_STACK_ARRAY_SIZE);\n    assert!(<u8 as UnstableSmallSortTypeImpl>::small_sort_threshold() == 32);\n    assert!(\n        <u8 as UnstableSmallSortFreezeTypeImpl>::small_sort_threshold()\n            == SMALL_SORT_NETWORK_THRESHOLD\n    );\n\n    // Stable Freeze u64 always selects general, independently of the swap heuristic.\n    assert!(size_of::<u64>() == 8);\n    assert!(SMALL_SORT_GENERAL_SCRATCH_LEN == 48);\n    assert!(\n        <u64 as StableSmallSortTypeImpl>::small_sort_threshold() == SMALL_SORT_GENERAL_THRESHOLD\n    );\n    assert!(SMALL_SORT_GENERAL_THRESHOLD == 32);\n\n    // The Freeze specialization would return 32: 16 identifies the blanket Stable entry.\n    assert!(\n        <Cell<u8> as StableSmallSortTypeImpl>::small_sort_threshold()\n            == SMALL_SORT_FALLBACK_THRESHOLD\n    );\n    assert!(SMALL_SORT_FALLBACK_THRESHOLD == 16);\n    kani::cover(true, \"tag and source types select the required routes\");\n}\n\n#[kani::proof]\n#[kani::stub(\n    crate::slice::sort::shared::smallsort::panic_on_ord_violation,\n    abort_without_panic_cover\n)]\n#[kani::unwind(34)]\nfn network_u8_n9() {\n    network_body::<9>();\n}\n\n#[kani::proof]\n#[kani::stub(\n    crate::slice::sort::shared::smallsort::panic_on_ord_violation,\n    abort_without_panic_cover\n)]\n#[kani::unwind(34)]\nfn network_u8_n13() {\n    network_body::<13>();\n}\n\n#[cfg(kani_smallsort_controls)]\n#[kani::proof]\n#[kani::stub(\n    crate::slice::sort::shared::smallsort::panic_on_ord_violation,\n    abort_on_order_violation\n)]\n#[kani::unwind(34)]\nfn reject_duplicate_network_u8_n9() {\n    let mut v = network_output::<9>();\n    kani::cover(true, \"duplicate mutant reaches the corruption\");\n    // SAFETY: both pointers name distinct initialized elements of the same live array.\n    // Deliberately lose one identity after the same real sorting call used by the positive root.\n    unsafe { ptr::copy(v.as_ptr(), v.as_mut_ptr().add(1), 1) };\n    check_tags(&crate::array::from_fn::<_, 9, _>(|i| v[i] as u64));\n}\n",
+  "library/core/src/slice/sort/shared/smallsort/verify/types.rs": "//! Logical-value correctness through real trait entries; no contracts or panic paths are stubbed.\n\nuse super::super::{\n    SMALL_SORT_GENERAL_SCRATCH_LEN, StableSmallSortTypeImpl, UnstableSmallSortTypeImpl,\n};\nuse crate::cell::Cell;\nuse crate::kani;\nuse crate::mem::MaybeUninit;\n\ntrait LogicalByte {\n    fn new(value: u8) -> Self;\n    fn value(&self) -> u8;\n}\n\nimpl LogicalByte for Cell<u8> {\n    fn new(value: u8) -> Self {\n        Cell::new(value)\n    }\n\n    fn value(&self) -> u8 {\n        self.get()\n    }\n}\n\n#[repr(transparent)]\nstruct DropKey(u8);\n\nimpl crate::ops::Drop for DropKey {\n    fn drop(&mut self) {}\n}\n\nimpl LogicalByte for DropKey {\n    fn new(value: u8) -> Self {\n        Self(value)\n    }\n\n    fn value(&self) -> u8 {\n        self.0\n    }\n}\n\nfn logical_less<T: LogicalByte>(a: &T, b: &T) -> bool {\n    a.value() < b.value()\n}\n\nfn count(values: &[u8], probe: u8) -> usize {\n    let mut count = 0;\n    for value in values {\n        count += (*value == probe) as usize;\n    }\n    count\n}\n\nfn check_output<const N: usize>(input: &[u8; N], output: &[u8; N], probe: u8) {\n    for i in 1..N {\n        assert!(output[i - 1] <= output[i]);\n    }\n    assert!(count(input, probe) == count(output, probe));\n    kani::cover(true, \"logical sort returns after both assertions\");\n}\n\nfn cover_nontrivial_input<const N: usize>(input: &[u8; N]) {\n    kani::cover(input[0] > input[1], \"logical sort returns from an unsorted input\");\n    kani::cover(input[0] == input[1], \"logical sort returns with duplicate keys\");\n}\n\n// Cell is !Freeze: both trait defaults use insertion or fallback, with threshold 16.\n// DropKey is Freeze and non-Copy: stable and unstable dispatch select general, threshold 32.\nfn trait_properties<T: LogicalByte, const N: usize>() -> [u8; N] {\n    let input: [u8; N] = kani::any();\n    let probe: u8 = kani::any();\n    let mut values: [T; N] = crate::array::from_fn(|i| T::new(input[i]));\n    let stable: bool = kani::any();\n    if stable {\n        let mut scratch = [const { MaybeUninit::<T>::uninit() }; SMALL_SORT_GENERAL_SCRATCH_LEN];\n        <T as StableSmallSortTypeImpl>::small_sort(\n            &mut values,\n            &mut scratch,\n            &mut logical_less::<T>,\n        );\n    } else {\n        <T as UnstableSmallSortTypeImpl>::small_sort(&mut values, &mut logical_less::<T>);\n    }\n    let output = crate::array::from_fn(|i| values[i].value());\n    check_output(&input, &output, probe);\n    kani::cover(stable, \"logical stable trait entry returns\");\n    kani::cover(!stable, \"logical unstable trait entry returns\");\n    input\n}\n\nfn trivial_trait_properties<T: LogicalByte>() {\n    let selector: u8 = kani::any();\n    match selector {\n        0 => {\n            trait_properties::<T, 0>();\n        }\n        1 => {\n            trait_properties::<T, 1>();\n        }\n        _ => cover_nontrivial_input(&trait_properties::<T, 2>()),\n    }\n    kani::cover(selector == 0, \"logical length zero\");\n    kani::cover(selector == 1, \"logical length one\");\n    kani::cover(selector == 2, \"logical length two\");\n}\n\n// The unwind budget covers element construction, sorting, and logical-value count loops.\n// Solver choice is specific to these logical-value models.\nmacro_rules! trait_cases {\n    ($name:ident, $t:ty, [0, 1, 2]) => {\n        #[kani::proof]\n        #[kani::solver(cadical)]\n        #[kani::unwind(50)]\n        fn $name() {\n            trivial_trait_properties::<$t>();\n        }\n    };\n}\n\ntrait_cases!(sorted_permutation_traits_fallback_cell_u8_n0_to2, Cell<u8>, [0, 1, 2]);\ntrait_cases!(sorted_permutation_traits_general_drop_u8_n0_to2, DropKey, [0, 1, 2]);\n\nmacro_rules! fixed_trait_case {\n    ($name:ident, $t:ty, $n:literal) => {\n        #[kani::proof]\n        #[kani::solver(cadical)]\n        #[kani::unwind(50)]\n        fn $name() {\n            cover_nontrivial_input(&trait_properties::<$t, $n>());\n        }\n    };\n}\n\n// A single length keeps solver time within the ordinary budget.\nfixed_trait_case!(sorted_permutation_traits_fallback_cell_u8_n7, Cell<u8>, 7);\n\nfixed_trait_case!(sorted_permutation_traits_general_drop_u8_n8, DropKey, 8);\n\n// Fixed routes check each Cell branch independently.\n// The two const values cover both dispatch choices without restricting keys.\nfn fixed_route_trait_properties<T: LogicalByte, const N: usize, const STABLE: bool>() {\n    let input: [u8; N] = kani::any();\n    let probe: u8 = kani::any();\n    let mut values: [T; N] = crate::array::from_fn(|i| T::new(input[i]));\n    if STABLE {\n        let mut scratch = [const { MaybeUninit::<T>::uninit() }; SMALL_SORT_GENERAL_SCRATCH_LEN];\n        <T as StableSmallSortTypeImpl>::small_sort(\n            &mut values,\n            &mut scratch,\n            &mut logical_less::<T>,\n        );\n    } else {\n        <T as UnstableSmallSortTypeImpl>::small_sort(&mut values, &mut logical_less::<T>);\n    }\n    let output = crate::array::from_fn(|i| values[i].value());\n    check_output(&input, &output, probe);\n    cover_nontrivial_input(&input);\n}\n\nmacro_rules! fixed_route_trait_case {\n    ($name:ident, $t:ty, $n:literal, $stable:literal) => {\n        #[kani::proof]\n        #[kani::solver(cadical)]\n        #[kani::unwind(50)]\n        fn $name() {\n            fixed_route_trait_properties::<$t, $n, $stable>();\n            // Emit only the selected route's cover; the opposite const branch cannot return.\n            kani::cover(true, concat!(\"logical fixed trait entry returns: stable=\", $stable));\n        }\n    };\n}\n\nfixed_route_trait_case!(sorted_permutation_traits_stable_fallback_cell_u8_n8, Cell<u8>, 8, true);\nfixed_route_trait_case!(sorted_permutation_traits_unstable_fallback_cell_u8_n8, Cell<u8>, 8, false);\n",
+  "tool_config/kani-version.toml": "# This version should be updated whenever there is a change that makes this version of kani\n# incompatible with the verify-std repo.\n\n[kani]\ncommit = \"0aac16ef62da9e9d5645782d458593e5d78143ba\"\n"
+}

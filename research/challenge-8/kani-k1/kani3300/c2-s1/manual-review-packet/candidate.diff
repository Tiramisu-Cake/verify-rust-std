+    unsafe {
+        (*pointer).write(23);
+    }
+}
+
+#[inline(never)]
+unsafe fn read_source(pointer: *const MaybeUninit<u8>) -> u8 {
+    unsafe { (*pointer).assume_init() }
+}
+
+// Return the shadow-carrying slot directly; report the repaired source through
+// an ordinary u8 out-pointer, avoiding a nested aggregate return.
+#[custom_mir(dialect = "runtime", phase = "optimized")]
+unsafe fn handoff(source: MaybeUninit<u8>, reinit: bool, observed_out: *mut u8) -> MaybeUninit<u8> {
+    mir! {
+        type RET = MaybeUninit<u8>;
+        let pointer: *mut MaybeUninit<u8>;
+        let returned: MaybeUninit<u8>;
+        let observed: u8;
+        let _unit: ();
+        {
+            pointer = std::ptr::addr_of_mut!(source);
+            Call(returned = relay(Move(source)), ReturnTo(after_return), UnwindUnreachable())
+        }
+        after_return = {
+            match reinit { true => do_repair, _ => do_read }
+        }
+        do_repair = {
+            Call(_unit = repair(pointer), ReturnTo(do_read), UnwindUnreachable())
+        }
+        do_read = {
+            Call(observed = read_source(pointer), ReturnTo(done), UnwindUnreachable())
+        }
+        done = {
+            *observed_out = observed;
+            RET = Move(returned);
+            Return()
+        }
+    }
+}
+
+#[kani::proof]
+fn top_level_move_return_reinit_legal() {
+    let mut source = 0u8;
+    let returned = unsafe { handoff(MaybeUninit::new(42), true, &raw mut source) };
+    assert_eq!(unsafe { returned.assume_init() }, 42);
+    assert_eq!(source, 23);
+}
+
+#[kani::proof]
+fn top_level_move_return_source_hole() {
+    let mut source = 0u8;
+    let returned = unsafe { handoff(MaybeUninit::new(42), false, &raw mut source) };
+    assert_eq!(unsafe { returned.assume_init() }, 42);
+}

+        data.write(7);
+        data.add(1).write(0);
+        data.add(2).write(9);
+        // All three payload bytes are initialized before borrowing the flat stack array.
+        let stack = &storage;
+        let promoted: &'static [MaybeUninit<u8>; 3] = &PROMOTED;
+        let _equal = raw_eq(promoted, stack);
+    }
+}

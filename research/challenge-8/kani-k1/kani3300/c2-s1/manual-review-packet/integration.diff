+
+#![feature(fn_traits)]
+
+fn identity(value: u8) -> u8 {
+    value
+}
+
+// A non-shadow function-item Fn-trait call is a positive generated-body probe.
+// Actual instance kind/body and property reachability require pinned CI MIR binding.

+        #[kani::loop_modifies(&n)]
+        while n > 0 { n -= 1; },
+        false =>
+        #[kani::loop_modifies(&n)]
+        #[kani::loop_invariant(n <= 3)]
+        #[kani::loop_decreases(n)]
+        while n > 0 { n -= 1; },
+    }
+    n
+}

+struct DropCounter<'a>(&'a std::cell::Cell<u8>);
+impl Drop for DropCounter<'_> {
+    fn drop(&mut self) {
+        self.0.set(self.0.get() + 1);
+    }
+}
+
+// A copy intrinsic creates a delayed-UB analysis target without introducing UB.
+#[inline(never)]
+fn seed() {
+    let source = 7u8;

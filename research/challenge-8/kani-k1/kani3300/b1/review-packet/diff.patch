+
+#[inline(never)]
+fn indirect(f: fn(*mut c_void), pointer: *mut c_void) {
+    f(pointer);
+}
+
+#[kani::proof]
+fn check() {
+    let mut value = 0u8;
+    // c_void and u8 have the same one-byte data layout; erasure itself adds no seed.
+    indirect(write, (&raw mut value).cast());
+    assert_eq!(value, 7);

+                   "rss": {"status": "OBSERVED_WAIT4_LINUX_RU_MAXRSS", "max_bytes": 1}}
+        self.assertEqual(root_exit_code(receipt), 0)
+
+    def test_unknown_rss_makes_receipt_nonzero(self):

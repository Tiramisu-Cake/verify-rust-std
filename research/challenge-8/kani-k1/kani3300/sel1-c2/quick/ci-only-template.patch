+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+name: SEL1-C2 Quick (UNBOUND TEMPLATE)
+on:
+  workflow_dispatch:
+
+defaults:
+  run:
+    working-directory: control
+
+env:
+  SEL1_C2_SOURCE_DIR: ${{ github.workspace }}/export
+  C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+  RUST_BACKTRACE: 1
+  KANI_FAIL_ON_UNEXPECTED_DESCRIPTION: "true"
+  RUST_TEST_THREADS: 2
+
+jobs:
+  uninit:
+    if: ${{ false && github.repository == 'Tiramisu-Cake/kani' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    permissions:
+      contents: read
+    steps:
+      - name: Checkout exact overlay
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ github.sha }}
+          path: control
+          persist-credentials: false
+          fetch-depth: 3
+
+      - name: Independent exact candidate checkout
+        uses: actions/checkout@v6
+        with:
+          ref: PENDING_SEL1_FREEZE_SHA
+          path: export
+          persist-credentials: false
+
+      - name: Source identities before
+        id: source_guard
+        run: python3 .github/c2-slices/slice07_ci.py before
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Setup Kani Dependencies
+        uses: ./export/.github/actions/setup
+        with:
+          os: ubuntu-24.04
+          kani_dir: export
+
+      - name: Format check
+        run: python3 .github/c2-slices/slice07_ci.py fmt
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Build Kani
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py build
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Clippy workspace and tests (-D warnings)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py clippy
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: ActiveCalls units (exactly 9)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Immutable allocations units (exactly 9)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py immutable-units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Argument size unit (exactly 1)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py argument-size-units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Marker category unit (exactly 1)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py marker-category-units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Delayed cache units (exactly 6)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py delayed-cache-units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Delayed scope units (exactly 2)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py delayed-scope-units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: All compiler units (exactly 76, includes relevant28)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py compiler-all-units
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Cumulative Quick and stage 7 manifest (500 unique selectors including all 29 select controls)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py suites
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: S5 sensitivity mutations (4 independent intended golden failures)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py sensitivity
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: C2-S4 fresh mixed versus isolated (18 exact comparisons)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py structural
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Build affected optional LLBC path (after default-backend controls)
+        if: ${{ !cancelled() && steps.source_guard.outcome == 'success' }}
+        run: python3 .github/c2-slices/slice07_ci.py llbc-build
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Source identities after
+        if: ${{ always() }}
+        run: python3 .github/c2-slices/slice07_ci.py after
+        env:
+          C2_EVIDENCE_DIR: ${{ runner.temp }}/sel1-c2-quick-evidence
+
+      - name: Upload native outputs, original exits and identities
+        if: ${{ always() }}
+        uses: actions/upload-artifact@v4
+        with:
+          name: c2-slices-07-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/sel1-c2-quick-evidence/
+          if-no-files-found: error
+          retention-days: 14

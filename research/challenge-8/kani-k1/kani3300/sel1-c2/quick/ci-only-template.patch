+      "expected_mismatch_reason": "unchanged native N=0 cannot satisfy consecutive SUMMARY / ** 1 of sanity mutant",
+      "git_apply_check": "PASS",
+      "id": "golden-invert-required-count",
+      "input": "tests/expected/uninit/private-transfer-frame/lawful-modifies.rs",
+      "input_sha256": "3c69a644f3542e6cdd941deb81a355068c68e7de7b62e71aef94371d16e94861",
+      "mutated_path": "tests/expected/uninit/private-transfer-frame/lawful-modifies.expected",
+      "native_result_status": "NOT_RUN: CI-only per owner",
+      "normal_native_N": 0,
+      "observed_compiletest_exit": "NOT_RUN",
+      "observed_native_N": null,
+      "observed_native_verdict": "NOT_RUN",
+      "original_failure_retained": null,
+      "patch": "sensitivity/golden-invert-required-count.patch",
+      "patch_sha256": "9c07ed2c6e46f423aa81785a0ac1aeb99aac95f57d108a22b911b1f8feca4684",
+      "predicted_compiletest_exit": 1,
+      "predicted_native_N": 0,

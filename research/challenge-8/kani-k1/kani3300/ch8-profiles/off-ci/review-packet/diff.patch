+                                      "unreachable": [], "undetermined": [], "error": [], "unknown": [], "other": []},
+                           "covers": {"total": 2, "satisfied": ["cover-A", "cover-B"],
+                                      "unsatisfiable": [], "unreachable": [], "undetermined": [],
+                                      "error": [], "unknown": [], "other": []}}]}

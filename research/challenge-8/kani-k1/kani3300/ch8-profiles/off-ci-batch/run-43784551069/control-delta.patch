@@ -15,0 +16 @@ from pathlib import Path
+import re
@@ -537,0 +539,14 @@ def execute(argv: list[str], cwd: Path, out: Path, timeout: int,
+def _profile_target_matches(value: Any, expected: str) -> bool:
+    """Match the frozen profile's terminal identifier, preserving Rust tokens.
+
+    Macro TokenStream formatting inserts whitespace around ::. A local
+    proof_for_contract attribute may also name an unqualified function.
+    Do not merge identifiers or treat an arbitrary text suffix as a path.
+    This is a stage check, not independent resolution of the contracted symbol.
+    """
+    if not isinstance(value, str) or re.fullmatch(
+            r"\s*[A-Za-z_][A-Za-z_0-9]*(?:\s*::\s*[A-Za-z_][A-Za-z_0-9]*)*\s*", value) is None:
+        return False
+    return value.split("::")[-1].strip() == expected
+
+

+def row(**updates):
+    value = {"id": "synthetic", "selector": "slice::sort::root", "mode": "PFC",
+             "variant": "production", "cfg": [], "unwind": 4, "expected": "SUCCESS",
+             "failure_description": "expected semantic failure", "required_cover_count": 2,
+             "timeout_seconds": 30}
+    value.update(updates)
+    return value

{
  "schema": "ch8-unreachable-role-rules-v3",
  "rules": [
    {
      "id": "required-postcondition",
      "function": ".*smallsort.*",
      "file": "library/core/src/slice/sort/shared/smallsort(?:/.*|\\.rs)",
      "lines": null,
      "property_id": ".*",
      "description": "(?i).*(?:postcondition).*",
      "role": "postcondition",
      "reason": "Explicit mandatory target/wrapper obligation; it must execute in the declared scenario.",
      "target_wrapper_relation": "REQUIRED_TARGET_WRAPPER_OBLIGATION"
    },
    {
      "id": "required-frame",
      "function": ".*smallsort.*",
      "file": "library/core/src/slice/sort/shared/smallsort(?:/.*|\\.rs)",
      "lines": null,
      "property_id": ".*",
      "description": "(?i).*(?:frame|modifies|assigns).*",
      "role": "frame",
      "reason": "Explicit mandatory target/wrapper obligation; it must execute in the declared scenario.",
      "target_wrapper_relation": "REQUIRED_TARGET_WRAPPER_OBLIGATION"
    },
    {
      "id": "required-relation",
      "function": ".*smallsort.*",
      "file": "library/core/src/slice/sort/shared/smallsort(?:/.*|\\.rs)",
      "lines": null,
      "property_id": ".*",
      "description": "(?i).*(?:relation assertion).*",
      "role": "relation",
      "reason": "Explicit mandatory target/wrapper obligation; it must execute in the declared scenario.",
      "target_wrapper_relation": "REQUIRED_TARGET_WRAPPER_OBLIGATION"
    },
    {
      "id": "required-required_section",
      "function": ".*smallsort.*",
      "file": "library/core/src/slice/sort/shared/smallsort(?:/.*|\\.rs)",
      "lines": null,
      "property_id": ".*",
      "description": "(?i).*(?:required section).*",
      "role": "required_section",
      "reason": "Explicit mandatory target/wrapper obligation; it must execute in the declared scenario.",
      "target_wrapper_relation": "REQUIRED_TARGET_WRAPPER_OBLIGATION"
    },
    {
      "id": "fmt-static-shift",
      "function": "fmt::Arguments::<'_>::from_str",
      "file": "library/core/src/fmt/mod\\.rs",
      "lines": [
        820
      ],
      "property_id": ".*\\.assertion\\.[1-9][0-9]*",
      "description": "attempt\\ to\\ shift\\ left\\ with\\ overflow",
      "role": "defensive_branch",
      "reason": "Formatting error guard, not a sorting/frame/relation obligation. Static panic messages use shift count 1; no invalid shift is in the declared bounded scenario.",
      "target_wrapper_relation": "LIBRARY_FORMATTING_GUARD_OUTSIDE_REQUIRED_SCENARIO"
    },
    {
      "id": "alignment-sub",
      "function": "ptr::const_ptr::<impl \\*const \\(\\)>::is_aligned_to",
      "file": "library/core/src/ptr/const_ptr\\.rs",
      "lines": [
        1479
      ],
      "property_id": ".*\\.assertion\\.[1-9][0-9]*",
      "description": "attempt\\ to\\ subtract\\ with\\ overflow",
      "role": "defensive_branch",
      "reason": "align - 1 follows the power-of-two check, which excludes zero; unreachable subtraction-error branch is defensive.",
      "target_wrapper_relation": "LIBRARY_ARITHMETIC_GUARD"
    },
    {
      "id": "usize-abs-diff",
      "function": "num::<impl usize>::abs_diff",
      "file": "library/core/src/num/uint_macros\\.rs",
      "lines": [

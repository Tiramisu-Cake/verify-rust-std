      "lines": [
        148
      ],
      "property_id": ".*\\.assertion\\.[1-9][0-9]*",
      "description": "attempt\\ to\\ divide\\ by\\ zero",
      "role": "defensive_branch",
      "reason": "size == 0 selects usize::MAX; division is in the nonzero arm. The actual validity result/check is not exempted.",
      "target_wrapper_relation": "LIBRARY_ARITHMETIC_GUARD"
    },
    {
      "id": "model-sorted-index",

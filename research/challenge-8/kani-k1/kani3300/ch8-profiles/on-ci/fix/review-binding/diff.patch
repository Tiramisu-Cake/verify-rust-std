+    depth, start = 1, len(prefix)
+    for i in range(start, len(tail)):
+        if tail[i] == '(':
+            depth += 1
+        elif tail[i] == ')':
+            depth -= 1
+            if depth == 0:
+                require(tail[i + 1:i + 2] == ']', 'SOURCE_CLAUSE_END_MISMATCH')
+                return tail[start:i]
+    raise ValueError('SOURCE_CLAUSE_INCOMPLETE')

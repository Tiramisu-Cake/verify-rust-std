+        ptr::addr_of_mut!((*source.as_mut_ptr()).pointer).write(pointer);
+    }
+    let destination = source;
+    unsafe {
+        assert_eq!((*destination.as_ptr()).prefix, 11);
+        let actual = ptr::addr_of!((*destination.as_ptr()).pointer).read();
+        assert_eq!(actual.len(), 3);

+
+// NonNull<[u8]> contains a wide-pointer RigidTy::Pat, whose layout is arbitrary,
+// so this exercises the recursive Pat branch rather than the scalar shortcut.
+#[repr(C)]
+struct NestedPat {
+    prefix: u8,

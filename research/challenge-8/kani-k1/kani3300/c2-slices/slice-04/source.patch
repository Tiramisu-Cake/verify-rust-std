@@ -0,0 +1,33 @@
+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// compile-flags: --edition 2021 -D warnings
+// kani-flags: -Z uninit-checks --output-format=regular
+
+#![feature(core_intrinsics)]
+#![allow(internal_features)]
+
+use std::intrinsics::raw_eq;
+use std::mem::MaybeUninit;
+
+// This borrows a const item rather than a named static.
+const PROMOTED: [MaybeUninit<u8>; 3] =
+    [MaybeUninit::uninit(), MaybeUninit::new(0u8), MaybeUninit::new(9u8)];
+
+// Required: tracked flat stack array and anonymous immutable referent.
+// The raw comparison checks initialization on both stack and immutable operands.
+// Only the promoted left raw_eq byte read may fail; the stack check must succeed.
+// MaybeUninit references are valid; no hole is converted to a typed u8 value.
+#[kani::proof]
+fn mixed_raw_mu_promoted_left_hole() {
+    let mut storage = [MaybeUninit::<u8>::uninit(); 3];
+    let data = storage.as_mut_ptr().cast::<u8>();
+    unsafe {
+        data.write(7);
+        data.add(1).write(0);
+        data.add(2).write(9);
+        // All three payload bytes are initialized before borrowing the flat stack array.
+        let stack = &storage;
+        let promoted: &'static [MaybeUninit<u8>; 3] = &PROMOTED;
+        let _equal = raw_eq(promoted, stack);
+    }
+}

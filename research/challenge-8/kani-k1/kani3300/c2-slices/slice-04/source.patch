+// Only this subrange origin is used at runtime: offset 1, extent 3, allocation size 4.
+const SUBRANGE: &[MaybeUninit<u8>; 3] =
+    unsafe { &*ALLOCATION.as_ptr().add(1).cast::<[MaybeUninit<u8>; 3]>() };

@@ -0,0 +1,136 @@
+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+name: KANI3300 D1-P diagnostic (no SAT)
+'on':
+  workflow_dispatch:
+    inputs:
+      r1_ci:
+        description: Exact D1-P CI-only commit above R1+skip
+        type: string
+        required: true
+      r6b_ci:
+        description: Exact D1-P CI-only commit above R6-02b
+        type: string
+        required: true
+concurrency:
+  group: kani3300-d1p-one-real-cbmc
+  cancel-in-progress: false
+jobs:
+  r1-skip:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    permissions:
+      contents: read
+    steps:
+    - name: Checkout exact CI-only commit
+      uses: actions/checkout@v6
+      with:
+        ref: ${{ inputs.r1_ci }}
+        fetch-depth: 2
+    - name: Identity and allowlist
+      id: identity
+      run: python3 diagnostics/kani3300-d1p/runner.py identity --pin r1-skip
+    - name: Bounded existing setup recipe
+      id: setup
+      run: python3 diagnostics/kani3300-d1p/runner.py setup --pin r1-skip
+    - name: Bounded build
+      id: build
+      run: python3 diagnostics/kani3300-d1p/runner.py build --pin r1-skip
+    - name: P1 DFCC and symex only
+      id: capture
+      run: python3 diagnostics/kani3300-d1p/runner.py cases --pin r1-skip
+    - name: Artifact manifest and phase status
+      if: ${{ always() }}
+      id: manifest
+      env:
+        D1P_SETUP: ${{ steps.setup.outcome }}
+        D1P_BUILD: ${{ steps.build.outcome }}
+        D1P_CAPTURE: ${{ steps.capture.outcome }}
+      run: python3 diagnostics/kani3300-d1p/runner.py finalize --pin r1-skip
+    - name: Upload bounded evidence
+      if: ${{ always() }}
+      id: upload
+      uses: actions/upload-artifact@v4
+      with:
+        name: d1p-r1-skip-${{ github.run_id }}-${{ github.run_attempt }}
+        path: d1p-artifacts/
+        if-no-files-found: error
+        retention-days: 14
+    - name: Record upload outcome
+      if: ${{ always() }}
+      env:
+        D1P_UPLOAD: ${{ steps.upload.outcome }}
+      run: |-
+        python3 - <<'PY'
+        import json, os
+        from pathlib import Path
+        Path('d1p-upload.json').write_text(json.dumps({'upload':os.environ['D1P_UPLOAD'], 'verification':'NOT_RUN'})+'\n')
+        PY
+    - name: Upload outcome receipt
+      if: ${{ always() }}
+      uses: actions/upload-artifact@v4
+      with:
+        name: d1p-r1-skip-upload-status-${{ github.run_id }}-${{ github.run_attempt }}
+        path: d1p-upload.json
+        if-no-files-found: error
+        retention-days: 14
+  r6b:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    permissions:
+      contents: read
+    steps:
+    - name: Checkout exact CI-only commit
+      uses: actions/checkout@v6
+      with:
+        ref: ${{ inputs.r6b_ci }}
+        fetch-depth: 2
+    - name: Identity and allowlist
+      id: identity
+      run: python3 diagnostics/kani3300-d1p/runner.py identity --pin r6b
+    - name: Bounded existing setup recipe
+      id: setup
+      run: python3 diagnostics/kani3300-d1p/runner.py setup --pin r6b
+    - name: Bounded build
+      id: build
+      run: python3 diagnostics/kani3300-d1p/runner.py build --pin r6b
+    - name: P1 DFCC and symex only
+      id: capture
+      run: python3 diagnostics/kani3300-d1p/runner.py cases --pin r6b
+    - name: Artifact manifest and phase status
+      if: ${{ always() }}
+      id: manifest
+      env:
+        D1P_SETUP: ${{ steps.setup.outcome }}
+        D1P_BUILD: ${{ steps.build.outcome }}
+        D1P_CAPTURE: ${{ steps.capture.outcome }}
+      run: python3 diagnostics/kani3300-d1p/runner.py finalize --pin r6b
+    - name: Upload bounded evidence
+      if: ${{ always() }}
+      id: upload
+      uses: actions/upload-artifact@v4
+      with:
+        name: d1p-r6b-${{ github.run_id }}-${{ github.run_attempt }}
+        path: d1p-artifacts/
+        if-no-files-found: error
+        retention-days: 14
+    - name: Record upload outcome
+      if: ${{ always() }}
+      env:
+        D1P_UPLOAD: ${{ steps.upload.outcome }}
+      run: |-
+        python3 - <<'PY'
+        import json, os
+        from pathlib import Path
+        Path('d1p-upload.json').write_text(json.dumps({'upload':os.environ['D1P_UPLOAD'], 'verification':'NOT_RUN'})+'\n')
+        PY
+    - name: Upload outcome receipt
+      if: ${{ always() }}
+      uses: actions/upload-artifact@v4
+      with:
+        name: d1p-r6b-upload-status-${{ github.run_id }}-${{ github.run_attempt }}
+        path: d1p-upload.json
+        if-no-files-found: error
+        retention-days: 14
+    needs: r1-skip
+    if: ${{ always() && !cancelled() }}

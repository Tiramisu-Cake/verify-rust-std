+    std::hint::black_box(std::ptr::addr_of!(value));
+}
+
+#[kani::proof]
+fn storage_enum_is_unsupported() {
+    let value = StorageEnum::Full([MaybeUninit::new(5), MaybeUninit::uninit()]);

+          PY
+      - name: Resolve pinned source
+        id: pin
+        working-directory: control
+        run: |
+          python3 - <<'PY'
+          import json, os
+          req=json.load(open('CI-REQUEST.json'))
+          arm=os.environ['ARM']
+          sha=req['pins']['pr02' if arm == 'A' else 'sel1']['sha']

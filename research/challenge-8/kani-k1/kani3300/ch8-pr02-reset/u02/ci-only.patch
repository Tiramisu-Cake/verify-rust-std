+          PY
+        env:
+          ARM: ${{ matrix.arm }}
+      - name: Checkout pinned source
+        id: source
+        uses: actions/checkout@v6
+        with:
+          ref: ${{ steps.pin.outputs.sha }}
+          path: source
+          fetch-depth: 2
+          persist-credentials: false
+      - name: Checkout unpatched old PR-02 control
+        id: old
+        if: ${{ matrix.arm == 'A' }}

@@ -0,0 +1,166 @@
+name: CH8 PR-02 automatic harness entry reset
+'on':
+  push:
+    branches:
+      - uninit-ci/ch8-pr02-reset-*
+permissions:
+  contents: read
+concurrency:
+  group: ch8-pr02-reset
+  cancel-in-progress: false
+jobs:
+  reset:
+    if: ${{ github.repository == 'Tiramisu-Cake/kani' && startsWith(github.ref, 'refs/heads/uninit-ci/ch8-pr02-reset-') }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    env:
+      CARGO_BUILD_JOBS: '2'
+      RUST_TEST_THREADS: '2'
+    strategy:
+      fail-fast: false
+      max-parallel: 1
+      matrix:
+        arm: [A]
+    steps:
+      - name: Checkout exact CI control
+        id: checkout
+        uses: actions/checkout@v6

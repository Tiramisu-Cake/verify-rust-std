+            span=s.closure_span(source,root)
+            line=source.splitlines()[span['start_line']-1]
+            self.assertEqual(line[span['start_column']-1:span['end_column']-1],span['text'])
+            self.assertEqual(span['text'],'|a: &u8, b: &u8|')

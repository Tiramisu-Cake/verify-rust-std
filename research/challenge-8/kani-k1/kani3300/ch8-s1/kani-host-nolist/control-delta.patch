+    def test_batch_errors_preserve_execution_and_stop_remaining(self):
+        import copy
+        fp={'required_hashes_present':True,'binaries':{},'reported_versions':{}}
+        base={'original_exit_code':0,'signal':None,'timed_out':False,
+              'elapsed_seconds':0.01,'rss_peak_kib':1,'stdout_bytes':8,'stderr_bytes':8}
+        for name in ('success','exit','signal','timeout','rss_cap','external_signal','missing','partial','null','wrong_type','not_run','wrong_target','exception','fingerprint'):
+            with self.subTest(name=name), tempfile.TemporaryDirectory() as d:
+                root=Path(d);std=root/'std';std.mkdir();tool=root/'tool';out=root/'out'
+                rows=[row(id='first'),row(id='second')]
+                ready_warmup(out,std,tool,rows)
+                request={'rows':rows,'changed_file_sha256':{},'variants':{},
+                         'source_bindings':{r['id']:binding(r) for r in rows}}
+                def execute(argv,cwd,dest,timeout,**kw):
+                    self.assertTrue(kw['capture_tail']);self.assertEqual(timeout,30)
+                    self.assertFalse(kw['export_path'].exists())
+                    (dest/'stdout.log').write_text('HEADTAIL');(dest/'stderr.log').write_text('HEADTAIL')
+                    if name=='exception':raise OSError('synthetic execution exception')
+                    v=copy.deepcopy(export())
+                    if name=='not_run':v['harnesses'][0]['outcome']={'kind':'NOT_RUN'}
+                    if name=='wrong_target':v['harnesses'][0]['attributes']['kind']['ProofForContract']['target_fn']='wrong'
+                    if name!='missing':
+                        text='{' if name=='partial' else 'null' if name=='null' else '[]' if name=='wrong_type' else json.dumps(v)
+                        kw['export_path'].write_text(text)
+                    result=base.copy()
+                    if name=='exit':result['original_exit_code']=42
+                    if name=='signal':result.update(original_exit_code=-15,signal=15)
+                    if name in ('timeout','rss_cap','external_signal'):result.update(original_exit_code=-15,termination_reason=name,timed_out=name=='timeout')
+                    return result
+                # A stale valid export must be removed before every invocation.
+                (out/'first').mkdir();(out/'first/export.json').write_text(json.dumps(export()))
+                with mock.patch.object(runner,'verify_source',return_value={}), \
+                     mock.patch.object(runner,'binary_fingerprints',return_value={**fp,'required_hashes_present':name!='fingerprint'}), \
+                     mock.patch.object(runner,'execute',side_effect=execute) as call:
+                    code=runner.run_rows(std,tool,out,request)
+                receipt=json.loads((out/'first/receipt.json').read_text())

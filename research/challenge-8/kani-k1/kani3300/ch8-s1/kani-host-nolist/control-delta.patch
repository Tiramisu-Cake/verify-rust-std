+                self.assertEqual(receipt['stdout']['head'],'HEADTAIL')
+                self.assertEqual(receipt['stderr']['head'],'HEADTAIL')
+                if name=='exit':self.assertEqual(receipt['original_exit'],42)
+                if name=='signal':self.assertEqual(receipt['signal'],15)
+                if name=='exception':self.assertIn('synthetic execution exception',receipt['reason'])
+                if name in ('signal','timeout','rss_cap','external_signal','missing','partial','null','wrong_type','wrong_target','exception'):
+                    self.assertEqual(call.call_count,1)
+                    self.assertEqual(json.loads((out/'second/receipt.json').read_text())['status'],'NOT_RUN')

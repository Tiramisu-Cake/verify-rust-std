+    def poll(self, elapsed: float, state: dict[str, Any]) -> bool:
+        if self.receipt["state"] != "IN_PROGRESS":
+            return False
+        if elapsed >= self.seconds:
+            return True
+        try:
+            if self.export.stat().st_size > EXPORT_CAP_BYTES:

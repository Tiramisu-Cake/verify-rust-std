+            self.assertEqual(observed['original_exit_code'],42)
+            self.assertEqual(observed['status'],'INTERRUPTED')
+            self.assertEqual(collect.collect([out],request)['proof_credit'],'NONE')
+            for raw in ['null','[]','{']:
+                (out/'receipt.json').write_text(raw)

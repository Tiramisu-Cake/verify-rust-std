+        self.assertEqual(sum(r['expected']=='SUCCESS' for r in rows), 5)
+        self.assertEqual({tuple(r['flags']) for r in rows}, {('-Z','valid-value-checks'),('-Z','function-contracts','-Z','uninit-checks')})

        "def run_campaign(std,tool,out,request,invoker=None,clock=time.monotonic):",
        "    p.validate(request)",
        "    if out.is_symlink():raise GlobalFailure('campaign output root symlink')",
        "    out=out.resolve();out.mkdir(parents=True,exist_ok=True)",
        "    if (out/'campaign-start.json').exists() or (out/'completed').exists():raise GlobalFailure('campaign retry/resume forbidden')",
        "    if any(x.name!='setup' or x.is_symlink() or not x.is_dir() for x in out.iterdir()):",
        "        raise GlobalFailure('campaign requires fresh prefix except declared setup receipts')",
        "    start=clock();request_hash=r.sha256(r.REQUEST_PATH);stop=None",
        "    atomic(out/'campaign-start.json',{'request_sha256':request_hash,'start_monotonic':start,'caps':p.CAPS,'selected':list(p.ORDER),",
        "                                    'pid':os.getpid(),'profile':p.PROFILE,'identity':identity(request),'request_data':request,'proof_credit':'NONE'})",
        "    baseline_context={'campaign_id':uuid.uuid4().hex,'request_sha256':request_hash,'source_parent':request['source_parent'],'control_parent':request['control_parent']}",
        "    baseline=snapshots.capture(std,tool,request,baseline_context,'E0')",
        "    atomic(out/'baseline.json',baseline)",
        "    try:",
        "        if baseline['state']!='COMPLETE':raise GlobalFailure('baseline_snapshot_incomplete')",
        "        for index,rid in enumerate(p.ORDER):",
        "            if r.sha256(r.REQUEST_PATH)!=request_hash:raise GlobalFailure('request drift')",
        "            sealed(out)",
        "            if p.CAPS['campaign_seconds']-(clock()-start) < (len(p.ORDER)-index)*p.CAPS['slot_seconds']+p.CAPS['cleanup_seconds']:",
        "                raise GlobalFailure('global_budget_reserved_slots_no_reset')",
        "            limits=check_usage(out)",
        "            context={'campaign_id':baseline_context['campaign_id'],'invocation_id':uuid.uuid4().hex,'root':rid,",
        "                     'rank':index+1,'epoch':'E'+str(index+1),'request_sha256':request_hash,",
        "                     'source_parent':request['source_parent'],'control_parent':request['control_parent'],",
        "                     'baseline_context':baseline_context}",
        "            atomic(out/'workers'/(rid+'-launch.json'),{'id':rid,'rank':index+1,'selector':group(request,rid)['rows'][0]['selector'],",
        "                'monotonic':clock(),'request_sha256':request_hash,'limits':limits,'slot_seconds':p.CAPS['slot_seconds'],'context':context})",
        "            pre=snapshots.capture(std,tool,request,context,context['epoch']+'.pre')",

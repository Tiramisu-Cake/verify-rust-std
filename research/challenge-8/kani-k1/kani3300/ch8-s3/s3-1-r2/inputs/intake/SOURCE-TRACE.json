        "def root_outcome(out,request,rid,supervision):",
        "    record_supervision(out,rid,supervision)",
        "    gp=out/'groups'/('s3-'+rid)/'receipt.json'",
        "    doc=read(gp) if gp.exists() else {}",
        "    if doc.get('source_stage_target_binding_error'):",
        "        raise GlobalFailure('worker source/stage/target binding error')",
        "    life=read(out/'workers'/(rid+'-lifecycle.json'))",
        "    snapshots.validate_pair(read(out/'baseline.json'),life.get('pre'),life.get('post'),life['context'])",
        "    if life.get('supervision')!=supervision:raise GlobalFailure('lifecycle/supervision mismatch')",
        "    launch=read(out/'workers'/(rid+'-launch.json'))",
        "    if life['context']!=launch['context']:raise GlobalFailure('lifecycle launch context mismatch')",
        "    if (life['context'].get('root')!=rid or life['context'].get('rank')!=p.ORDER.index(rid)+1",
        "        or life['context'].get('source_parent')!=request['source_parent']",
        "        or life['context'].get('control_parent')!=request['control_parent']):",
        "        raise GlobalFailure('lifecycle root/rank/parent mismatch')",
        "    if life['context']['request_sha256']!=r.sha256(r.REQUEST_PATH):raise GlobalFailure('lifecycle request drift')",
        "    try:",
        "        protected=evidence.protected(doc,request,read(out/'baseline.json'),supervision,r.sha256(r.REQUEST_PATH))",
        "        evidence.provenance(doc,read(gp.parent/'compile/receipt.json'),request,rid,r.sha256(r.REQUEST_PATH))",

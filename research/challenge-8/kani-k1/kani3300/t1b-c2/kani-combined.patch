+fn mark_range(
+    mask: &mut [bool],
+    offset: usize,
+    size: usize,
+    ty: Ty,
+) -> Result<(), LayoutComputationError> {
+    let Some(end) = offset.checked_add(size) else {
+        return Err(LayoutComputationError::CompoundStorage(ty));
+    };
+    if end > mask.len() {
+        return Err(LayoutComputationError::CompoundStorage(ty));
+    }
+    for byte in &mut mask[offset..end] {
+        if *byte {
+            return Err(LayoutComputationError::CompoundStorage(ty));
+        }
+        *byte = true;
+    }
+    Ok(())
+}

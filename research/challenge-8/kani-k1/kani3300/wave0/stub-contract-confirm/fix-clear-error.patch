diff --git a/tests/ui/ordinary-stub-contract/main.rs b/tests/ui/ordinary-stub-contract/main.rs
new file mode 100644
--- /dev/null
+++ b/tests/ui/ordinary-stub-contract/main.rs
@@ -0,0 +1,21 @@
+// Copyright Kani Contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+// kani-flags: -Zfunction-contracts -Zstubbing
+
+#[kani::requires(x < 8)]
+#[kani::ensures(|result| *result == x + 1)]
+fn f(x: u8) -> u8 {
+    x + 1
+}
+
+fn g(x: u8) -> u8 {
+    x + 2
+}
+
+#[kani::proof]
+#[kani::stub(f, g)]
+fn ordinary_stub() {
+    let x: u8 = kani::any();
+    kani::assume(x < 8);
+    assert!(f(x) == x + 2);
+}

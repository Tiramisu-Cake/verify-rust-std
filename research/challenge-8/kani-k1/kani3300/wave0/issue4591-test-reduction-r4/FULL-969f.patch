+
+#[kani::requires(x < 8)]
+#[kani::ensures(|result| *result == x + 1)]
+fn f(x: u8) -> u8 {
+    x + 1
+}
+
+#[kani::requires(x < 4)]
+#[kani::ensures(|result| *result == x + 2)]
+fn replacement(x: u8) -> u8 {
+    x + 2
+}
+
+#[kani::proof]
+#[kani::stub(f, replacement)]
+fn ordinary_stub_original_mode() {
+    assert_eq!(f(8), 10);
+}

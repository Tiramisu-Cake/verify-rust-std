        "kani_release": {
          "if": "${{ github.event_name == 'push' && startsWith(github.ref, 'refs/tags/kani-') }}",
          "name": "Release",
          "runs-on": "ubuntu-24.04",
          "permissions": {
            "contents": "write"
          },
          "needs": [
            "build_bundle_macos_x86_64",
            "build_bundle_macos_aarch64",
            "build_bundle_linux_x86_64",
            "build_bundle_linux_aarch64",
            "test_bundle"
          ],
          "outputs": {
            "version": "${{ steps.versioning.outputs.version }}",
            "upload_url": "${{ steps.create_release.outputs.upload_url }}"
          },
          "steps": [
            {
              "name": "Checkout code",
              "uses": "actions/checkout@v6"
            },
            {
              "name": "Get version",
              "run": "# pkgid is something like file:///home/ubuntu/kani#kani-verifier:0.1.0\necho \"CRATE_VERSION=$(cargo pkgid | cut -d@ -f2)\" >> $GITHUB_ENV\n# GITHUB_REF is something like refs/tags/kani-0.1.0\necho \"TAG_VERSION=$(echo ${{ github.ref }} | cut -d \"-\" -f 2)\" >> $GITHUB_ENV\n"
            },
            {
              "name": "Check Version",
              "id": "versioning",
              "run": "# Validate git tag & Cargo.toml are in sync on version number\nif [[ ${{ env.CRATE_VERSION }} != ${{ env.TAG_VERSION }} ]]; then\n  echo \"Git tag ${{env.TAG_VERSION}} did not match crate version ${{env.CRATE_VERSION}}\"\n  exit 1\nfi\necho \"version=${{ env.TAG_VERSION }}\" >> $GITHUB_OUTPUT\n"
            },
            {
              "name": "Download MacOS bundle",
              "uses": "actions/download-artifact@v8",
              "with": {
                "name": "${{ needs.build_bundle_macos_x86_64.outputs.bundle }}"
              }
            },
            {
              "name": "Download MacOS ARM bundle",
              "uses": "actions/download-artifact@v8",
              "with": {
                "name": "${{ needs.build_bundle_macos_aarch64.outputs.bundle }}"
              }
            },
            {
              "name": "Download Linux bundle",
              "uses": "actions/download-artifact@v8",
              "with": {
                "name": "${{ needs.build_bundle_linux_x86_64.outputs.bundle }}"
              }
            },
            {
              "name": "Download Linux Arm bundle",
              "uses": "actions/download-artifact@v8",
              "with": {
                "name": "${{ needs.build_bundle_linux_aarch64.outputs.bundle }}"
              }
            },
            {
              "name": "Create release",
              "id": "create_release",
              "uses": "ncipollo/release-action@v1.21.0",
              "env": {
                "GITHUB_TOKEN": "${{ secrets.GITHUB_TOKEN }}"
              },
              "with": {
                "name": "kani-${{ env.TAG_VERSION }}",
                "tag": "kani-${{ env.TAG_VERSION }}",
                "artifacts": "${{ needs.build_bundle_linux_x86_64.outputs.bundle }},${{ needs.build_bundle_linux_aarch64.outputs.bundle }},${{ needs.build_bundle_macos_x86_64.outputs.bundle }},${{ needs.build_bundle_macos_aarch64.outputs.bundle }}",
                "body": "Kani Rust verifier release bundle version ${{ env.TAG_VERSION }}.\n",
                "draft": "true"
              }
            }
          ]
        },
        "package_docker": {
          "name": "Package Docker",
          "needs": "kani_release",
          "runs-on": "ubuntu-24.04",
          "permissions": {
            "contents": "write",
            "packages": "write"
          },
          "env": {
            "os": "ubuntu-24.04",
            "target": "x86_64-unknown-linux-gnu"
          },
          "steps": [
            {
              "name": "Checkout code",
              "uses": "actions/checkout@v6"
            },
            {
              "name": "Setup Kani Dependencies",
              "uses": "./.github/actions/setup",
              "with": {
                "os": "ubuntu-24.04"
              }
            },
            {
              "name": "Build release bundle",
              "run": "cargo bundle\ncargo package -p kani-verifier\n"
            },
            {
              "name": "Login to GitHub Container Registry",
              "uses": "docker/login-action@v4",
              "with": {
                "registry": "ghcr.io",
                "username": "${{ github.repository_owner }}",
                "password": "${{ secrets.GITHUB_TOKEN }}"
              }
            },
            {
              "name": "Set lower case owner name. Needed for docker push.",
              "run": "echo \"OWNER_LC=${OWNER,,}\" >>${GITHUB_ENV}\n",
              "env": {
                "OWNER": "${{ github.repository_owner }}"
              }
            },
            {
              "name": "Build and push",
              "uses": "docker/build-push-action@v7",
              "with": {
                "context": ".",
                "file": "scripts/ci/Dockerfile.bundle-release-24-04",
                "push": "true",
                "github-token": "${{ secrets.GITHUB_TOKEN }}",
                "tags": "ghcr.io/${{ env.OWNER_LC }}/kani-${{ env.os }}:${{ needs.kani_release.outputs.version }}\nghcr.io/${{ env.OWNER_LC }}/kani-${{ env.os }}:latest\n",
                "labels": "org.opencontainers.image.source=${{ github.repositoryUrl }}\norg.opencontainers.image.version=${{ needs.kani_release.outputs.version }}\norg.opencontainers.image.licenses=Apache-2.0 OR MIT\n"
              }
            }
          ]
        }
      },
      "scope": "all native bundle build/test jobs on upstream PR, including matrices; release publication tag-only"
    },
    "verify-std-check.yml": {
      "event": {
        "pull_request": "",
        "workflow_call": ""
      },
      "jobs": {
        "verify-std": {
          "runs-on": "${{ matrix.os }}",
          "strategy": {
            "matrix": {
              "os": [
                "ubuntu-22.04",
                "macos-15"
              ]
            }
          },
          "steps": [
            {
              "name": "Checkout Library",
              "uses": "actions/checkout@v6",
              "with": {
                "repository": "model-checking/verify-rust-std",
                "path": "verify-rust-std",
                "submodules": "true"
              }
            },
            {
              "name": "Checkout `Kani`",
              "uses": "actions/checkout@v6",
              "with": {
                "path": "kani",
                "fetch-depth": "0"
              }
            },
            {
              "name": "Setup Kani Dependencies",
              "uses": "./kani/.github/actions/setup",
              "with": {
                "os": "${{ matrix.os }}",
                "kani_dir": "kani"
              }
            },
            {
              "name": "Build Kani",
              "working-directory": "kani",
              "run": "cargo build-dev\necho \"$(pwd)/scripts\" >> $GITHUB_PATH\n"
            },
            {
              "name": "Run verification with HEAD",
              "id": "check-head",
              "working-directory": "verify-rust-std",
              "continue-on-error": "true",
              "run": "kani verify-std -Z unstable-options ./library --target-dir ${{ runner.temp }} -Z function-contracts \\\n  -Z mem-predicates -Z loop-contracts --cbmc-args --object-bits 12\n"
            },
            {
              "name": "Checkout BASE",
              "working-directory": "kani",
              "if": "steps.check-head.outcome != 'success' && github.event_name == 'pull_request'",
              "run": "BASE_REF=${{ github.event.pull_request.base.sha }}\ngit checkout ${BASE_REF}\n"
            },
            {
              "name": "Setup Kani Dependencies BASE",
              "uses": "./kani/.github/actions/setup",
              "if": "steps.check-head.outcome != 'success' && github.event_name == 'pull_request'",
              "with": {
                "os": "${{ matrix.os }}",
                "kani_dir": "kani"
              }
            },
            {
              "name": "Build Kani BASE",
              "working-directory": "kani",
              "if": "steps.check-head.outcome != 'success' && github.event_name == 'pull_request'",
              "run": "cargo build-dev\n"
            },
            {
              "name": "Run verification with BASE",
              "id": "check-base",
              "if": "steps.check-head.outcome != 'success' && github.event_name == 'pull_request'",
              "working-directory": "verify-rust-std",
              "continue-on-error": "true",
              "run": "kani verify-std -Z unstable-options ./library --target-dir ${{ runner.temp }} -Z function-contracts \\\n  -Z mem-predicates -Z loop-contracts --cbmc-args --object-bits 12\n"
            },
            {
              "name": "Compare PR results",
              "if": "steps.check-head.outcome != 'success' && steps.check-head.outcome != steps.check-base.outcome",
              "run": "echo \"New failure introduced by this change\"\necho \"HEAD: ${{ steps.check-head.outcome }}\"\necho \"BASE: ${{ steps.check-base.outcome }}\"\nexit 1\n"
            }
          ]
        }
      },
      "scope": "native ubuntu-22.04/macos-15 PR jobs"
    },
    "bench-pr.yml": {
      "event": {
        "pull_request": {
          "types": [
            "opened",
            "synchronize",
            "reopened",
            "labeled"
          ]
        }
      },
      "concurrency": {
        "group": "${{ github.workflow }}-${{ github.event.pull_request.number }}",
        "cancel-in-progress": "true"
      },
      "jobs": {
        "end-to-end-bench": {
          "name": "End-to-End Benchmarks",
          "if": "${{ contains(github.event.pull_request.labels.*.name, 'Z-EndToEndBenchCI') }}",
          "uses": "./.github/workflows/bench-e2e.yml"
        },
        "compiler-bench": {
          "name": "Compiler Benchmarks",
          "if": "${{ contains(github.event.pull_request.labels.*.name, 'Z-CompilerBenchCI') }}",
          "uses": "./.github/workflows/bench-compiler.yml"
        }
      },
      "scope": "native Z-EndToEndBenchCI/Z-CompilerBenchCI label-gated workflows on upstream PR"
    },
    "extra_jobs.yml": {
      "event": {
        "pull_request_target": "",
        "merge_group": ""
      },
      "scope": "native upstream PR metadata/labeler; no proof credit"
    }

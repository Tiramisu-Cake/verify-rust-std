+# Copyright Kani Contributors
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+name: CH8 issue 5151 bounded reproduction
+on:
+  push:
+    branches: ["uninit-ci/ch8-5151-*"]
+permissions:
+  contents: read
+concurrency:
+  group: ch8-5151
+  cancel-in-progress: false
+jobs:
+  reproduce:
+    if: ${{ github.repository == 'Tiramisu-Cake/kani' && github.event_name == 'push' && github.run_attempt == 1 }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 55
+    strategy:
+      max-parallel: 1
+      fail-fast: false
+      matrix:
+        include:
+          - pin: stock
+            repository: model-checking/kani
+            sha: 0aac16ef62da9e9d5645782d458593e5d78143ba

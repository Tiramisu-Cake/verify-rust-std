      },
      "clippy-check": {
        "runs-on": "ubuntu-24.04",
        "steps": [
          {
            "name": "Checkout Kani",
            "uses": "actions/checkout@v6"
          },
          {
            "name": "Setup Kani Dependencies",
            "uses": "./.github/actions/setup",
            "with": {
              "os": "ubuntu-24.04"
            }
          },
          {
            "name": "Install jq for parsing.",
            "run": "sudo apt-get install -y jq\n"
          },
          {
            "name": "Run Clippy",
            "run": "cargo clippy --workspace --tests -- -D warnings\nRUSTFLAGS=\"--cfg=kani_sysroot\" cargo clippy --workspace -- -D warnings\n"
          },
          {
            "name": "Print Clippy Statistics",
            "run": "rm .cargo/config.toml\n(cargo clippy --all --message-format=json 2>/dev/null  | \\\njq 'select(.message!=null) | .message.code.code' | grep -v '^null$' | \\\nsort | uniq -c) || true\n"
          }
        ]
      }
    },
    "deny.yml": {
      "audit": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "uses": "actions/checkout@v6",
            "with": {
              "submodules": "recursive"
            }

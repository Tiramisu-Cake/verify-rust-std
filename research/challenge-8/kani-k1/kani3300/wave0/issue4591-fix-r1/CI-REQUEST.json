    "format-check.yml": {
      "format-check": {
        "runs-on": "ubuntu-latest",
        "steps": [
          {
            "name": "Checkout Kani",
            "uses": "actions/checkout@v6"
          },
          {
            "name": "Execute copyright check",
            "run": "./scripts/ci/run-copyright-check.sh"
          },
          {
            "name": "Check C code formatting",
            "continue-on-error": "true",
            "run": "./scripts/run-clang-format.sh -d"

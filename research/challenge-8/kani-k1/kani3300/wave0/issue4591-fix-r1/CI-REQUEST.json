            "uses": "EmbarkStudios/cargo-deny-action@v2",
            "env": {
              "RUSTUP_TOOLCHAIN": "stable"
            },
            "with": {
              "arguments": "--all-features --workspace",
              "command-arguments": "-s"
            }
          }
        ]
      }
    }

+    let mut source = MaybeUninit::<Padded>::uninit();
+    unsafe { source.as_mut_ptr().cast::<u8>().write_bytes(0x5a, 8) };
+    let destination = source;
+    unsafe {
+        assert_eq!((*destination.as_ptr()).tag, 0x5a);
+        assert_eq!((*destination.as_ptr()).value, 0x5a5a5a5a);
+    }
+}

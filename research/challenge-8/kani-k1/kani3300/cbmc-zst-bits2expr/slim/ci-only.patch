+#!/usr/bin/env python3
+"""Isolated error-path checks: no compiler, solver or verifier execution."""
+import copy
+import json
+import os
+from pathlib import Path
+import shlex
+import signal
+import sys
+import tempfile
+import time
+import unittest
+from unittest.mock import patch
+
+import runner as r
+
+OK = {'status': 'EXITED', 'exit': 0, 'signal': 0, 'complete': True}
+INVARIANT = '''Invariant check failed
+File: ../util/simplify_utils.cpp:345 function: bits2expr
+Condition: el_size_opt.has_value() && *el_size_opt > bitst{0}
+Reason: Check return value
+'''
+
+
+class Checks(unittest.TestCase):
+    def test_oracles_reject_missing_partial_and_wrong_types(self):
+        self.assertTrue(r.fix_ok(OK, 'VERIFICATION SUCCESSFUL\n'))
+        self.assertTrue(r.unit_ok(OK, 'All tests passed (48 assertions in 1 test case)'))
+        for broken in (None, {}, {'status': 'NOT_RUN'},
+                       dict(OK, exit=True), dict(OK, exit='0'),
+                       dict(OK, signal=None), dict(OK, signal=False),
+                       dict(OK, signal=9), dict(OK, complete=False),
+                       dict(OK, status='TIMEOUT'), dict(OK, status='OUTPUT_CAP')):
+            self.assertFalse(r.good(broken), broken)
+        for text in ('No test cases matched', 'All tests passed (0 assertions in 1 test case)',
+                     'All tests passed (9 assertions in 2 test cases)', ''):
+            self.assertFalse(r.unit_ok(OK, text))
+        self.assertFalse(r.fix_ok(OK, 'VERIFICATION SUCCESSFUL\nwarning: ignoring option'))
+
+    def test_exact_baseline_only(self):
+        abort = dict(OK, exit=None, signal=signal.SIGABRT)
+        self.assertTrue(r.baseline_ok(abort, INVARIANT))
+        self.assertTrue(r.baseline_ok(dict(OK, exit=134), INVARIANT))
+        for rec, text in ((OK, INVARIANT), (dict(OK, exit=1), INVARIANT),
+                          (dict(abort, signal=9), INVARIANT),
+                          (dict(abort, complete=False), INVARIANT),
+                          (dict(abort, status='TIMEOUT'), INVARIANT),
+                          (abort, INVARIANT.replace('bits2expr', 'other_function')),
+                          (abort, INVARIANT.replace(' > ', ' >= ')),
+                          (abort, 'SMT2 Unsupported'), (abort, 'missing solver')):
+            self.assertFalse(r.baseline_ok(rec, text), (rec, text))
+
+    def test_selection_and_profile_quoting(self):
+        self.assertTrue(r.selected_one('  1 test found\n  Running x/test.desc  [OK] in 0 seconds\n'))
+        for text in ('0 tests found\n', '1 test found\n Running x/test.desc [SKIPPED]\n',
+                     '2 tests found\n Running x/test.desc [OK]\n', ''):
+            self.assertFalse(r.selected_one(text))
+        command, opts, expected = r.profile_command('incremental', '/tmp/binary', Path('/tmp/receipt'))
+        self.assertEqual(shlex.split(command)[-1], 'z3 --smt2 -in')
+        self.assertEqual(expected[-2:], ['z3 --smt2 -in', 'main.c'])
+        self.assertEqual(opts, ['-X', 'no-new-smt', '-s', 'new-smt-backend'])
+        with self.assertRaisesRegex(RuntimeError, 'wrong profile'):
+            r.profile_command('unexpected', '/tmp/bin', Path('/tmp/out'))
+        self.assertEqual(len(r.PROFILES), 5)
+
+    def test_missing_solver(self):
+        with self.assertRaisesRegex(RuntimeError, 'missing z3'):
+            r.check_tools(lambda name: None if name == 'z3' else '/fake/'+name)
+
+    def test_format_empty_diff(self):
+        self.assertTrue(r.format_ok(OK, 'clang-format did not modify any files\n'))
+        self.assertTrue(r.format_ok(OK, 'no modified files to format\n'))
+        self.assertFalse(r.format_ok(OK, 'diff --git a/f b/f\n'))
+        self.assertFalse(r.format_ok(dict(OK, exit=1), ''))
+
+    def test_wrong_pins_hashes_and_allowlist(self):
+        cfg = json.loads((r.HERE/'config.json').read_text())
+        package = r.HERE.parents[1]
+        r.verify_inputs(package, cfg)
+        for field, value in (('source', cfg['base']), ('source_tree', '0'*40),
+                             ('test_patch_sha256', '0'*64),
+                             ('source_allowlist', [])):
+            broken = copy.deepcopy(cfg)
+            broken[field] = value
+            with self.assertRaises((RuntimeError, r.subprocess.CalledProcessError)):
+                r.verify_inputs(package, broken)
+        broken = copy.deepcopy(cfg)
+        broken['test_hashes'][next(iter(broken['test_hashes']))] = '0'*64
+        with self.assertRaisesRegex(RuntimeError, 'wrong test hash'):
+            r.verify_inputs(package, broken)
+
+    def test_bounded_processes(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            def run(code, timeout=2, cap=4096):
+                return r.execute([sys.executable, '-c', code], root, root/'case.log',
+                                 timeout, cap)
+            rec = run('print("success")')
+            self.assertTrue(r.good(rec))
+            self.assertEqual(rec['raw_bytes'], 8)
+            self.assertEqual(run('raise SystemExit(7)')['exit'], 7)
+            rec = run('import os,signal; os.kill(os.getpid(),signal.SIGTERM)')
+            self.assertEqual(rec['signal'], signal.SIGTERM)
+            self.assertIsNone(rec['exit'])
+            rec = run('import time; time.sleep(10)', .15)
+            self.assertEqual(rec['status'], 'TIMEOUT')
+            self.assertFalse(rec['complete'])
+            rec = run('import sys; sys.stdout.write("x"*100000)')
+            self.assertEqual(rec['status'], 'OUTPUT_CAP')
+            self.assertGreater(rec['raw_bytes'], 4096)
+            self.assertEqual((root/'case.log').stat().st_size, 4096)
+            # Child in another process group must still be cleaned up.
+            code = ('import subprocess,time,sys; '
+                    'p=subprocess.Popen([sys.executable,"-c","import time; time.sleep(20)"],'
+                    'start_new_session=True); print(p.pid,flush=True); time.sleep(20)')
+            rec = run(code, .3)
+            self.assertEqual(rec['status'], 'TIMEOUT')
+            child = int((root/'case.log').read_text())
+            stat = Path(f'/proc/{child}/stat')
+            deadline = time.monotonic()+1
+            while stat.exists() and stat.read_text().split()[2] != 'Z' and time.monotonic() < deadline:
+                time.sleep(.01)
+            self.assertTrue(not stat.exists() or stat.read_text().split()[2] == 'Z')
+            rec = r.execute(['/no/such/program'], root, root/'missing.log', 1)
+            self.assertEqual(rec['status'], 'START_ERROR')
+            self.assertFalse(rec['complete'])
+            # Build-like outputs exceed capture cap without being cut by FSIZE.
+            rec = run('from pathlib import Path; Path("object").write_bytes(b"x"*100000)')
+            self.assertTrue(r.good(rec))
+            self.assertEqual((root/'object').stat().st_size, 100000)
+
+    def test_stop_retains_not_run_states_and_exception(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            with patch.object(r, 'verify_inputs', side_effect=RuntimeError('wrong pin')):
+                with self.assertRaisesRegex(RuntimeError, 'wrong pin'):
+                    r.run_all(r.HERE.parents[1], root, root/'reports')
+            state = json.loads((root/'reports/result.json').read_text())
+            self.assertEqual(state['status'], 'STOP')
+            self.assertEqual(set(state['regressions'].values()), {'NOT_RUN'})
+            self.assertEqual(len(state['regressions']), 10)
+            self.assertEqual(set(state['units'].values()), {'NOT_RUN'})
+            self.assertEqual(len(state['units']), 8)
+            self.assertIn('wrong pin', state['error'])
+
+
+    def test_started_setup_and_format_failures_keep_original_exit(self):
+        for failed_name in ('version-gcc', 'format'):
+            with self.subTest(stage=failed_name), tempfile.TemporaryDirectory() as tmp:
+                root = Path(tmp)
+                def fake_execute(argv, cwd, log, *args):
+                    text = ('sat\n' if Path(log).stem == 'z3-smoke' else
+                            'clang-format version 18.1.8\n')
+                    Path(log).write_text(text)
+                    return dict(OK, exit=7 if Path(log).stem == failed_name else 0)
+                def which(name):
+                    return '/usr/bin/'+({'gcc': 'gcc-13', 'g++': 'g++-13'}.get(name, name))
+                with patch.object(r, 'verify_inputs'), patch.object(r, 'check_tools'), \
+                     patch.object(r.shutil, 'which', side_effect=which), \
+                     patch.object(r, 'sha', return_value='fake-hash'), \
+                     patch.object(r, 'execute', side_effect=fake_execute):
+                    with self.assertRaisesRegex(RuntimeError, failed_name):
+                        r.run_all(r.HERE.parents[1], root, root/'reports')
+                state = json.loads((root/'reports/result.json').read_text())
+                self.assertEqual(state['status'], 'STOP')
+                self.assertEqual(state['executions'][failed_name]['exit'], 7)
+                self.assertEqual(state['format'], 'STOP' if failed_name == 'format' else 'NOT_RUN')
+                self.assertEqual(state['lint'], 'NOT_RUN')
+                self.assertEqual(set(state['regressions'].values()), {'NOT_RUN'})
+                self.assertEqual(set(state['units'].values()), {'NOT_RUN'})
+
+
+if __name__ == '__main__':
+    unittest.main()

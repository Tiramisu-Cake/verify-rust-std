new file mode 100644
index 0000000000000000000000000000000000000000..9b50af822b78e73ceb0546f93fc88521647f7def
--- /dev/null
+++ b/.github/workflows/cbmc-slim.yml
@@ -0,0 +1,59 @@
+name: Focused array constant reconstruction
+on:
+  push:
+    branches: ['ci/array-zero-width-elements-slim-*']
+permissions:
+  contents: read
+concurrency:
+  group: cbmc-slim
+  cancel-in-progress: false
+jobs:
+  focused:
+    if: github.repository == 'Tiramisu-Cake/cbmc'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 210
+    env:
+      TESTPL_JOBS: '1'
+      TESTPL_COLOR_OUTPUT: '0'
+      DEBIAN_FRONTEND: noninteractive
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          path: package
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Install dependencies and formatter 18.1.8
+        timeout-minutes: 15
+        run: |
+          sudo apt-get update
+          sudo apt-get install --no-install-recommends -y gcc-13 g++-13 flex bison make git curl patch cmake perl python3 python3-venv z3
+          python3 -m venv "$GITHUB_WORKSPACE/format-env"
+          "$GITHUB_WORKSPACE/format-env/bin/pip" install clang-format==18.1.8
+          mkdir -p "$GITHUB_WORKSPACE/toolchain"
+          ln -s /usr/bin/gcc-13 "$GITHUB_WORKSPACE/toolchain/gcc"
+          ln -s /usr/bin/g++-13 "$GITHUB_WORKSPACE/toolchain/g++"
+          echo "$GITHUB_WORKSPACE/toolchain" >> "$GITHUB_PATH"
+          echo "$GITHUB_WORKSPACE/format-env/bin" >> "$GITHUB_PATH"
+      - name: Isolated Python service checks
+        timeout-minutes: 2
+        run: python3 package/scripts/cbmc-slim/test_runner.py
+      - name: Exact paired profiles and genuine Make and CMake unit cases
+        timeout-minutes: 190
+        run: >-
+          python3 package/scripts/cbmc-slim/runner.py run
+          "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE"
+          "$GITHUB_WORKSPACE/reports"
+      - name: Preserve setup failure when runner did not start
+        if: always()
+        run: |
+          mkdir -p reports
+          if [ ! -f reports/result.json ]; then
+            cp package/scripts/cbmc-slim/not-run.json reports/result.json
+          fi
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: cbmc-slim-${{ github.sha }}
+          path: reports/
+          if-no-files-found: error
+          retention-days: 14

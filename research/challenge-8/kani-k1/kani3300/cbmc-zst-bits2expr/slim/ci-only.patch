diff --git a/scripts/cbmc-slim/runner.py b/scripts/cbmc-slim/runner.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc6ed519980c5b80bcf99947c737135b3a6a1d0b
--- /dev/null
+++ b/scripts/cbmc-slim/runner.py
@@ -0,0 +1,473 @@
+#!/usr/bin/env python3
+"""Coordinator-only focused CI. Self-tests use Python processes, never CBMC."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import resource
+import selectors
+import shlex
+import shutil
+import signal
+import subprocess
+import sys
+import time
+
+HERE = Path(__file__).resolve().parent
+MIB = 1024**2
+PROFILES = {
+    'sat': (['--validate-goto-model', '--validate-ssa-equation'],
+            ['-X', 'smt-backend']),
+    'paths-lifo': (['--paths', 'lifo'], ['-X', 'thorough-paths', '-X',
+                   'smt-backend', '-X', 'paths-lifo-expected-failure',
+                   '-s', 'paths-lifo']),
+    'cprover-smt2': (['--cprover-smt2'], ['-X', 'broken-smt-backend', '-X',
+                     'thorough-smt-backend', '-X', 'broken-cprover-smt-backend',
+                     '-X', 'thorough-cprover-smt-backend', '-s', 'cprover-smt2']),
+    'z3': (['--z3'], ['-X', 'broken-smt-backend', '-X', 'thorough-smt-backend',
+                    '-X', 'broken-z3-smt-backend', '-X', 'thorough-z3-smt-backend',
+                    '-s', 'z3']),
+    'incremental': (['--incremental-smt2-solver', 'z3 --smt2 -in'],
+                    ['-X', 'no-new-smt', '-s', 'new-smt-backend']),
+}
+
+
+def sha(path):
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def save(path, obj):
+    path = Path(path)
+    temp = path.with_suffix(path.suffix + '.tmp')
+    temp.write_text(json.dumps(obj, indent=2, sort_keys=True) + '\n')
+    temp.replace(path)
+
+
+def git(root, *args):
+    return subprocess.check_output(['git', '-C', str(root), *args], text=True).strip()
+
+
+def require(condition, reason):
+    if not condition:
+        raise RuntimeError(reason)
+
+
+def limits(memory):
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    if memory:
+        resource.setrlimit(resource.RLIMIT_AS, (memory, memory))
+    # No RLIMIT_FSIZE: build outputs must remain unrestricted.
+
+
+def descendants(pid):
+    try:
+        children = Path(f'/proc/{pid}/task/{pid}/children').read_text().split()
+    except FileNotFoundError:
+        return []
+    result = []
+    for child in children:
+        result += descendants(int(child)) + [int(child)]
+    return result
+
+
+def kill_tree(proc):
+    for pid in descendants(proc.pid):
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+
+
+def rss_kib(pid):
+    total = 0
+    for child in [pid, *descendants(pid)]:
+        try:
+            match = re.search(r'^VmRSS:\s*(\d+) kB$',
+                              Path(f'/proc/{child}/status').read_text(), re.M)
+            total += int(match[1]) if match else 0
+        except FileNotFoundError:
+            pass
+    return total
+
+
+def execute(argv, cwd, log, seconds, cap=4*MIB, memory=None, input_bytes=None):
+    """Drain pipes after cap; kill groups on cap/timeout, preserve actual status."""
+    start = time.monotonic()
+    record = {'argv': list(map(str, argv)), 'cwd': str(cwd), 'status': 'NOT_RUN',
+              'exit': None, 'signal': None, 'complete': False,
+              'timeout_seconds': seconds, 'cap_bytes': cap,
+              'memory_limit_bytes_per_process': memory, 'raw_bytes': 0}
+    raw = 0
+    stored = 0
+    proc = None
+    peak_rss = 0
+    with Path(log).open('wb') as stream:
+        try:
+            proc = subprocess.Popen(record['argv'], cwd=cwd, stdout=subprocess.PIPE,
+                                    stderr=subprocess.STDOUT, start_new_session=True,
+                                    stdin=subprocess.PIPE if input_bytes is not None else None,
+                                    preexec_fn=lambda: limits(memory))
+            if input_bytes is not None:
+                proc.stdin.write(input_bytes)
+                proc.stdin.close()
+            sel = selectors.DefaultSelector()
+            sel.register(proc.stdout, selectors.EVENT_READ)
+            record['status'] = 'EXITED'
+            killed_at = None
+            while sel.get_map():
+                now = time.monotonic()
+                current_rss = rss_kib(proc.pid)
+                peak_rss = max(peak_rss, current_rss)
+                if memory and current_rss*1024 > memory and killed_at is None:
+                    record['status'] = 'MEMORY_CAP'
+                    kill_tree(proc)
+                    killed_at = now
+                if now-start > seconds and killed_at is None:
+                    record['status'] = 'TIMEOUT'
+                    kill_tree(proc)
+                    killed_at = now
+                if killed_at is not None and now-killed_at > 3:
+                    record['status'] = 'INCOMPLETE_DRAIN'
+                    break
+                for key, _ in sel.select(0.05):
+                    data = os.read(key.fileobj.fileno(), 65536)
+                    if not data:
+                        sel.unregister(key.fileobj)
+                        continue
+                    raw += len(data)
+                    chunk = data[:max(0, cap-stored)]
+                    stream.write(chunk)
+                    stored += len(chunk)
+                    if raw > cap and killed_at is None:
+                        record['status'] = 'OUTPUT_CAP'
+                        kill_tree(proc)
+                        killed_at = now
+            sel.close()
+            proc.stdout.close()
+            # Also bound a process that closes stdout before hanging.
+            try:
+                rc = proc.wait(timeout=max(0.01, seconds-(time.monotonic()-start)))
+            except subprocess.TimeoutExpired:
+                record['status'] = 'TIMEOUT'
+                kill_tree(proc)
+                rc = proc.wait()
+            record.update(exit=rc if rc >= 0 else None,
+                          signal=-rc if rc < 0 else 0)
+            record['complete'] = record['status'] == 'EXITED' and raw <= cap
+        except OSError as error:
+            record.update(status='START_ERROR', error=str(error))
+        finally:
+            if proc is not None and proc.poll() is None:
+                kill_tree(proc)
+                proc.wait()
+    record.update(raw_bytes=raw, raw_KiB=raw/1024, stored_bytes=stored,
+                  wall_seconds=time.monotonic()-start, log_sha256=sha(log),
+                  process_tree_peak_rss_KiB_sampled=peak_rss,
+                  children_maxrss_KiB_cumulative=resource.getrusage(
+                      resource.RUSAGE_CHILDREN).ru_maxrss)
+    save(Path(log).with_suffix('.json'), record)
+    return record
+
+
+def good(record):
+    return (isinstance(record, dict) and record.get('status') == 'EXITED'
+            and record.get('complete') is True and type(record.get('exit')) is int
+            and record['exit'] == 0 and type(record.get('signal')) is int
+            and record['signal'] == 0)
+
+
+def baseline_ok(record, text):
+    # The invariant normally aborts. A signal alone never establishes this result.
+    return (isinstance(record, dict) and record.get('complete') is True
+            and record.get('status') == 'EXITED'
+            and ((record.get('exit') is None and record.get('signal') == signal.SIGABRT)
+                 or (record.get('exit') == 134 and record.get('signal') == 0))
+            and 'Invariant check failed' in text
+            and re.search(r'^File:.*simplify_utils\.cpp:\d+ function: bits2expr$',
+                          text, re.M) is not None
+            and re.search(r'^Condition:.*el_size_opt\.has_value\(\)\s*&&\s*'
+                          r'\*el_size_opt\s*>\s*bitst\{0\}', text, re.M) is not None
+            and re.search(r'^File:.*simplify_utils\.cpp', text, re.M) is not None
+            and 'TIMEOUT=1' not in text)
+
+
+def fix_ok(record, text):
+    return (good(record) and re.search(r'^VERIFICATION SUCCESSFUL$', text, re.M)
+            is not None and 'Invariant check failed' not in text
+            and 'warning: ignoring' not in text and 'FAILURE' not in text)
+
+
+def selected_one(text):
+    return (len(re.findall(r'^\s*1 test found\s*$', text, re.M)) == 1
+            and len(re.findall(r'^\s*Running .*test\.desc\s+\[(?:OK|FAILED)\]',
+                               text, re.M)) == 1
+            and 'SKIPPED' not in text and 'skipped' not in text)
+
+
+def unit_ok(record, text):
+    match = re.search(r'All tests passed \((\d+) assertions? in 1 test case\)', text)
+    return good(record) and match is not None and int(match[1]) > 0
+
+
+def format_ok(record, text):
+    return good(record) and text.strip() in (
+        'no modified files to format', 'clang-format did not modify any files')
+
+
+def check_tools(find=shutil.which):
+    for name in ('z3', 'perl', 'cmake', 'make', 'gcc', 'g++', 'gcc-13', 'g++-13',
+                 'flex', 'bison', 'git', 'curl', 'patch', 'clang-format',
+                 'git-clang-format'):
+        require(find(name) is not None, 'SETUP_FAILURE: missing ' + name)
+
+
+def verify_inputs(package, cfg):
+    source, base = cfg['source'], cfg['base']
+    require(git(package, 'rev-parse', source+'^') == base, 'wrong source parent')
+    require(git(package, 'rev-parse', source+'^{tree}') == cfg['source_tree'],
+            'wrong source tree')
+    require(set(git(package, 'diff', '--name-only', base, source).splitlines())
+            == set(cfg['source_allowlist']), 'wrong source allowlist')
+    require(sha(HERE/'baseline-tests.patch') == cfg['test_patch_sha256'],
+            'wrong test patch hash')
+    for name, expected in cfg['test_hashes'].items():
+        require(sha(package/name) == expected, 'wrong test hash: '+name)
+    before = subprocess.check_output(['git', '-C', str(package), 'show',
+                                      base+':src/util/simplify_utils.cpp'])
+    after = subprocess.check_output(['git', '-C', str(package), 'show',
+                                     source+':src/util/simplify_utils.cpp'])
+    old = b'CHECK_RETURN(el_size_opt.has_value() && *el_size_opt > bitst{0});'
+    require(before.replace(old, old.replace(b' > ', b' >= '), 1) == after,
+            'wrong production delta')
+    workflows = sorted(p.name for p in (package/'.github/workflows').iterdir())
+    require(workflows == ['cbmc-slim.yml'], 'unexpected workflow')
+
+
+def profile_command(profile, binary, receipt):
+    require(profile in PROFILES, 'wrong profile')
+    flags, opts = PROFILES[profile]
+    # test.pl reparses -c with bash; shlex.join preserves the solver string.
+    command = shlex.join([sys.executable, str(HERE/'runner.py'), 'probe',
+                          str(receipt), str(binary), *flags])
+    return command, opts, [str(binary), *flags, 'main.c']
+
+
+def run_all(package, workspace, report):
+    cfg = json.loads((HERE/'config.json').read_text())
+    report.mkdir(parents=True, exist_ok=False)
+    state = {'status': 'IN_PROGRESS', 'base': cfg['base'], 'source': cfg['source'],
+             'source_tree': cfg['source_tree'], 'baseline_tree': cfg['baseline_tree'],
+             'package_sha': git(package, 'rev-parse', 'HEAD'),
+             'package_tree': git(package, 'rev-parse', 'HEAD^{tree}'),
+             'config_sha256': sha(HERE/'config.json'), 'proof_credit': False,
+             'executions': {},
+             'builds': {v: 'NOT_RUN' for v in ('baseline', 'fix', 'make')},
+             'regressions': {v+'/'+p: 'NOT_RUN' for v in ('baseline', 'fix')
+                             for p in PROFILES},
+             'units': {v+'/'+n: 'NOT_RUN' for v in ('fix', 'make')
+                       for n in cfg['units']}, 'format': 'NOT_RUN', 'lint': 'NOT_RUN'}
+    def snapshot():
+        save(report/'result.json', state)
+    def call(name, argv, cwd, seconds=90, cap=4*MIB, memory=None, input_bytes=None):
+        state['executions'][name] = {'status': 'IN_PROGRESS', 'argv': list(map(str, argv))}
+        snapshot()
+        rec = execute(argv, cwd, report/(name+'.log'), seconds, cap, memory,
+                      input_bytes)
+        state['executions'][name] = rec
+        snapshot()
+        require(good(rec), name+': '+rec['status']+' / '+str(rec['exit']))
+        return rec, (report/(name+'.log')).read_text(errors='replace')
+    snapshot()
+    try:
+        verify_inputs(package, cfg)
+        check_tools()
+        require(Path(shutil.which('gcc')).resolve() == Path('/usr/bin/gcc-13').resolve()
+                and Path(shutil.which('g++')).resolve() == Path('/usr/bin/g++-13').resolve(),
+                'wrong default compiler / preprocessor')
+        state['tools'] = {}
+        for tool in ('gcc', 'g++', 'cmake', 'make', 'perl', 'z3', 'clang-format'):
+            rec, text = call('version-'+tool, [tool, '--version'], package)
+            state['tools'][tool] = {'path': shutil.which(tool),
+                                    'sha256': sha(Path(shutil.which(tool)).resolve()),
+                                    'version': text, 'execution': rec}
+        call('compiler-target', ['gcc', '-dumpmachine'], package)
+        call('packages', ['dpkg-query', '-W', 'gcc-13', 'g++-13', 'flex', 'bison',
+                          'cmake', 'make', 'perl', 'z3', 'python3'], package)
+        _, text = call('z3-smoke', ['z3', '--smt2', '-in'], package,
+                       input_bytes=b'(check-sat)\n')
+        require(text.strip() == 'sat', 'z3 smoke failure')
+        require(re.search(r'\b18\.1\.8\b', state['tools']['clang-format']['version']),
+                'wrong formatter version')
+        state['format'] = 'IN_PROGRESS'
+        rec, text = call('format', ['git-clang-format', '--binary', 'clang-format',
+                                  '--diff', cfg['base'], cfg['source']], package)
+        require(format_ok(rec, text), 'formatter nonempty diff')
+        state['format'] = rec
+        state['lint'] = 'IN_PROGRESS'
+        state['lint'] = call('cpplint', [sys.executable, 'scripts/cpplint.py',
+                             'src/util/simplify_utils.cpp', 'unit/util/simplify_expr.cpp'],
+                             package)[0]
+        call('diff-check', ['git', 'diff', '--check', cfg['base'], cfg['source']], package)
+        snapshot()
+        for variant in ('baseline', 'fix', 'make'):
+            model = workspace/('slim-'+variant)
+            ref = cfg['base'] if variant == 'baseline' else cfg['source']
+            call(variant+'-worktree', ['git', 'worktree', 'add', '--detach', str(model), ref],
+                 package)
+            if variant == 'baseline':
+                call('baseline-overlay', ['git', 'apply', '--index', '--unidiff-zero',
+                     str(HERE/'baseline-tests.patch')], model)
+            expected_tree = cfg['baseline_tree'] if variant == 'baseline' else cfg['source_tree']
+            require(git(model, 'write-tree') == expected_tree, 'wrong model tree')
+            for name, expected in cfg['test_hashes'].items():
+                require(sha(model/name) == expected, 'test identity mismatch')
+            # No shared CMake outputs, Make .o files, or stale executables.
+            require(not list(model.rglob('*.o')), 'stale object')
+            build_start = time.monotonic()
+            state['builds'][variant] = {'status': 'IN_PROGRESS', 'ref': ref,
+                                         'tree': expected_tree, 'steps': []}
+            snapshot()
+            if variant == 'make':
+                commands = [['make', '-C', 'src', 'minisat2-download'],
+                            ['env', 'CXXFLAGS=-O2 -DNDEBUG',
+                             'make', '-C', 'unit', '-j2', 'CXX=/usr/bin/g++-13',
+                             'CC=/usr/bin/gcc-13',
+                             'WITH_MEMORY_ANALYZER=0']]
+            else:
+                commands = [['cmake', '-S', str(model), '-B', str(model/'build'),
+                             '-DCMAKE_BUILD_TYPE=Release', '-DWITH_JBMC=OFF',
+                             '-DWITH_MEMORY_ANALYZER=OFF', '-Dsat_impl=minisat2',
+                             '-DCMAKE_C_COMPILER=/usr/bin/gcc-13',
+                             '-DCMAKE_CXX_COMPILER=/usr/bin/g++-13'],
+                            ['cmake', '--build', str(model/'build'), '--target',
+                             'cbmc', 'smt2_solver', *(['unit'] if variant == 'fix' else []),
+                             '--parallel', '2']]
+            for i, command in enumerate(commands):
+                remaining = 2700-(time.monotonic()-build_start)
+                require(remaining > 0, 'configuration time cap')
+                rec, _ = call(variant+'-build-'+str(i), command, model, remaining, 16*MIB)
+                state['builds'][variant]['steps'].append(rec)
+                snapshot()
+            binaries = {'unit': model/'unit/unit_tests'} if variant == 'make' else {
+                'cbmc': model/'build/bin/cbmc', 'smt2_solver': model/'build/bin/smt2_solver'}
+            if variant == 'fix':
+                binaries['unit'] = model/'build/bin/unit'
+            binary_meta = {n: {'path': str(p), 'sha256': sha(p)} for n, p in binaries.items()}
+            state['builds'][variant].update(status='BUILT', binaries=binary_meta)
+            snapshot()
+            if variant != 'make':
+                shutil.copyfile(model/'build/CMakeCache.txt', report/(variant+'-CMakeCache.txt'))
+                call(variant+'-cbmc-version', [str(binaries['cbmc']), '--version'], model)
+                helper = str((model/'build/bin').resolve())
+                os.environ['PATH'] = helper+os.pathsep+os.environ['PATH']
+                require(Path(shutil.which('smt2_solver')).resolve() == binaries['smt2_solver'],
+                        'wrong smt2_solver')
+                _, text = call(variant+'-smt2-smoke', ['smt2_solver'], model,
+                               input_bytes=b'(check-sat)\n')
+                require(re.search(r'^sat$', text, re.M) is not None
+                        and not re.search(r'^(?:error|unknown|unsat)$', text, re.M),
+                        'smt2_solver smoke failure')
+                for profile in PROFILES:
+                    key = variant+'/'+profile
+                    state['regressions'][key] = {'status': 'IN_PROGRESS'}
+                    snapshot()
+                    folder = model/'regression/cbmc'/cfg['directory']
+                    require(sorted(p.name for p in folder.glob('*.desc')) == ['test.desc'],
+                            'zero or extra descriptors')
+                    receipt = report/(variant+'-'+profile+'-cbmc.json')
+                    command, options, expected = profile_command(profile, binaries['cbmc'], receipt)
+                    suffix = next((options[i+1] for i in range(len(options)) if options[i] == '-s'), '')
+                    out = folder/('test'+('-'+suffix if suffix else '')+'.out')
+                    require(not out.exists() and not receipt.exists(), 'stale case output')
+                    argv = ['perl', '../test.pl', '-e', '-p', '-c', command, *options,
+                            cfg['directory']]
+                    rec = execute(argv, model/'regression/cbmc',
+                                  report/(variant+'-'+profile+'-runner.log'), 135)
+                    state['regressions'][key]['runner'] = rec
+                    snapshot()
+                    text = (report/(variant+'-'+profile+'-runner.log')).read_text(errors='replace')
+                    require(selected_one(text), 'wrong descriptor selection / skip')
+                    require(out.exists() and receipt.exists(), 'missing underlying output / receipt')
+                    shutil.copyfile(out, report/(variant+'-'+profile+'-test.out'))
+                    underlying = json.loads(receipt.read_text())
+                    cbmc_log = receipt.with_suffix('.log')
+                    cbmc_text = cbmc_log.read_text(errors='replace')
+                    require(underlying['argv'] == expected and underlying['cwd'] == str(folder),
+                            'wrong underlying argv / cwd / profile')
+                    require(underlying['log_sha256'] == sha(cbmc_log), 'wrong underlying log hash')
+                    require(underlying['binary_sha256'] == binary_meta['cbmc']['sha256'],
+                            'wrong underlying binary hash')
+                    accepted = baseline_ok(underlying, cbmc_text) if variant == 'baseline' else fix_ok(underlying, cbmc_text)
+                    # Baseline test.pl fails its positive descriptor; no generic error is accepted.
+                    runner_ok = (rec['status'] == 'EXITED' and rec['complete']
+                                 and rec['signal'] == 0 and rec['exit'] == (1 if variant == 'baseline' else 0))
+                    state['regressions'][key] = {'status': 'PASS' if accepted and runner_ok else 'FAIL',
+                        'oracle_met': bool(accepted and runner_ok),
+                        'runner': rec, 'underlying': underlying,
+                        'descriptor_sha256': sha(folder/'test.desc'),
+                        'main_sha256': sha(folder/'main.c'), 'profile': profile,
+                        'solver_invocation_established': False,
+                        'selection': '1 descriptor / 0 skips'}
+                    snapshot()
+                    require(accepted and runner_ok, key+': failed differential oracle')
+            if variant != 'baseline':
+                binary = binaries['unit']
+                filters = ','.join(cfg['units'])
+                rec = execute([str(binary), filters, '--list-test-names-only'], model,
+                              report/(variant+'-unit-list.log'), 90, memory=6*1024**3)
+                names = (report/(variant+'-unit-list.log')).read_text().splitlines()
+                # Catch returns the number of listed cases (4), rather than success=0.
+                require(rec['complete'] and rec['exit'] == 4 and rec['signal'] == 0
+                        and sorted(names) == sorted(cfg['units']), 'wrong Catch listing')
+                for i, name in enumerate(cfg['units']):
+                    state['units'][variant+'/'+name] = {'status': 'IN_PROGRESS'}
+                    snapshot()
+                    rec = execute([str(binary), name], model,
+                                  report/(variant+'-unit-'+str(i)+'.log'), 90,
+                                  memory=6*1024**3)
+                    text = (report/(variant+'-unit-'+str(i)+'.log')).read_text()
+                    ok = unit_ok(rec, text)
+                    state['units'][variant+'/'+name] = {'status': 'PASS' if ok else 'FAIL',
+                                                       'oracle_met': ok, 'execution': rec,
+                                                       'binary': binary_meta['unit']}
+                    snapshot()
+                    require(ok, 'unit case failed: '+variant+'/'+name)
+        state['status'] = 'FOCUSED_CI_PASS'
+    except Exception as error:
+        state.update(status='STOP', error=repr(error))
+        for field in ('format', 'lint'):
+            if state[field] == 'IN_PROGRESS':
+                state[field] = 'STOP'
+        for field in ('builds', 'regressions', 'units', 'executions'):
+            for value in state[field].values():
+                if isinstance(value, dict) and value.get('status') == 'IN_PROGRESS':
+                    value['status'] = 'STOP'
+        raise
+    finally:
+        snapshot()
+
+
+def main():
+    if sys.argv[1] == 'probe':
+        receipt = Path(sys.argv[2])
+        argv = sys.argv[3:]
+        rec = execute(argv, Path.cwd(), receipt.with_suffix('.log'), 120,
+                      cap=MIB, memory=6*1024**3)
+        rec['binary_sha256'] = sha(argv[0])
+        save(receipt, rec)
+        sys.stdout.buffer.write(receipt.with_suffix('.log').read_bytes())
+        # test.pl receives the original normal exit or its shell signal encoding;
+        # the receipt preserves the original exit and signal separately.
+        return rec['exit'] if rec['exit'] is not None else 128+(rec['signal'] or 1)
+    require(sys.argv[1] == 'run', 'unknown mode')
+    run_all(*(Path(p).resolve() for p in sys.argv[2:]))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())

diff --git a/regression/cbmc/byte_extract_empty_struct_array/main.c b/regression/cbmc/byte_extract_empty_struct_array/main.c
new file mode 100644
index 0000000000000000000000000000000000000000..e42bc94e65c67633f9446c2f5749b4cb77f99292
--- /dev/null
+++ b/regression/cbmc/byte_extract_empty_struct_array/main.c
@@ -0,0 +1,29 @@
+#include <string.h>
+
+// GNU C: an empty struct, and any array of it, has size zero.
+struct empty
+{
+};
+
+struct with_empty_structs
+{
+  unsigned char a[4];
+  struct empty z[2];
+  unsigned char b[4];
+};
+
+int main(void)
+{
+  unsigned char buf[8];
+  memset(buf, 0x5a, sizeof(buf));
+
+  struct with_empty_structs s = *(struct with_empty_structs *)buf;
+
+  for(unsigned i = 0; i < 4; ++i)
+  {
+    __CPROVER_assert(s.a[i] == 0x5a, "bytes before the empty structs");
+    __CPROVER_assert(s.b[i] == 0x5a, "bytes after the empty structs");
+  }
+
+  return 0;
+}
diff --git a/regression/cbmc/byte_extract_empty_struct_array/test.desc b/regression/cbmc/byte_extract_empty_struct_array/test.desc

index 0000000000000000000000000000000000000000..dbd291da697154796df6142bdf9956e0cefa3dc5
--- /dev/null
+++ b/.github/workflows/cbmc-zst-bits2expr.yml
@@ -0,0 +1,61 @@
+name: CBMC ZST environment and util follow-up
+on:
+  push:
+    branches: ['ci/zst-bits2expr-util-z3-*']
+permissions:
+  contents: read
+concurrency:
+  group: cbmc-zst-util-${{ github.ref }}
+  cancel-in-progress: false
+jobs:
+  util:
+    if: github.repository == 'Tiramisu-Cake/cbmc'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    env:
+      TESTPL_JOBS: '1'
+      TESTPL_COLOR_OUTPUT: '0'
+      DEBIAN_FRONTEND: noninteractive
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          path: package
+          fetch-depth: 0
+          persist-credentials: false
+      - name: Initialize report directory
+        run: mkdir -p "$GITHUB_WORKSPACE/reports/fix"
+      - name: Install r2 dependencies plus Z3 and pinned formatter
+        timeout-minutes: 10
+        run: python3 package/scripts/zst-bits2expr/followup.py install "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE/model" "$GITHUB_WORKSPACE/reports/fix"
+      - name: Prepare exact unchanged fix source
+        timeout-minutes: 5
+        run: python3 package/scripts/zst-bits2expr/followup.py prepare "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE/model" "$GITHUB_WORKSPACE/reports/fix"
+      - name: Runner isolated synthetic checks
+        timeout-minutes: 2
+        run: |
+          python3 package/scripts/zst-bits2expr/test_runner.py
+          python3 package/scripts/zst-bits2expr/test_followup.py
+      - name: Z3 package path version and check-sat preflight
+        timeout-minutes: 3
+        run: python3 package/scripts/zst-bits2expr/followup.py preflight "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE/model" "$GITHUB_WORKSPACE/reports/fix"
+      - name: Configure and build unit only with r2 flags
+        timeout-minutes: 58
+        run: python3 package/scripts/zst-bits2expr/followup.py build "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE/model" "$GITHUB_WORKSPACE/reports/fix"
+      - name: Record selection and run focused sanity then remaining util
+        timeout-minutes: 23
+        run: python3 package/scripts/zst-bits2expr/followup.py test "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE/model" "$GITHUB_WORKSPACE/reports/fix"
+      - name: Check unchanged source formatting with 18.1.8
+        if: always()
+        timeout-minutes: 3
+        run: python3 package/scripts/zst-bits2expr/check_format.py "$GITHUB_WORKSPACE/format-env/bin" "$GITHUB_WORKSPACE/reports/fix"
+      - name: Finalize honest partial or NOT_RUN report
+        if: always()
+        timeout-minutes: 2
+        run: python3 package/scripts/zst-bits2expr/followup.py finalize "$GITHUB_WORKSPACE/package" "$GITHUB_WORKSPACE/model" "$GITHUB_WORKSPACE/reports/fix"
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: cbmc-zst-util-fix-${{ github.sha }}
+          path: reports/fix/
+          if-no-files-found: error
+          retention-days: 14

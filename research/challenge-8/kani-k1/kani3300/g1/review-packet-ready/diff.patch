+    wide: u32,
+    narrow: u8,
+    z: (),
+    pair: [u16; 2],
+    padded: ManuallyDrop<Padded>,
+    tuple: ManuallyDrop<(u8, u32)>,
+    padded_pair: [ManuallyDrop<Padded>; 2],
+    zst_array: [(); 2],
+    ptr: *mut u32,
+    fat: *const [u8],
+}
+#[derive(Clone, Copy)]
+union RU {
+    wide: u32,
+    narrow: u8,
+    z: (),
+    pair: [u16; 2],
+    padded: ManuallyDrop<Padded>,
+    tuple: ManuallyDrop<(u8, u32)>,
+    padded_pair: [ManuallyDrop<Padded>; 2],
+    zst_array: [(); 2],
+    ptr: *mut u32,
+    fat: *const [u8],
+}
+#[repr(C, align(8))]
+#[derive(Clone, Copy)]
+union TailC {
+    bytes: [u8; 5],
+    word: u32,
+}
+#[repr(align(8))]
+#[derive(Clone, Copy)]
+union TailR {
+    bytes: [u8; 5],
+    word: u32,
+}
+
+unsafe fn tail_c_padding(p: *const TailC) -> *const u8 {
+    unsafe {
+        p.cast::<u8>().add(std::mem::offset_of!(TailC, bytes) + std::mem::size_of::<[u8; 5]>())
+    }
+}
+unsafe fn tail_r_padding(p: *const TailR) -> *const u8 {
+    unsafe {
+        p.cast::<u8>().add(std::mem::offset_of!(TailR, bytes) + std::mem::size_of::<[u8; 5]>())
+    }
+}
+
+#[kani::proof]
+fn unwritten_c() {
+    let u = CU { z: () };
+    let p = &u as *const CU;
+    unsafe {
+        let _value = (*p).wide;
+    }
+}
+#[kani::proof]
+fn unwritten_rust() {
+    let u = RU { z: () };
+    let p = &u as *const RU;
+    unsafe {
+        let _value = (*p).wide;
+    }
+}
+#[kani::proof]
+fn narrow_then_wide_c() {

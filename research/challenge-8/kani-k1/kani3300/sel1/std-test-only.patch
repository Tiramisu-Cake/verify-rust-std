+//! Gate B-prime: concrete closure comparator companion, enabled only for replay controls.
+//! This proves its own bounded target, not the generic fn-pointer `merge_profile<P>`.
+
+use super::merge::profiles::{
+    LtU8, Profile, merge_halves_sorted, merge_regions, model_count, model_sorted,
+};
+use crate::mem::MaybeUninit;
+use crate::slice::sort::shared::smallsort::{SMALL_SORT_GENERAL_SCRATCH_LEN, bidirectional_merge};
+use crate::{kani, ptr};
+
+// The original profile's canonical comparator guard is discharged by construction:
+// no comparator parameter or fn-pointer coercion exists; the closure calls lt_u8 directly.
+// The remaining clauses are exactly merge_profile::<LtU8>'s clauses.
+#[cfg(kani_smallsort_controls)]
+#[kani::requires(merge_regions::<u8>(v, dst) && merge_halves_sorted::<LtU8>(v))]
+#[kani::modifies(ptr::slice_from_raw_parts_mut(dst, v.len()))]
+#[kani::ensures(|_| model_sorted::<LtU8>(dst, v.len()))]
+#[kani::ensures(|_| model_count::<LtU8>(v.as_ptr(), v.len()) == model_count::<LtU8>(dst, v.len()))]
+pub(crate) unsafe fn merge_profile_closure_u8(v: &[u8], dst: *mut u8) {
+    // SAFETY: the unchanged profile region/sorted-halves premises establish the source
+    // and destination geometry; lt_u8 is the fixed canonical key order (x >> 1).
+    unsafe { bidirectional_merge(v, dst, &mut |a: &u8, b: &u8| super::merge::lt_u8(a, b)) }
+}
+
+#[cfg(kani_smallsort_controls)]
+#[kani::proof_for_contract(merge_profile_closure_u8)]
+#[kani::unwind(34)]
+fn merge_profile_closure_scratch48_u8_n9() {
+    const N: usize = 9;
+    const { assert!(N >= 2 && N <= 32) };
+    LtU8::set_probe(kani::any());
+    let input: [u8; N] = kani::any();
+    let mut dst: [u8; N] = kani::any();
+    let stable: bool = kani::any();
+    let mut stable_scratch = [MaybeUninit::<u8>::uninit(); SMALL_SORT_GENERAL_SCRATCH_LEN];
+    let mut general_scratch = MaybeUninit::<[u8; SMALL_SORT_GENERAL_SCRATCH_LEN]>::uninit();
+    let src = if stable {
+        stable_scratch.as_mut_ptr() as *mut u8
+    } else {
+        general_scratch.as_mut_ptr() as *mut u8
+    };
+    // SAFETY: copy initializes only prefix N of the selected 48-slot backing before
+    // forming a slice; dst is separate and initialized. The enclosing PFC checks the
+    // concrete companion's unchanged region and sorted-half contract.
+    unsafe {
+        ptr::copy_nonoverlapping(input.as_ptr(), src, N);
+        let v = crate::slice::from_raw_parts(src, N);
+        merge_profile_closure_u8(v, dst.as_mut_ptr());
+    }
+    kani::cover(!stable, "general scratch48 merge contract checked");
+    kani::cover(stable, "stable scratch48 merge contract checked");
+}

++//! Opt-in raw-helper uninitialized-read controls. Preparation only; NOT_RUN.
++//!
++//! Run with the organizer --no-assert-contracts profile: the negative calls
++//! the actual Original helper body and intentionally violates its source
++//! initializedness requirement. It is a checker control, not a contract proof.
++
++use super::super::sort4_stable;
++use crate::mem::MaybeUninit;
++use crate::{kani, ptr};
++
++fn read_less_u64(a: &u64, b: &u64) -> bool {
++    // The negative intentionally exercises the live read of an unwritten
++    // source value; no initialized reference is constructed before the helper.
++    unsafe {
++        ptr::read_volatile(a);
++        ptr::read_volatile(b);
++    }
++    kani::any()
++}
++
++fn exercise_sort4_raw<const INITIALIZE_SLOT_ONE: bool>() {
++    let mut src = [MaybeUninit::<u64>::uninit(); 4];
++    src[0].write(kani::any());
++    if INITIALIZE_SLOT_ONE {
++        src[1].write(kani::any());
++    }
++    src[2].write(kani::any());
++    src[3].write(kani::any());
++    let mut dst = MaybeUninit::<[u64; 4]>::uninit();
++    let raw = src.as_mut_ptr().cast::<u64>();
++    kani::cover(true, "sort4 raw helper entered");
++    // The legal instance supplies four initialized source values. The negative
++    // leaves precisely slot 1 unwritten in the same valid MU allocation.
++    // Both use the identical source/destination geometry and actual helper.
++    unsafe { sort4_stable(raw, dst.as_mut_ptr().cast(), &mut read_less_u64) };
++    kani::cover(true, "sort4 raw helper returned");
++}
++
++#[kani::proof]
++#[kani::unwind(16)]
++fn sort4_raw_all_initialized_u64() {
++    exercise_sort4_raw::<true>();
++}
++
++#[kani::proof]
++#[kani::unwind(16)]
++fn sort4_raw_hole_negative_u64() {
++    exercise_sort4_raw::<false>();
++}

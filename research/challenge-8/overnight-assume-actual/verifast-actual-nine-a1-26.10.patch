+  let certify_sort4_a1_nine (vf_mir : VfMirRd.VfMir.t) root =
+    let open Sort4A1Nine in
+    active := false;
+    transmute_redirects := 0;
+    assume_init_redirects := 0;
+    if not !Sort4SelectIntrinsic.actual_nine_admitted ||
+       Sys.getenv_opt "SORT4_ACTUAL_OWNER_REPO_ROOT" <> Some root ||
+       Sys.getenv_opt "SORT4_ACTUAL_OWNER_NINE_ADMISSION" <> Some "1" ||
+       Sys.getenv_opt "SORT4_A1_LINK_REPO_ROOT" <> None then
+      reject "independent exact nine-body owner gate/root required";
+    let bodies = VfMirRd.VfMir.bodies_get_list vf_mir in
+    let transmute, method_body, outer = match bodies with
+      | [_;_;_;_;transmute;method_body;_;outer;_] ->
+          transmute, method_body, outer
+      | _ -> reject "nine-body positions" in
+    if TrName.translate_def_path (BodyRd.def_path_get transmute) <>
+         Sort4A1Link.callee_name ||
+       TrName.translate_def_path (BodyRd.def_path_get method_body) <>
+         Sort4A1Link.caller_name ||
+       TrName.translate_def_path (BodyRd.def_path_get outer) <>
+         "select_unpredictable" then
+      reject "nine-body A1/outer DefPaths";
+    let* transmute_loc = translate_span_data
+      (BodyRd.fn_sig_span_get transmute) in
+    let* method_loc = translate_span_data
+      (BodyRd.fn_sig_span_get method_body) in
+    let* outer_loc = translate_span_data
+      (BodyRd.fn_sig_span_get outer) in
+    let source_path = function
+      | Ast.Lexed (((path,_,_), (last_path,_,_)))
+        when path = last_path && Filename.check_suffix path "verified/lib.rs" ->
+          path
+      | _ -> reject "A1/outer source spans" in
+    let path = source_path transmute_loc in
+    if source_path method_loc <> path || source_path outer_loc <> path ||
+       sort4_actual_owner_sha256 (Sort4MaybeUninit.read_file path) <>
+         "8629849c2d2ddde1eeb90fadb6a151dc52e626385578f89f0d86fce842c61eb8"
+    then reject "exact nine-body verified source unit";
+    if not (Sort4A1Link.local_shape transmute &&
+            Sort4A1Link.local_shape method_body) then
+      reject "A1 pointer-local declarations";
+    Sort4A1Link.interface transmute "src";
+    Sort4A1Link.interface method_body "storage";
+    Sort4A1Link.check_graph transmute method_body;
+    check_outer_call outer;
+    active := true;
+    Printf.printf
+      "SORT4-A1-NINE: exact source, typed local pair and outer cleanup call admitted\n%!";
+    Ok ()

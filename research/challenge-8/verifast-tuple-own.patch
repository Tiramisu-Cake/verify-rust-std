     else
       Func (l, Fixpoint, func_tparams, Some (PredTypeExpr (l, own_paramTypes, None)), sn ^ "_own", [], false, (None, None), None, false, None, false, []);
     TypePredDef (l, tparams, structTypeExpr, "own", Left (l, sn ^ "_own"));

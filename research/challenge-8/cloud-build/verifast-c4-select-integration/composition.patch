+| SplitFractionStmt (_, _, _, _, _) -> failwith "Ocaml_expr_of_ast: unsupported SplitFractionStmt"
+| MergeFractionsStmt (l, a) -> C ("MergeFractionsStmt", [of_loc l; of_expr a])
+| CreateBoxStmt (_, _, _, _, _, _, _) -> failwith "Ocaml_expr_of_ast: unsupported CreateBoxStmt"
+| CreateHandleStmt (_, _, _, _, _) -> failwith "Ocaml_expr_of_ast: unsupported CreateHandleStmt"
+| DisposeBoxStmt (_, _, _, _) -> failwith "Ocaml_expr_of_ast: unsupported DisposeBoxStmt"
 | LabelStmt (l, lbl) -> C ("LabelStmt", [of_loc l; S lbl])
 | GotoStmt (l, lbl) -> C ("GotoStmt", [of_loc l; S lbl])
 | NoopStmt l -> C ("NoopStmt", [of_loc l])

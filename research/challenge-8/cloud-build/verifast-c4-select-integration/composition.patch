+          let current_packages = List.map (function
+            | Ast.PackageDecl (loc, package_name, imports, ds) ->
+                let ds = List.filter (fun decl ->
+                  match AstAux.decl_loc_name_and_name_setter decl with
+                  | None -> true
+                  | Some (_, name, _) ->
+                      let key = if package_name = "" then name else
+                        package_name ^ "::" ^ name in
+                      match List.assoc_opt key imported_map with
+                      | None -> true
+                      | Some other when
+                          Marshal.to_string decl [Marshal.No_sharing] =
+                          Marshal.to_string other [Marshal.No_sharing] -> false
+                      | Some _ -> reject ("declaration collision: " ^ key)) ds in
+                Ast.PackageDecl (loc, package_name, imports, ds)
+            | _ -> reject "current flattened AST contains non-package declaration")
+            flattened in
+          let merged_decls = imported_decls @ current_packages in
+          Printf.printf
+            "SORT4-C4-SELECT-AST: importing nine definitions sha256=%s relocated_sha256=%s reverse_sha256=%s location_occurrences=%d\n%!"
+            expected relocated_sha256
+            (sort4_actual_owner_sha256 reverse_relocated) count;
+          headers, merged_decls
+      in
+      Ok (headers, flattened, Some debug_infos)
     in
     match job () with
     | Ok res -> res

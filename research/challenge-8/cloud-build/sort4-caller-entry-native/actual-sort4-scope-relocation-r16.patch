+(* Fail-closed lexical-use validation for the R16 source-certified MIR
+   declaration relocation. This walks every statement constructor emitted by
+   this translator and delegates expression recursion to Ast.expr_iter (whose
+   default branch is a static error). *)
+let validate_actual_scope_relocation expected_types body =
+  let ids = List.map fst expected_types in
+  let exception Invalid of string in
+  let reject reason = raise (Invalid reason) in
+  let refs = Hashtbl.create 31 in
+  let decls = Hashtbl.create 31 in
+  List.iter (fun id -> Hashtbl.add refs id (ref 0); Hashtbl.add decls id (ref 0)) ids;
+  let markers = ref 0 in
+  let target id = Hashtbl.mem refs id in
+  let record_ref inside id = if target id then begin
+    if not inside then reject ("target reference outside cmp scope: " ^ id);
+    incr (Hashtbl.find refs id)
+  end in
+  let rec scan_expr inside e =
+    Ast.expr_iter (fun node ->
+      (match node with
+       | Ast.Var (_, id) | Ast.WVar (_, id, _) -> record_ref inside id
+       | Ast.AddressOf (_, inner) ->
+           Ast.expr_iter (function
+             | Ast.Var (_, id) | Ast.WVar (_, id, _) when target id ->
+                 reject ("address-taken target local: " ^ id)
+             | _ -> ()) inner
+       | _ -> ());
+      scan_expr_patterns inside node) e
+  and scan_expr_patterns inside = function
+    | Ast.SliceExpr (_, a, b) -> Option.iter (scan_pat inside) a; Option.iter (scan_pat inside) b
+    | Ast.CallExpr (_, _, _, p0, ps, _) -> scan_pats inside (p0 @ ps)
+    | Ast.ExprCallExpr (_, _, ps) -> scan_pats inside ps
+    | Ast.SwitchExpr (_, _, clauses, _) ->
+        List.iter (function Ast.SwitchExprClause (_, _, names, _) ->
+          List.iter (fun id -> if target id then reject ("target local shadowed in switch expression: " ^ id)) names) clauses
+    | Ast.WSwitchExpr (_, _, _, _, clauses, _, _, _) ->
+        List.iter (function Ast.SwitchExprClause (_, _, names, _) ->
+          List.iter (fun id -> if target id then reject ("target local shadowed in switch expression: " ^ id)) names) clauses
+    | Ast.PointsTo (_, _, _, pat) | Ast.WPointsTo (_, _, _, _, pat) -> scan_pat inside pat
+    | Ast.PredAsn (_, _, _, indices, args, _) | Ast.WPredAsn (_, _, _, _, indices, args) ->
+        scan_pats inside (indices @ args)
+    | Ast.PredExprAsn (_, _, pats) | Ast.WPredExprAsn (_, _, _, _, pats) -> scan_pats inside pats
+    | Ast.InstPredAsn (_, _, _, index, pats) -> scan_expr inside index; scan_pats inside pats
+    | Ast.WInstPredAsn (_, eopt, _, _, _, _, index, pats) ->
+        Option.iter (scan_expr inside) eopt; scan_expr inside index; scan_pats inside pats
+    | Ast.MatchAsn (_, _, pat) | Ast.WMatchAsn (_, _, pat, _) -> scan_pat inside pat
+    | Ast.CoefAsn (_, pat, _) -> scan_pat inside pat
+    | Ast.WSwitchAsn (_, _, _, clauses) -> List.iter (function
+        | Ast.WSwitchAsnClause (_, _, _, names, _, body) ->
+            List.iter (Option.iter (fun id -> if target id then reject ("target local shadowed in switch assertion: " ^ id))) names;
+            scan_expr inside body) clauses
+    | Ast.ForallAsn (_, _, binder, e) ->
+        if target binder then reject ("target local shadowed by forall binder: " ^ binder);
+        scan_expr inside e
+    | Ast.LetTypeAsn (_, binder, _, body) ->
+        if target binder then reject ("target local shadowed by let-type binder: " ^ binder);
+        scan_expr inside body
+    | Ast.EnsuresAsn (_, binder, body) ->
+        if target binder then reject ("target local shadowed by ensures binder: " ^ binder);
+        scan_expr inside body
+    | _ -> ()
+  and scan_pats inside ps = List.iter (scan_pat inside) ps
+  and scan_pat inside = function
+    | Ast.LitPat e -> scan_expr inside e
+    | Ast.VarPat (_, id) when target id -> reject ("target local used as pattern binder: " ^ id)
+    | Ast.VarPat _ | Ast.DummyPat | Ast.DummyVarPat -> ()
+    | Ast.CtorPat (_, _, ps) -> List.iter (scan_pat inside) ps
+    | Ast.WCtorPat (_, _, _, _, _, _, ps, eopt) ->
+        List.iter (scan_pat inside) ps; Option.iter (scan_expr inside) eopt
+  in
+  let rec scan_producing inside = function
+    | Ast.BasicProducingHandlePredicate (_, _, es) -> List.iter (scan_expr inside) es
+    | Ast.ConditionalProducingHandlePredicate (_, e, _, es, rest) ->
+        scan_expr inside e; List.iter (scan_expr inside) es; scan_producing inside rest
+  in
+  let scan_consuming inside (Ast.ConsumingHandlePredicate (_, _, ps)) = scan_pats inside ps in
+  let is_scope_marker = function
+    | Ast.ExprStmt (Ast.CallExpr (_, "#strict_lft_binding_scope",
+        [Ast.IdentTypeExpr (_, None, "'cmp")], [], [], Ast.Static)) -> true
+    | _ -> false
+  in
+  let malformed_scope_marker = function
+    | Ast.ExprStmt (Ast.CallExpr (_, "#strict_lft_binding_scope", _, _, _, Ast.Static)) -> true
+    | _ -> false
+  in
+  let rec scan_list inherited ss =
+    let active = ref inherited in
+    List.iter (fun s ->
+      if malformed_scope_marker s then begin
+        if not (is_scope_marker s) then reject "malformed strict lifetime marker";
+        incr markers;
+        if !markers <> 1 then reject "duplicate strict lifetime marker";
+        active := true
+      end;
+      scan_stmt !active s) ss
+  and scan_stmt inside s =
+    let scan_opt_expr = Option.iter (scan_expr inside) in
+    match s with
+    | Ast.PureStmt (_, s) | Ast.NonpureStmt (_, _, s) -> scan_stmt inside s
+    | Ast.DeclStmt (_, ds) -> List.iter (fun (_, ty, id, init, (taken, _)) ->
+        if target id then begin
+          incr (Hashtbl.find decls id);
+          if not inside then reject ("target declaration outside cmp scope: " ^ id);
+          if !taken then reject ("address-taken target declaration: " ^ id);
+          let expected = List.assoc_opt id expected_types in
+          if ty = None || init <> None || expected <> Some ty then
+            reject ("target declaration has wrong shape or type: " ^ id)
+        end;
+        scan_opt_expr init) ds
+    | Ast.ExprStmt e -> scan_expr inside e
+    | Ast.IfStmt (_, e, a, b) -> scan_expr inside e; scan_list inside a; scan_list inside b
+    | Ast.SwitchStmt (_, e, cs) ->
+        scan_expr inside e;
+        List.iter (function
+          | Ast.SwitchStmtClause (_, e, ss) -> scan_expr inside e; scan_list inside ss
+          | Ast.SwitchStmtDefaultClause (_, ss) -> scan_list inside ss) cs
+    | Ast.Assert (_, a) | Ast.Leak (_, a) | Ast.InvariantStmt (_, a) -> scan_expr inside a
+    | Ast.SpecStmt (_, a, b) -> scan_expr inside a; scan_expr inside b
+    | Ast.Open (_, e, _, _, indices, args, coef)
+    | Ast.Close (_, e, _, _, indices, args, coef) ->
+        scan_opt_expr e; scan_pats inside indices; scan_pats inside args; Option.iter (scan_pat inside) coef
+    | Ast.ReturnStmt (_, e) -> scan_opt_expr e
+    | Ast.WhileStmt (_, e, spec, dec, ss, final_ss) ->
+        scan_expr inside e;
+        Option.iter (function Ast.LoopInv a -> scan_expr inside a | Ast.LoopSpec (a,b) -> scan_expr inside a; scan_expr inside b) spec;
+        scan_opt_expr dec; scan_list inside ss; scan_list inside final_ss
+    | Ast.BlockStmt (_, ds, ss, _, _) ->
+        List.iter (function
+          | Ast.TypeWithTypeidDecl (_, name, e) ->
+              if target name then reject ("target local shadowed by type binder: " ^ name);
+              scan_expr inside e
+          | _ -> reject "unsupported declaration in candidate scope AST") ds;
+        scan_list inside ss
+    | Ast.PerformActionStmt (_, _, _, pats, consuming, _, _, args, ss, _, post, producing) ->
+        scan_pats inside pats; List.iter (scan_consuming inside) consuming;
+        List.iter (scan_expr inside) args; scan_list inside ss;
+        Option.iter (fun (_, es) -> List.iter (scan_expr inside) es) post;
+        List.iter (fun (_, p) -> scan_producing inside p) producing
+    | Ast.SplitFractionStmt (_, _, _, pats, e) -> scan_pats inside pats; scan_opt_expr e
+    | Ast.MergeFractionsStmt (_, a) -> scan_expr inside a
+    | Ast.CreateBoxStmt (_, _, _, args, lower, upper, handles) ->
+        List.iter (scan_expr inside) (args @ lower @ upper);
+        List.iter (fun (_, _, _, _, es) -> List.iter (scan_expr inside) es) handles
+    | Ast.CreateHandleStmt (_, _, _, _, e) -> scan_expr inside e
+    | Ast.DisposeBoxStmt (_, _, pats, handles) ->
+        scan_pats inside pats; List.iter (fun (_, _, ps) -> scan_pats inside ps) handles
+    | Ast.LabelStmt _ | Ast.GotoStmt _ | Ast.NoopStmt _ | Ast.Break _ | Ast.Continue _ -> ()
+    | Ast.ProduceLemmaFunctionPointerChunkStmt (_, e, proof, nested) ->
+        scan_opt_expr e;
+        Option.iter (fun (_, _, _, args, params, ss, _) ->
+          List.iter (scan_expr inside) args;
+          List.iter (fun (_, id) -> if target id then reject ("target local shadowed by lemma pointer binder: " ^ id)) params;
+          scan_list inside ss) proof;
+        Option.iter (scan_stmt inside) nested
+    | Ast.DuplicateLemmaFunctionPointerChunkStmt (_, e) -> scan_expr inside e
+    | Ast.ProduceFunctionPointerChunkStmt (_, _, e, _, args, params, _, ss, _) ->
+        scan_expr inside e; List.iter (scan_expr inside) args;
+        List.iter (fun (_, id) -> if target id then reject ("target local shadowed by function pointer binder: " ^ id)) params;
+        scan_list inside ss
+    | Ast.Throw (_, e) -> scan_expr inside e
+    | Ast.TryCatch (_, ss, catches) ->
+        scan_list inside ss;
+        List.iter (fun (_, _, binder, body) ->
+          if target binder then reject ("target local shadowed by catch binder: " ^ binder);
+          scan_list inside body) catches
+    | Ast.TryFinally (_, body, _, final_body) -> scan_list inside body; scan_list inside final_body
+    | Ast.SuperConstructorCall (_, es) -> List.iter (scan_expr inside) es
+    | _ -> reject "unknown statement constructor in candidate scope AST"
+  in
+  try
+    scan_list false body;
+    if !markers <> 1 then reject "strict cmp marker is not unique";
+    List.iter (fun id ->
+      if !(Hashtbl.find decls id) <> 1 then reject ("target declaration count is not one: " ^ id);
+      if !(Hashtbl.find refs id) = 0 then reject ("target has no complete-body use: " ^ id)) ids;
+    Ok ()
+  with Invalid why -> Error why
+
+let run_actual_scope_relocation_controls loc =
+  let id = "__r16_scope_validator_control" in
+  let ty = Ast.IdentTypeExpr (loc, None, "i32") in
+  let expected = [id, Some ty] in
+  let marker = Ast.ExprStmt (Ast.CallExpr
+    (loc, "#strict_lft_binding_scope",
+     [Ast.IdentTypeExpr (loc, None, "'cmp")], [], [], Ast.Static)) in
+  let decl ty taken = Ast.DeclStmt
+    (loc, [(loc, ty, id, None, (ref taken, ref None))]) in
+  let var = Ast.ExprStmt (Ast.Var (loc, id)) in
+  let block ss = Ast.BlockStmt (loc, [], ss, loc, ref []) in
+  let inside ss = [block (marker :: ss)] in
+  let starts_with prefix text =
+    String.length text >= String.length prefix &&
+    String.sub text 0 (String.length prefix) = prefix in
+  let expect_refusal name prefix body =
+    match validate_actual_scope_relocation expected body with
+    | Error reason when starts_with prefix reason -> true
+    | Error reason -> failwith
+        ("R16 scope validator control " ^ name ^ " refused for unexpected reason: " ^ reason)
+    | Ok () -> failwith ("R16 scope validator control unexpectedly accepted: " ^ name)
+  in
+  let expect_unsupported_expr body =
+    try
+      match validate_actual_scope_relocation expected body with
+      | Error reason -> failwith
+          ("R16 unsupported-expression control refused for unexpected reason: " ^ reason)
+      | Ok () -> failwith "R16 unsupported-expression control unexpectedly accepted"
+    with
+    | Ast.StaticError (_, "This expression form is not allowed in this position.", _) -> true
+  in
+  let positive = match validate_actual_scope_relocation expected
+      (inside [decl (Some ty) false; var]) with
+    | Ok () -> true
+    | Error reason -> failwith ("R16 positive scope control refused: " ^ reason) in
+  let cases = [
+    ("positive", positive);
+    ("outside-use", expect_refusal "outside-use" "target reference outside cmp scope:"
+       (inside [decl (Some ty) false] @ [var]));
+    ("address-taken", expect_refusal "address-taken" "address-taken target local:"
+       (inside [decl (Some ty) false;
+         Ast.ExprStmt (Ast.AddressOf (loc, Ast.Var (loc, id)))]));
+    ("duplicate-declaration", expect_refusal "duplicate-declaration"
+       "target declaration count is not one:"
+       (inside [decl (Some ty) false; decl (Some ty) false; var]));
+    ("wrong-type", expect_refusal "wrong-type" "target declaration has wrong shape or type:"
+       (inside [decl (Some (Ast.IdentTypeExpr (loc, None, "u8"))) false; var]));
+    ("taken-flag", expect_refusal "taken-flag" "address-taken target declaration:"
+       (inside [decl (Some ty) true; var]));
+    ("missing-marker", expect_refusal "missing-marker" "strict cmp marker is not unique"
+       [block [decl (Some ty) false; var]]);
+    ("duplicate-marker", expect_refusal "duplicate-marker" "duplicate strict lifetime marker"
+       [block [marker; marker; decl (Some ty) false; var]]);
+    ("malformed-marker", expect_refusal "malformed-marker" "malformed strict lifetime marker"
+       [block [
+         Ast.ExprStmt (Ast.CallExpr
+           (loc, "#strict_lft_binding_scope",
+            [Ast.IdentTypeExpr (loc, None, "'wrong")], [], [], Ast.Static));
+         decl (Some ty) false; var]]);
+    ("unsupported-expression", expect_unsupported_expr
+       (inside [decl (Some ty) false;
+         Ast.ExprStmt (Ast.CxxConstruct (loc, "synthetic", ty, []))]))
+  ] in
+  List.iter (fun (name, passed) ->
+    if not passed then failwith ("R16 scope validator synthetic control failed: " ^ name);
+    Printf.eprintf "ACTUAL-SCOPE-RELOCATION control=%s status=PASS\n%!" name) cases;
+  Printf.eprintf "ACTUAL-SCOPE-RELOCATION controls=10 status=PASS\n%!"
+

+  let rec a1_contains_self_type_expr (te : Ast.type_expr) =
+    match te with
+    | Ast.IdentTypeExpr (_, None, "Self") -> true
+    | _ ->
+        Ast.type_expr_fold_open
+          (fun found child -> found || a1_contains_self_type_expr child)
+          false te
+
+  let rec a1_specialize_self_type_expr (te : Ast.type_expr) =
+    let open Ast in
+    match te with
+    | IdentTypeExpr (l, None, "Self") -> IdentTypeExpr (l, None, "T")
+    | RustRefTypeExpr (l, lft, kind, pointee) ->
+        RustRefTypeExpr (l, a1_specialize_self_type_expr lft, kind,
+                         a1_specialize_self_type_expr pointee)
+    | SliceTypeExpr (l, elem) ->
+        SliceTypeExpr (l, a1_specialize_self_type_expr elem)
+    | ConstructedTypeExpr (l, name, args) ->
+        ConstructedTypeExpr (l, name, List.map a1_specialize_self_type_expr args)
+    | StructTypeExpr (l, Some "std::mem::MaybeUninit", None, [], [elem]) ->
+        StructTypeExpr
+          (l, Some "std::mem::MaybeUninit", None, [],
+           [a1_specialize_self_type_expr elem])
+    | _ when a1_contains_self_type_expr te ->
+        Ast.static_error (Ast.type_expr_loc te)
+          "A1 impl signature has Self in an unsupported type expression" None
+    | _ -> te

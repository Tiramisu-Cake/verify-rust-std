         in
+        let body =
+          if not native_c1_capture || name <> "c1_source_prefix" then body
+          else begin
+            let reject why = failwith ("NATIVE-C1-AST-CAPTURE: " ^ why) in
+            if !native_c1_original_func_capture_seen then
+              reject "duplicate target body";
+            let source_file, source_line =
+              match Ast.lexed_loc fn_sig_loc with

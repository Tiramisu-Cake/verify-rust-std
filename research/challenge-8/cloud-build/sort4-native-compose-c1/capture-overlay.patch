+            then reject "verified source SHA256";
+            let output = "c1-original-func-ast.ml" in
+            if Sys.file_exists output then reject "preexisting output path";
+            native_c1_original_func_capture_seen := true;
+            let before = Marshal.to_string body [Marshal.No_sharing] in
+            Ocaml_expr_formatter.print_ocaml_expr_to_file false output
+              (Ocaml_expr_of_ast.of_decl body);
+            let after = Marshal.to_string body [Marshal.No_sharing] in
+            if before <> after then reject "serializer mutated original Func";
+            Printf.eprintf

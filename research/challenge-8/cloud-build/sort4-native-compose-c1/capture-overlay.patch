+              | _ -> reject "target signature location" in
+            if source_file <> "verified/lib.rs" || source_line <> 135 then
+              reject "target signature source line/path";
+            let source =
+              let ic = open_in_bin source_file in
+              Fun.protect ~finally:(fun () -> close_in ic)
+                (fun () -> really_input_string ic (in_channel_length ic)) in
+            let count_exact needle =
+              let rec loop offset count =
+                if offset + String.length needle > String.length source then count
+                else if String.sub source offset (String.length needle) = needle
+                then loop (offset + String.length needle) (count + 1)
+                else loop (offset + 1) count in
+              loop 0 0 in
+            if count_exact "pub unsafe fn c1_source_prefix<" <> 1 ||
+               count_exact "__vf_c1_compose_unwind();" <> 1 ||
+               count_exact "let c1 = is_less/*@::<F, (&'cmp T, &'cmp T), 'cmp>@*/" <> 1
+            then reject "target source inventory";
+            let read_sha path =
+              let ic = Unix.open_process_in
+                ("/usr/bin/sha256sum -- " ^ Filename.quote path) in
+              let line = input_line ic in
+              let status = Unix.close_process_in ic in
+              if status <> Unix.WEXITED 0 || String.length line < 66 ||
+                 String.sub line 64 2 <> "  " ||
+                 String.sub line 66 (String.length line - 66) <> path then
+                reject ("sha256sum failed for " ^ path);
+              String.sub line 0 64 in
+            let source_sha = read_sha source_file in
+            if source_sha <>

+fn owned_nll_capture_store() -> &'static std::sync::Mutex<HashMap<LocalDefId, OwnedNllCapture>> {
+    OWNED_NLL_CAPTURES.get_or_init(|| std::sync::Mutex::new(HashMap::new()))

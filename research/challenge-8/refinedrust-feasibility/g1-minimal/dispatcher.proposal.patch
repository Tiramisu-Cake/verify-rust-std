+#!/usr/bin/env bash
+# Recipe infrastructure entrypoint; actual driver stays in pinned proof inputs.
+set -euo pipefail
+[[ ${1:-} == refinedrust-g1-minimal ]] || exit 2
+[[ ${SMALLSORT_EXECUTION_PROVIDER:-} == cloud-build ]] || exit 2
+: "${CLOUD_BUILD_ID:?Cloud-only G1}"
+export PROOF_ROOT=${PROOF_ROOT:-/workspace/proof}
+export EVIDENCE_ROOT=${EVIDENCE_ROOT:-/workspace/evidence}
+exec bash "$PROOF_ROOT/research/challenge-8/refinedrust-feasibility/g1-minimal/entrypoint.sh"

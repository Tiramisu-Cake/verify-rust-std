+(* Temporary diagnostic registry for tracing the physical loc0 identities used
+   by vfconsole's dead-code table. This registry is independent of that table. *)
+let dead_code_loc_trace_enabled () =
+  try Sys.getenv "VF_DEAD_CODE_LOC_TRACE" = "1" with Not_found -> false
+
+let dead_code_loc_trace_ids : (loc0 * int) list ref = ref []
+let dead_code_loc_trace_next = ref 0
+let dead_code_loc_trace_ast : (int * string list) list ref = ref []
+
+let dead_code_loc_trace_id l =
+  if not (dead_code_loc_trace_enabled ()) then -1
+  else
+    match List.find_opt (fun (l0, _) -> l0 == l) !dead_code_loc_trace_ids with
+    | Some (_, id) -> id
+    | None ->
+        let id = !dead_code_loc_trace_next in
+        incr dead_code_loc_trace_next;
+        dead_code_loc_trace_ids := (l, id) :: !dead_code_loc_trace_ids;
+        id
+
+let dead_code_loc_trace_record_ast l description =
+  if dead_code_loc_trace_enabled () then begin
+    let id = dead_code_loc_trace_id l in
+    let rec add = function
+      | [] -> [id, [description]]
+      | (id0, descriptions)::rest when id0 = id ->
+          if List.mem description descriptions then (id0, descriptions)::rest
+          else (id0, description::descriptions)::rest
+      | entry::rest -> entry::add rest
+    in
+    dead_code_loc_trace_ast := add !dead_code_loc_trace_ast
+  end
+
+let dead_code_loc_trace_descriptions id =
+  try List.rev (List.assoc id !dead_code_loc_trace_ast) with Not_found -> []
+
+let dead_code_trace_expr = function
+  | CallExpr (_, name, _, _, _, _) -> "call=" ^ name
+  | _ -> "expression"
+
+let dead_code_trace_stmt_description label_context s =
+  let constructor, detail =
+    match s with
+    | PureStmt _ -> "PureStmt", ""
+    | NonpureStmt _ -> "NonpureStmt", ""
+    | DeclStmt _ -> "DeclStmt", ""
+    | ExprStmt e -> "ExprStmt", dead_code_trace_expr e
+    | IfStmt _ -> "IfStmt", ""
+    | SwitchStmt _ -> "SwitchStmt", ""
+    | Assert _ -> "Assert", ""
+    | Leak _ -> "Leak", ""
+    | Open _ -> "Open", ""
+    | Close _ -> "Close", ""
+    | ReturnStmt (_, None) -> "ReturnStmt", "value=none"
+    | ReturnStmt (_, Some e) -> "ReturnStmt", dead_code_trace_expr e
+    | WhileStmt _ -> "WhileStmt", ""
+    | BlockStmt _ -> "BlockStmt", ""
+    | PerformActionStmt _ -> "PerformActionStmt", ""
+    | SplitFractionStmt _ -> "SplitFractionStmt", ""
+    | MergeFractionsStmt _ -> "MergeFractionsStmt", ""
+    | CreateBoxStmt _ -> "CreateBoxStmt", ""
+    | CreateHandleStmt _ -> "CreateHandleStmt", ""
+    | DisposeBoxStmt _ -> "DisposeBoxStmt", ""
+    | LabelStmt (_, label) -> "LabelStmt", "label=" ^ label
+    | GotoStmt (_, label) -> "GotoStmt", "target=" ^ label
+    | NoopStmt _ -> "NoopStmt", ""
+    | InvariantStmt _ -> "InvariantStmt", ""
+    | SpecStmt _ -> "SpecStmt", ""
+    | ProduceLemmaFunctionPointerChunkStmt _ -> "ProduceLemmaFunctionPointerChunkStmt", ""
+    | DuplicateLemmaFunctionPointerChunkStmt _ -> "DuplicateLemmaFunctionPointerChunkStmt", ""
+    | ProduceFunctionPointerChunkStmt _ -> "ProduceFunctionPointerChunkStmt", ""
+    | Throw _ -> "Throw", ""
+    | TryCatch _ -> "TryCatch", ""
+    | TryFinally _ -> "TryFinally", ""
+    | Break _ -> "Break", ""
+    | Continue _ -> "Continue", ""
+    | SuperConstructorCall _ -> "SuperConstructorCall", ""
+  in
+  Printf.sprintf "label_context=%s; ast=%s%s" label_context constructor
+    (if detail = "" then "" else "(" ^ detail ^ ")")
+

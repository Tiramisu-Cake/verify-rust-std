+      | Ast.DeclStmt (_, [(_, _, id, None, _)]) :: tail when List.mem id deferred_ids -> take (n - 1) (id :: acc) tail
+      | _ -> reject "deferred declarations are not a complete prefix of the wrapper" in
+    take (List.length deferred_ids) [] ss in
+  let rec scan_list inherited ss =
+    let active = ref inherited in
+    List.iter (fun s ->
+      if malformed_scope_marker s then begin
+        let name, category = match scope_marker s with
+          | Some value -> value | None -> reject "malformed strict lifetime marker" in
+        incr markers;
+        if List.mem name !marker_names then reject "duplicate strict lifetime marker";
+        marker_names := name :: !marker_names;
+        if !active <> `Outside then reject "strict cmp marker nested in another relocation scope";
+        active := category
+      end;
+      match deferred_wrapper with
+      | Some wrapper when s == wrapper ->
+          if !active <> `Outside then reject "deferred scope nested in strict cmp scope";
+          incr deferred_wrappers;
+          if !deferred_wrappers <> 1 then reject "duplicate deferred scope wrapper";
+          begin match s with
+          | Ast.BlockStmt (_, [], inner, _, _) ->
+              if List.sort compare (wrapper_decl_ids inner) <> List.sort compare deferred_ids then
+                reject "deferred declaration order changed";
+              if wrapper_has_control_transfer inner then
+                reject "deferred scope contains a label or goto entry"
+          | _ -> reject "deferred scope wrapper has wrong AST shape"
+          end;
+          begin match s with Ast.BlockStmt (_, [], inner, _, _) -> scan_list `Deferred inner | _ -> assert false end
+      | _ -> scan_stmt !active s) ss
+  and scan_stmt scope s =
+    let scan_opt_expr = Option.iter (scan_expr scope) in
+    match s with
+    | Ast.PureStmt (_, s) | Ast.NonpureStmt (_, _, s) -> scan_stmt scope s
+    | Ast.DeclStmt (_, ds) -> List.iter (fun (_, ty, id, init, (taken, _)) ->
+        if target id then begin
+          exception_scope id scope;
+          incr (Hashtbl.find decls id);
+          if !taken then reject ("address-taken target declaration: " ^ id);
+          let expected = List.assoc_opt id expected_types in
+          if ty = None || init <> None || expected <> Some ty then
+            reject ("target declaration has wrong shape or type: " ^ id)
+        end;
+        scan_opt_expr init) ds
+    | Ast.ExprStmt e -> scan_expr scope e
+    | Ast.IfStmt (_, e, a, b) -> scan_expr scope e; scan_list scope a; scan_list scope b
+    | Ast.SwitchStmt (_, e, cs) ->
+        scan_expr scope e;
+        List.iter (function
+          | Ast.SwitchStmtClause (_, e, ss) -> scan_expr scope e; scan_list scope ss
+          | Ast.SwitchStmtDefaultClause (_, ss) -> scan_list scope ss) cs
+    | Ast.Assert (_, a) | Ast.Leak (_, a) | Ast.InvariantStmt (_, a) -> scan_expr scope a
+    | Ast.SpecStmt (_, a, b) -> scan_expr scope a; scan_expr scope b
+    | Ast.Open (_, e, _, _, indices, args, coef)
+    | Ast.Close (_, e, _, _, indices, args, coef) ->
+        scan_opt_expr e; scan_pats scope indices; scan_pats scope args; Option.iter (scan_pat scope) coef
+    | Ast.ReturnStmt (_, e) -> scan_opt_expr e
+    | Ast.WhileStmt (_, e, spec, dec, ss, final_ss) ->
+        scan_expr scope e;
+        Option.iter (function Ast.LoopInv a -> scan_expr scope a | Ast.LoopSpec (a,b) -> scan_expr scope a; scan_expr scope b) spec;
+        scan_opt_expr dec; scan_list scope ss; scan_list scope final_ss
+    | Ast.BlockStmt (_, ds, ss, _, _) ->
+        List.iter (function
+          | Ast.TypeWithTypeidDecl (_, name, e) ->
+              if target name then reject ("target local shadowed by type binder: " ^ name);
+              scan_expr scope e
+          | _ -> reject "unsupported declaration in candidate scope AST") ds;
+        scan_list scope ss
+    | Ast.PerformActionStmt (_, _, _, pats, consuming, _, _, args, ss, _, post, producing) ->
+        scan_pats scope pats; List.iter (scan_consuming scope) consuming;
+        List.iter (scan_expr scope) args; scan_list scope ss;
+        Option.iter (fun (_, es) -> List.iter (scan_expr scope) es) post;
+        List.iter (fun (_, p) -> scan_producing scope p) producing
+    | Ast.SplitFractionStmt (_, _, _, pats, e) -> scan_pats scope pats; scan_opt_expr e
+    | Ast.MergeFractionsStmt (_, a) -> scan_expr scope a
+    | Ast.CreateBoxStmt (_, _, _, args, lower, upper, handles) ->
+        List.iter (scan_expr scope) (args @ lower @ upper);
+        List.iter (fun (_, _, _, _, es) -> List.iter (scan_expr scope) es) handles
+    | Ast.CreateHandleStmt (_, _, _, _, e) -> scan_expr scope e
+    | Ast.DisposeBoxStmt (_, _, pats, handles) ->
+        scan_pats scope pats; List.iter (fun (_, _, ps) -> scan_pats scope ps) handles
+    | Ast.LabelStmt _ | Ast.GotoStmt _ | Ast.NoopStmt _ | Ast.Break _ | Ast.Continue _ -> ()
+    | Ast.ProduceLemmaFunctionPointerChunkStmt (_, e, proof, nested) ->
+        scan_opt_expr e;
+        Option.iter (fun (_, _, args, params, _, ss, _) ->
+          List.iter (scan_expr scope) args;
+          List.iter (fun (_, id) -> if target id then reject ("target local shadowed by lemma pointer binder: " ^ id)) params;
+          scan_list scope ss) proof;
+        Option.iter (scan_stmt scope) nested
+    | Ast.DuplicateLemmaFunctionPointerChunkStmt (_, e) -> scan_expr scope e
+    | Ast.ProduceFunctionPointerChunkStmt (_, _, e, _, args, params, _, ss, _) ->
+        scan_expr scope e; List.iter (scan_expr scope) args;
+        List.iter (fun (_, id) -> if target id then reject ("target local shadowed by function pointer binder: " ^ id)) params;
+        scan_list scope ss
+    | Ast.Throw (_, e) -> scan_expr scope e
+    | Ast.TryCatch (_, ss, catches) ->
+        scan_list scope ss;
+        List.iter (fun (_, _, binder, body) ->
+          if target binder then reject ("target local shadowed by catch binder: " ^ binder);
+          scan_list scope body) catches
+    | Ast.TryFinally (_, body, _, final_body) -> scan_list scope body; scan_list scope final_body
+    | Ast.SuperConstructorCall (_, es) -> List.iter (scan_expr scope) es
+    | _ -> reject "unknown statement constructor in candidate scope AST"
+  in
+  try
+    scan_list `Outside body;
+    let expected_markers = 1 + List.length indexed_expected in
+    if !markers <> expected_markers then
+      reject (if indexed_expected = [] then "strict cmp marker is not unique"
+              else "strict cmp marker inventory differs");
+    if List.length deferred_ids > 0 && !deferred_wrappers <> 1 then
+      reject "deferred scope wrapper is missing or not unique";
+    if deferred_ids = [] && !deferred_wrappers <> 0 then reject "unexpected deferred scope wrapper";
+    List.iter (fun id ->
+      if !(Hashtbl.find decls id) <> 1 then reject ("target declaration count is not one: " ^ id);
+      if !(Hashtbl.find refs id) = 0 then reject ("target has no complete-body use: " ^ id)) ids;
+    Ok ()
+  with Invalid why -> Error why
+

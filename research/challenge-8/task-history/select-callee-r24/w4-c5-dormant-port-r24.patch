+(* Select only the normal continuation after label 34. Keep that label in the
+   outer list so every pre-existing goto still lands at the same statement. *)
+let wrap_actual_deferred_suffix ?(indexed=false) loc decls stmts =
+  let continuation =
+    if not indexed then "34" else begin
+      let rec candidates = function
+        | [] -> []
+        | Ast.LabelStmt (_, name) :: tail ->
+            let control_free = not (List.exists (fun stmt ->
+              let found = ref false in
+              Ast.stmt_iter (function Ast.LabelStmt _ | Ast.GotoStmt _ -> found := true | _ -> ()) stmt;
+              !found) tail) in
+            if tail <> [] && control_free then [name] else candidates tail
+        | _ :: tail -> candidates tail in
+      match candidates stmts with
+      | [name] -> name
+      | _ -> Ast.static_error loc "R17 unique final normal continuation is unavailable" None
+    end in
+  let labels = ref [] and gotos = ref [] in
+  List.iter (Ast.stmt_iter (function
+    | Ast.LabelStmt (_, id) -> labels := id :: !labels
+    | Ast.GotoStmt (_, id) -> gotos := id :: !gotos
+    | _ -> ())) stmts;
+  let label_count = List.length (List.filter ((=) continuation) !labels) in
+  let goto_count = List.length (List.filter ((=) continuation) !gotos) in
+  if label_count <> 1 || goto_count <> 1 then
+    Ast.static_error loc "R16 deferred suffix requires unique continuation label and incoming edge" None;
+  let rec split rev_prefix = function
+    | [] -> Ast.static_error loc "R16 normal continuation label is not a top-level statement" None
+    | (Ast.LabelStmt (_, name) as label) :: tail when name = continuation ->
+        if tail = [] then Ast.static_error loc "R16 deferred normal suffix is empty" None;
+        let rec has_transfer ss = List.exists (fun stmt ->
+          let found = ref false in
+          Ast.stmt_iter (function Ast.LabelStmt _ | Ast.GotoStmt _ -> found := true | _ -> ()) stmt;
+          !found) ss in
+        if has_transfer tail then
+          Ast.static_error loc "R16 deferred suffix contains a control-flow entry or exit" None;
+        begin match List.rev tail with
+        | Ast.ReturnStmt _ :: _ -> ()
+        | _ -> Ast.static_error loc "R16 deferred normal suffix does not end in return" None
+        end;
+        let suffix_loc = Ast.stmt_loc (List.hd tail) in
+        let end_loc = Ast.stmt_loc (List.hd (List.rev tail)) in
+        let wrapper = Ast.BlockStmt (suffix_loc, [], decls @ tail, end_loc, ref []) in
+        let before_cfg = (List.sort compare !labels, List.sort compare !gotos) in
+        let collect_nodes statements =
+          let nodes = ref [] in
+          List.iter (Ast.stmt_iter (fun node -> nodes := node :: !nodes)) statements;
+          List.rev !nodes in
+        let before_nodes = collect_nodes stmts in
+        let result = List.rev rev_prefix @ [label; wrapper] in
+        let after_nodes = collect_nodes result in
+        let preserved_nodes = List.filter (fun node ->
+          node != wrapper && not (List.exists (fun added -> added == node) decls)) after_nodes in
+        if List.length before_nodes <> List.length preserved_nodes ||
+           not (List.for_all2 (==) before_nodes preserved_nodes) then
+          Ast.static_error loc "R16 deferred relocation changed an original statement node or order" None;
+        let after_labels = ref [] and after_gotos = ref [] in
+        List.iter (Ast.stmt_iter (function
+          | Ast.LabelStmt (_, id) -> after_labels := id :: !after_labels
+          | Ast.GotoStmt (_, id) -> after_gotos := id :: !after_gotos
+          | _ -> ())) result;
+        if before_cfg <> (List.sort compare !after_labels, List.sort compare !after_gotos) then
+          Ast.static_error loc "R16 deferred relocation changed the continuation CFG" None;
+        (result, wrapper)
+    | stmt :: tail -> split (stmt :: rev_prefix) tail
+  in
+  split [] stmts

+let run_actual_cmp_scope_controls loc =
+  let id = "__r16_cmp_control" in
+  let ty = Ast.IdentTypeExpr (loc, None, "i32") in
+  let expected = [id, Some ty] in
+  let marker = Ast.ExprStmt (Ast.CallExpr
+    (loc, "#strict_lft_binding_scope",
+     [Ast.IdentTypeExpr (loc, None, "'cmp")], [], [], Ast.Static)) in
+  let decl ty taken = Ast.DeclStmt
+    (loc, [(loc, ty, id, None, (ref taken, ref None))]) in
+  let var = Ast.ExprStmt (Ast.Var (loc, id)) in
+  let block ss = Ast.BlockStmt (loc, [], ss, loc, ref []) in
+  let starts_with p s = String.length s >= String.length p && String.sub s 0 (String.length p) = p in
+  let refusal name prefix body = match validate_actual_scope_relocation expected [] None body with
+    | Error why when starts_with prefix why -> true
+    | Error why -> failwith ("R16 cmp control " ^ name ^ " refused unexpectedly: " ^ why)
+    | Ok () -> failwith ("R16 cmp control unexpectedly accepted: " ^ name) in
+  let positive = match validate_actual_scope_relocation expected [] None
+      [block [marker; decl (Some ty) false; var]] with
+    | Ok () -> true | Error why -> failwith ("R16 cmp positive control refused: " ^ why) in
+  ignore (refusal "outside-use" "cmp local escaped strict scope:"
+    [block [marker; decl (Some ty) false]; var]);
+  ignore (refusal "address-exposure" "address-taken target local:"
+    [block [marker; decl (Some ty) false; Ast.ExprStmt (Ast.AddressOf (loc, Ast.Var (loc, id)))]]);
+  ignore (refusal "duplicate-declaration" "target declaration count is not one:"
+    [block [marker; decl (Some ty) false; decl (Some ty) false; var]]);
+  ignore (refusal "wrong-type" "target declaration has wrong shape or type:"
+    [block [marker; decl (Some (Ast.IdentTypeExpr (loc, None, "u8"))) false; var]]);
+  ignore (refusal "taken-flag" "address-taken target declaration:"
+    [block [marker; decl (Some ty) true; var]]);
+  ignore (refusal "missing-marker" "cmp local escaped strict scope:"
+    [block [decl (Some ty) false; var]]);
+  ignore (refusal "duplicate-marker" "duplicate strict lifetime marker"
+    [block [marker; marker; decl (Some ty) false; var]]);
+  ignore (refusal "malformed-marker" "malformed strict lifetime marker"
+    [block [Ast.ExprStmt (Ast.CallExpr (loc, "#strict_lft_binding_scope",
+      [Ast.IdentTypeExpr (loc, None, "'wrong")], [], [], Ast.Static)); decl (Some ty) false; var]]);
+  ignore (refusal "static-WRead-hidden-outside-use" "unsupported static WRead"
+    [Ast.ExprStmt (Ast.WRead (loc, Ast.Var (loc, id), "C", [], "field", Ast.Bool, [], true, ref None, Ast.Real))]);
+  ignore (refusal "static-WRead-address-exposure" "unsupported static WRead"
+    [block [marker; decl (Some ty) false; Ast.ExprStmt (Ast.AddressOf (loc,
+      Ast.WRead (loc, Ast.Var (loc, id), "C", [], "field", Ast.Bool, [], true, ref None, Ast.Real)))]]);
+  let unsupported =
+    try
+      match validate_actual_scope_relocation expected [] None
+        [block [marker; decl (Some ty) false; Ast.ExprStmt (Ast.CxxConstruct (loc, "synthetic", ty, []))]] with
+      | Error why -> failwith ("R16 unsupported-expression control refused unexpectedly: " ^ why)
+      | Ok () -> failwith "R16 unsupported-expression control unexpectedly accepted"
+    with Ast.StaticError (_, "This expression form is not allowed in this position.", _) -> true in
+  if not positive || not unsupported then failwith "R16 cmp synthetic control failed";
+  Printf.eprintf "ACTUAL-SCOPE-RELOCATION cmp-controls=12 status=PASS\n%!"
+
+let run_actual_indexed_scope_controls loc =

+      match StatementKindRd.get (StatementRd.kind_get statement) with
+      | StatementKindRd.StorageLive local when live &&
+           LocalDeclIdRd.name_get local = id -> ()
+      | StatementKindRd.StorageDead local when not live &&
+           LocalDeclIdRd.name_get local = id -> ()

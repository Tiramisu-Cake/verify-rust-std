+     | [b0;b1] when
+         Stdint.Uint32.to_int
+           (BasicBlockIdRd.index_get (BasicBlockRd.id_get b0)) = 0 &&
+         Stdint.Uint32.to_int
+           (BasicBlockIdRd.index_get (BasicBlockRd.id_get b1)) = 1 &&

+           (TerminatorRd.kind_get (BasicBlockRd.terminator_get b1)) with
+          | TerminatorKindRd.Return -> ()
+          | _ -> reject "standalone return terminator")
+     | _ -> reject "standalone complete basic-block graph");
+    Printf.printf
+      "SORT4-SELECT-INTRINSIC: full typed standalone MIR graph accepted\n%!"
+
+  (* Exact ordered statement graph of the pinned actual helper.  This is kept

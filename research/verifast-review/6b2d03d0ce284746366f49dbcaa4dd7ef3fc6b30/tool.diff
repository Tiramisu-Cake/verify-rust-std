+       `Copy ("_18","_10");`Live "_19";`Copy ("_19","_8")];
+      [`Dead "_19";`Dead "_18";`Dead "_17";`Live "_20";
+       `Live "_21";`Copy ("_21","_12");`Bool ("_30",true);
+       `Guard ("_20","_21");`Dead "_21";`Live "_22";
+       `Live "_23";`Copy ("_23","_16")];
+      [`Dead "_23";`Dead "_22";`Live "_24";`Live "_25";
+       `Bool ("_30",false);`Move ("_25","_20")];
+      [`Dead "_25";`Dead "_24";`Live "_26";`Live "_27";
+       `Copy ("_27","_1");`Live "_28";`Copy ("_28","_4");
+       `Live "_29";`Copy ("_29","_6")];
+      [`Dead "_29";`Dead "_28";`Dead "_27"];
+      [`Dead "_26";`Bool ("_30",false);`Dead "_20";
+       `Dead "_16";`Dead "_12";`Dead "_10";`Dead "_8";
+       `Dead "_6";`Dead "_4"];
+      [];[];[]
+    |] in
+    let blocks = BodyRd.basic_blocks_get_list body in
+    if List.length blocks <> Array.length expected then
+      reject "actual full basic-block count";
+    List.iteri (fun i block ->
+      if Stdint.Uint32.to_int
+        (BasicBlockIdRd.index_get (BasicBlockRd.id_get block)) <> i ||

+  let sort4_select_check_body_mir kind (body : BodyRd.t) =
+    let reject = Sort4SelectIntrinsic.reject in
+    let local id is_mut ty_pred decl =
+      let mut = match MutabilityRd.get (LocalDeclRd.mutability_get decl) with
+        | MutabilityRd.Mut -> true
+        | MutabilityRd.Not -> false
+        | _ -> reject "unknown local mutability" in
+      if LocalDeclIdRd.name_get (LocalDeclRd.id_get decl) <> id ||
+         mut <> is_mut || not (ty_pred (LocalDeclRd.ty_get decl)) then
+        reject ("local identity/type: " ^ id)
+    in
+    let bool_ty ty = match TyKindRd.get (TyRd.kind_get ty) with
+      | TyKindRd.Bool -> true | _ -> false in
+    (match BodyRd.local_decls_get_list body with
+     | [ret; condition; a; b; temp_condition; temp_a; temp_b] ->
+         local "_0" true (sort4_select_ty kind) ret;
+         local "_1" false bool_ty condition;
+         local "_2" false (sort4_select_ty kind) a;
+         local "_3" false (sort4_select_ty kind) b;
+         local "_4" true bool_ty temp_condition;
+         local "_5" true (sort4_select_ty kind) temp_a;
+         local "_6" true (sort4_select_ty kind) temp_b
+     | _ -> reject "standalone local count");

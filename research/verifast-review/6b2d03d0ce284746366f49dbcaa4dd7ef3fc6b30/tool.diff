+  let sort4_select_check_actual_statements (body : BodyRd.t) =
+    let reject = Sort4SelectIntrinsic.reject in
+    let place id mutable_ p =
+      if LocalDeclIdRd.name_get (PlaceRd.local_get p) <> id ||
+         PlaceRd.local_is_mutable_get p <> mutable_ ||
+         PlaceRd.projection_get_list p <> [] ||

+    if BodyRd.DefKind.get (BodyRd.def_kind_get body) <>
+         BodyRd.DefKind.Fn ||
+       UnsafetyRd.get (BodyRd.unsafety_get body) <>
+         UnsafetyRd.Safe ||
+       BodyRd.module_def_path_get body <> "" ||
+       BodyRd.is_from_expansion_get body || BodyRd.is_trait_fn_get body ||
+       BodyRd.is_drop_fn_get body ||

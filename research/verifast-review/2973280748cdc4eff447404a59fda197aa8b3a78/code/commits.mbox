               (* A new live Rust stack object cannot overlap existing live storage.
                  Inspect only exposed physical chunks, never arbitrary pointers or
                  provenance inequality. This does not add or consume permissions. *)
+              (* Concrete Rust struct layout may include zero-sized subobjects;
+                 its existing sizeof axioms do not model these accurately. Keep
+                 this rule to scalar/pointer or abstract generic extents, and
+                 skip unsupported sizeof forms rather than rejecting a program. *)
+              let extent_type_supported tp =
+                match unfold_inferred_type tp with
+                  Bool | Int _ | RustChar | Float | Double | PtrType _ | RustRefType _
+                | GhostTypeParam _ | BoundedGhostTypeParam _ -> true
+                | _ -> false
+              in
               let rec exclude_live_storage chunks cont =
                 match chunks with
                   [] -> cont ()
                 | Chunk ((g, true), [tp], coef, [p; _], _) :: chunks
